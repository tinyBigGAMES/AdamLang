  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.Runtime.Linux64.adam - The platform routines of x86_64-linux-gnu

  System.Runtime holds the runtime's logic and names no OS; every OS call it
  needs is one of the Platform routines here, the same routines with the
  same meaning as System.Runtime.Win64's. The compiler loads the unit its
  target names (Target.RuntimeUnit) with the runtime, as the runtime's
  implicit import. This one is over glibc (libc.so.6, linked dynamically:
  `external "c"`), which initializes itself in __libc_start_main; the pure
  C routines it calls (memcpy, strlen ..) are libc.a's, System.Runtime.LibC.
  Raise and catch run on the runtime's own unwinder (plan H1): the compiler
  writes win64's x64 unwind data into adam_xdata / adam_pdata, and DoWalk
  reads it, searching the frames' scopes, then unwinding them to the catch
  (DoDispatch, PlatformFrameHandler); a C frame between unwinds by its
  .eh_frame CFI. A hardware fault (SIGSEGV / SIGBUS / SIGFPE / SIGILL, a
  stack overflow) is taken by a signal handler on the thread's alternate
  signal stack, which returns to the fault's dispatch from the faulting
  frame (plan H2). Threads are pthreads (a thread's end runs from a thread
  key's destructor), their waits futexes. Coroutines run on mmap'd stacks
  with a guard page. The
  registers the unwinder starts from, its jump to a catch and a coroutine
  switch are the ELF linker's register routines (__adam_registers,
  __adam_resume, __adam_switch: machine code the language cannot write, no
  system call). The routines a later
  atom of PLAN-LINUX64 fills (hooks LX4f, loaded libraries
  LX4g, a .so's events LX6b) stop the process with that atom named
  (DoPending) until then.
*******************************************************************************/

module unit System.Runtime.Linux64;

// libc.a's pure C routines: memcpy, memset, strcmp, strlen (the same on every target)
import System.Runtime.LibC;

type
  // struct timespec: seconds and nanoseconds (clock_gettime, nanosleep, struct stat)
  timespec = record
    tv_sec: int64;
    tv_nsec: int64;
  end;

  // struct stat (x86_64, 144 bytes; glibc's bits/struct_stat.h): its tag shares stat's
  // name, so the record is the runtime's; its fields keep the header's names (__pad0 and
  // __glibc_reserved as pad0 / reserved: '__' names are the compiler's)
  PlatformStat = record
    st_dev: uint64;
    st_ino: uint64;
    st_nlink: uint64;
    st_mode: uint32;
    st_uid: uint32;
    st_gid: uint32;
    pad0: int32;
    st_rdev: uint64;
    st_size: int64;
    st_blksize: int64;
    st_blocks: int64;
    st_atim: timespec;
    st_mtim: timespec;
    st_ctim: timespec;
    reserved: array[0..2] of int64;
  end;

  // struct tm (56 bytes): localtime_r's fields (tm_mon 0..11, tm_year since 1900)
  tm = record
    tm_sec: int32;
    tm_min: int32;
    tm_hour: int32;
    tm_mday: int32;
    tm_mon: int32;
    tm_year: int32;
    tm_wday: int32;
    tm_yday: int32;
    tm_isdst: int32;
    tm_gmtoff: int64;
    tm_zone: ptr to const char;
  end;

  // struct dirent (280 bytes; readdir's entry): the name NUL-terminated at 19
  dirent = record
    d_ino: uint64;
    d_off: int64;
    d_reclen: uint16;
    d_type: uint8;
    d_name: array[0..255] of char;
  end;

// glibc: the process exit (exit runs the exit-time handlers and flushes every stream,
// _exit ends at once: no handler, no flush), an abnormal end (SIGABRT)
func exit(const ACode: int32); noreturn; external "c";
func _exit(const ACode: int32); noreturn; external "c";
func abort(); noreturn; external "c";
// glibc: an exit-time handler registered (C's atexit is libc_nonshared.a's wrapper of it:
// libc.so.6 exports __cxa_atexit alone); ADso nil: the program's own, run by exit
func __cxa_atexit(const AHandler: func(); const AArgument: ptr; const ADso: ptr): int32;
  external "c";

// glibc: the stdio streams (FILE * data objects), a stream written and flushed (nil:
// every stream)
var
  stdout: ptr; external "c";
func fwrite(const ABuffer: ptr; const ASize: uint64; const ACount: uint64;
  const AStream: ptr): uint64; external "c";
func fflush(const AStream: ptr): int32; external "c";

// glibc: the C heap
func malloc(const ASize: uint64): ptr; external "c";
func realloc(const APointer: ptr; const ASize: uint64): ptr; external "c";
func free(const APointer: ptr); external "c";
func malloc_usable_size(const APointer: ptr): uint64; external "c";

// glibc: the calling thread's errno
func __errno_location(): ptr to int32; external "c";

// glibc: files by descriptor (open's third argument, the mode of a file it creates, is
// read only with O_CREAT), their place, size and end; a path's facts (stat follows links,
// lstat does not), a file's name removed, a link's text, the working folder. The descriptor
// calls bind glibc's own __open / __read / __write / __close / __lseek, never the plain names
// System.HookIO.Linux64 hooks: the runtime's descriptors are its own (a fault report's write
// reaches the kernel with no hook between)
func open(const APath: ptr to const char; const AFlags: int32; ...): int32;
  external "c" name "__open";
func read(const AFile: int32; const ABuffer: ptr; const ACount: uint64): int64;
  external "c" name "__read";
func write(const AFile: int32; const ABuffer: ptr to const; const ACount: uint64): int64;
  external "c" name "__write";
func close(const AFile: int32): int32; external "c" name "__close";
func lseek(const AFile: int32; const AOffset: int64; const AWhence: int32): int64;
  external "c" name "__lseek";
func ftruncate(const AFile: int32; const ALength: int64): int32; external "c";
// glibc's system call entry (unistd.h): the kernel's call ANumber with its arguments; -1 with
// errno set on a failure. The stat family goes through it: glibc's stat / fstat / lstat are
// symbols only from 2.33 (below Adam's glibc floor: research PLAN-LINUX64
// kb_glibc_floor.md), and its __xstat / __fxstat / __lxstat are names System.HookIO.Linux64
// defines, so a program with a path source would meet its hooks; glibc has no internal alias
// of them exported. x86_64's kernel struct stat is glibc's (no conversion between)
func syscall(const ANumber: int64; ...): int64; external "c";
func unlink(const APath: ptr to const char): int32; external "c";
func readlink(const APath: ptr to const char; const ABuffer: ptr to char;
  const ASize: uint64): int64; external "c";

// glibc: a folder's entries (opendir's handle, readdir's next entry: nil at the end or on
// a failure, told apart by errno)
func opendir(const APath: ptr to const char): ptr; external "c";
func readdir(const AFolder: ptr): ptr to dirent; external "c";
func closedir(const AFolder: ptr): int32; external "c";

// glibc: seconds since the epoch as local time fields (the time zone's rules for that date)
func localtime_r(const ATime: ptr to const int64; var AResult: tm): ptr to tm; external "c";
// glibc: a clock read (CLOCK_MONOTONIC: from a fixed point, never going back), the calling
// thread asleep (ARemaining: what is left when a signal woke it), a system value
func clock_gettime(const AClock: int32; var ATime: timespec): int32; external "c";
func nanosleep(const ATime: ptr to const timespec; const ARemaining: ptr to timespec): int32;
  external "c";
func sysconf(const AName: int32): int64; external "c";

// glibc: a float64's leading decimal digits, correctly rounded, and the decimal point's
// place (PlatformFloatDigits); a decimal text read back as a float64 / float32, rounded to
// nearest (PlatformParseFloat64 / PlatformParseFloat32)
func ecvt_r(const AValue: float64; const ACount: int32; var ADecimal: int32;
  var ASign: int32; const ABuffer: ptr to char; const ASize: uint64): int32; external "c";
func strtod(const AText: ptr to const char; const AEnd: ptr): float64; external "c";
func strtof(const AText: ptr to const char; const AEnd: ptr): float32; external "c";

// glibc: a mutex (pthread_mutex_t: 40 bytes, all zero = PTHREAD_MUTEX_INITIALIZER) made,
// held, let go and done with; the calling thread, its attributes (pthread_attr_t: 56
// bytes) and the stack they name (its lowest address and size)
func pthread_mutex_init(const AMutex: ptr; const AAttributes: ptr): int32; external "c";
func pthread_mutex_lock(const AMutex: ptr): int32; external "c";
func pthread_mutex_unlock(const AMutex: ptr): int32; external "c";
func pthread_mutex_destroy(const AMutex: ptr): int32; external "c";
func pthread_self(): uint64; external "c";
func pthread_getattr_np(const AThread: uint64; const AAttributes: ptr): int32; external "c";
func pthread_attr_getstack(const AAttributes: ptr; var AStack: ptr; var ASize: uint64): int32;
  external "c";
func pthread_attr_destroy(const AAttributes: ptr): int32; external "c";
// glibc (libdl.so.2's names; libc.so.6 holds them from 2.34): a loaded library's handle
// (dlopen with RTLD_NOLOAD: never loads one), its symbol, the handle given back
func dlopen(const AFile: ptr to const char; const AMode: int32): ptr; external "c";
func dlsym(const AHandle: ptr; const AName: ptr to const char): ptr; external "c";
func dlclose(const AHandle: ptr): int32; external "c";

const
  // dlfcn.h's modes (x86_64): resolve every symbol now, only a library already loaded
  RTLD_NOW: int32 = 0x00002;
  RTLD_NOLOAD: int32 = 0x00004;
  // The C runtime's library (glibc), loaded with every Adam program (Adam.SysV.ABI's C runtime)
  ADAM_PLATFORM_C_RUNTIME: string = "libc.so.6";
  // sys/syscall.h (x86_64): the kernel's stat (a link followed), fstat and lstat (the link
  // itself)
  SYS_stat: int64 = 4;
  SYS_fstat: int64 = 5;
  SYS_lstat: int64 = 6;
  // The working folder (the kernel's own: HookIO's getcwd hook answers a working folder it set
  // in a source, which the runtime's own opens never see)
  SYS_getcwd: int64 = 79;
  // fcntl.h's open flags (x86_64)
  O_RDONLY: int32 = 0;
  O_WRONLY: int32 = 1;
  O_RDWR: int32 = 2;
  O_CREAT: int32 = 0x40;
  O_TRUNC: int32 = 0x200;
  O_CLOEXEC: int32 = 0x80000;
  // The mode a created file asks for (0666: read and write for all, the umask applied), as
  // C's fopen creates one
  ADAM_PLATFORM_CREATE_MODE: int32 = 0x1B6;
  // sys/stat.h's file type bits
  S_IFMT: uint32 = 0xF000;
  S_IFDIR: uint32 = 0x4000;
  S_IFLNK: uint32 = 0xA000;
  // errno.h's EINTR: a call a signal broke off, made again
  EINTR: int32 = 4;
  // time.h's CLOCK_MONOTONIC, unistd.h's _SC_NPROCESSORS_ONLN
  CLOCK_MONOTONIC: int32 = 1;
  _SC_NPROCESSORS_ONLN: int32 = 84;
  // stdio's descriptors: stderr (the fault report's direct write)
  STDERR_FILENO: int32 = 2;
  // limits.h's PATH_MAX: the first room a link's text or the working folder is read into
  ADAM_PLATFORM_PATH_START: uint64 = 4096;
  // The most bytes one read or write asks for (as System.Runtime.Win64: 1 GiB)
  ADAM_PLATFORM_READ_CHUNK: int64 = 0x40000000;
  // A mutex's and a thread attribute's bytes (pthread_mutex_t, pthread_attr_t)
  ADAM_PLATFORM_LOCK_SIZE: int64 = 40;
  ADAM_PLATFORM_ATTR_WORDS: int64 = 7;
  // The process's arguments, NUL after each (the kernel's view of argv)
  ADAM_PLATFORM_CMDLINE: string = "/proc/self/cmdline";
  // The program's own file (a link to it)
  ADAM_PLATFORM_SELF_EXE: string = "/proc/self/exe";
  // The first room the arguments are read into, doubled while it fills
  ADAM_PLATFORM_CMDLINE_START: int64 = 4096;
  // The loader's reason for a thread's end (System.Runtime.Win64's DLL_THREAD_DETACH): the
  // one reason PlatformThreadCallback acts on
  ADAM_PLATFORM_THREAD_END: uint32 = 3;

public const
  // The hardware fault kinds (PaskalCPP's EXC_ codes, the same on every target: System.Runtime's
  // ADAM_RUNTIME_EXC_*) PlatformFaultTaken gives and the fault handler (PlatformAtFault) is
  // called with: divide by zero, access violation, stack overflow, numeric overflow, illegal
  // or privileged instruction, a bus error (SIGBUS), another fault
  ADAM_PLATFORM_FAULT_DIVIDE: int32 = 2;
  ADAM_PLATFORM_FAULT_ACCESS: int32 = 3;
  ADAM_PLATFORM_FAULT_STACK: int32 = 4;
  ADAM_PLATFORM_FAULT_OVERFLOW: int32 = 5;
  ADAM_PLATFORM_FAULT_INSTRUCTION: int32 = 6;
  ADAM_PLATFORM_FAULT_BUS: int32 = 7;
  ADAM_PLATFORM_FAULT_OTHER: int32 = 99;
  // C's errno values (glibc's asm-generic errno.h) a run-time hook reports (System.Runtime's
  // ADAM_ERRNO_*), with System.Runtime.Win64's meanings
  ADAM_PLATFORM_ENOENT: int32 = 2;
  ADAM_PLATFORM_EIO: int32 = 5;
  ADAM_PLATFORM_EBADF: int32 = 9;
  ADAM_PLATFORM_ENOSPC: int32 = 28;
  ADAM_PLATFORM_ENOSYS: int32 = 38;
  ADAM_PLATFORM_ENOMEM: int32 = 12;
  ADAM_PLATFORM_EACCES: int32 = 13;
  ADAM_PLATFORM_EEXIST: int32 = 17;
  ADAM_PLATFORM_EINVAL: int32 = 22;
  ADAM_PLATFORM_EILSEQ: int32 = 84;
  ADAM_PLATFORM_ERANGE: int32 = 34;
  ADAM_PLATFORM_EOVERFLOW: int32 = 75;
  // The file modes PlatformOpenFileMode takes (System.Runtime's ADAM_FILE_*): read, write,
  // read write, append
  ADAM_PLATFORM_MODE_READ: int32 = 0;
  ADAM_PLATFORM_MODE_WRITE: int32 = 1;
  ADAM_PLATFORM_MODE_READ_WRITE: int32 = 2;
  ADAM_PLATFORM_MODE_APPEND: int32 = 3;
  // The origins PlatformSeekFile takes (System.Runtime's ADAM_SEEK_*): lseek's SEEK_SET,
  // SEEK_CUR, SEEK_END
  ADAM_PLATFORM_SEEK_START: int32 = 0;
  ADAM_PLATFORM_SEEK_CURRENT: int32 = 1;
  ADAM_PLATFORM_SEEK_END: int32 = 2;
  // What PlatformPathKind finds at a path (System.Runtime's ADAM_PATH_*): nothing (or a path
  // that cannot be read), a file, a folder
  ADAM_PLATFORM_PATH_NONE: int32 = 0;
  ADAM_PLATFORM_PATH_FILE: int32 = 1;
  ADAM_PLATFORM_PATH_FOLDER: int32 = 2;

var
  // The process's arguments (DoReadyArguments): GArgumentCount of them, GArguments their
  // NUL-terminated bytes' addresses into GArgumentText, all from the C heap, kept for the
  // process's life; GArgumentsReady once read; the lock (a zeroed pthread_mutex_t is a
  // free one) makes the read run once when threads ask at the same time
  GArgumentsReady: bool;
  GArgumentsLock: array[0..4] of uint64;
  GArgumentCount: int32;
  GArguments: ptr to ptr to const char;
  GArgumentText: ptr to char;
  // System.Runtime's thread end (PlatformAtThreadEnd), run on each thread but the main one
  // as it ends (PlatformThreadCallback); nil until then
  GThreadEnd: func();
  // System.Runtime's report of a hardware fault no guard took (PlatformAtFault: it never
  // returns); nil until then
  GFaultHandler: func(const AKind: int32);
  // A .so's runtime (LX6b): true once its load began; an exe's is always false
  GDLLMode: bool;

threadstatic
  // True once this thread's end ran (PlatformThreadCallback): a second call is nothing
  GThreadEndRan: bool;

// Writes the NUL-terminated text AText to stderr in one system call, no stdio
func DoWriteErrorText(const AText: ptr to const char);
begin
  write(STDERR_FILENO, AText, strlen(AText));
end;

// The platform routine AName, which PLAN-LINUX64's atom AAtom gives its body: the process
// stops (SIGABRT) with the two named on stderr, never running on as if it had done its work
func DoPending(const AName: ptr to const char; const AAtom: ptr to const char); noreturn;
begin
  DoWriteErrorText(ptr to const char("System.Runtime.Linux64: "));
  DoWriteErrorText(AName);
  DoWriteErrorText(ptr to const char(" is not built yet (PLAN-LINUX64 "));
  DoWriteErrorText(AAtom);
  DoWriteErrorText(ptr to const char(")\n"));
  abort();
end;

// The calling thread's C errno (glibc's: what C functions report), read and set
func DoErrno(): int32;
var
  LAt: ptr to int32;
begin
  LAt := __errno_location();
  return LAt^;
end;

func DoSetErrno(const AValue: int32);
var
  LAt: ptr to int32;
begin
  LAt := __errno_location();
  LAt^ := AValue;
end;

// Writes the ACount bytes at AText to stdout as they are
public func PlatformWrite(const AText: ptr; const ACount: int64);
begin
  fwrite(AText, 1, uint64(ACount), stdout);
end;

// Writes the ACount bytes at AText to stderr as they are (unbuffered: one system call,
// as glibc's stderr stream is)
public func PlatformWriteError(const AText: ptr; const ACount: int64);
begin
  write(STDERR_FILENO, AText, uint64(ACount));
end;

// What was written to stdout and is still in its buffer written out
public func PlatformFlush();
begin
  fflush(stdout);
end;

// Ends the process with the exit code ACode (its exit-time handlers run, every stream
// flushed by glibc's exit)
public func PlatformExit(const ACode: int32); noreturn;
begin
  exit(ACode);
end;

// From the last exit-time handler of an exit already under way (System.Runtime's
// ReportHeap, BNF sec 5): the process ends with the exit code ACode in place of the one
// exit was given, as exit would end it once its handlers ran (every C stream flushed, then
// the process's end); nothing in a .so (its unload ends no process)
public func PlatformExitWith(const ACode: int32);
begin
  if GDLLMode then
    return;
  end;
  fflush(nil);
  _exit(ACode);
end;

// Ends the process at once with the exit code ACode: no exit-time handler runs and no
// stream is flushed (PaskalCPP's std::_Exit after an unhandled raise)
public func PlatformQuit(const ACode: int32); noreturn;
begin
  _exit(ACode);
end;

// The ELF linker's register routines (its arch's machine code, Adam.ELF.Writer's
// ELFMachine): the caller's callee-saved registers, rsp and pc (its return address) into
// the record at ARegs (the other registers left as they are); the callee-saved registers
// and rsp loaded from the record at ARegs, then a jump to APc (never returns); the
// callee-saved registers and the floating-point control words pushed, rsp kept at AFrom,
// rsp taken from ATo and the other stack's pushed state popped (returns on that stack)
func DoSaveRegisters(const ARegs: ptr); external name "__adam_registers";
func DoResumeAt(const ARegs: ptr; const APc: uint64); noreturn; external name "__adam_resume";
func DoSwitchStack(const AFrom: ptr; const ATo: ptr); external name "__adam_switch";

var
  // The linker's bounds of Adam's function table (adam_pdata, plan H1): per function with
  // unwind data its start, end and UNWIND_INFO, each an int32 relative to its own field
  // (RVA32 written as R_X86_64_PC32, LX2a)
  GPdataStart: uint8; external name "__start_adam_pdata";
  GPdataStop: uint8; external name "__stop_adam_pdata";

forward type PlatformFinallyRun;

type
  // A frame's registers as the unwinder walks them: the 16 general registers by their
  // unwind number (0 rax, 1 rcx, 2 rdx, 3 rbx, 4 rsp, 5 rbp, 6 rsi, 7 rdi, 8 .. 15 r8 ..
  // r15) and the frame's pc
  PlatformRegisters = record
    Regs: array[0..15] of uint64;
    Pc: uint64;
  end;
  // A function of Adam's table (DoFunctions): its code's first byte, the byte past its
  // last and its UNWIND_INFO, as addresses
  PlatformFunction = record
    Start: uint64;
    Stop: uint64;
    Info: uint64;
  end;
  // How a frame unwinds at its pc (DoFrameFacts): its base is its rsp (FrameReg -1) or the
  // frame register FrameReg's value less FrameOffset (the frame a scope's funclets are
  // handed: Windows' establisher frame); its return address at base + Total, the SaveCount
  // registers it saved (SaveReg[i]: an unwind number) at base + SaveAt[i]. Entry: its
  // function in the table (nil: no Adam unwind data, a bare leaf or a foreign frame); Pc:
  // the pc the facts are for (0: an empty cache entry)
  PlatformFrameFacts = record
    Pc: uint64;
    Entry: ptr to PlatformFunction;
    Total: int64;
    FrameReg: int64;
    FrameOffset: int64;
    SaveCount: int64;
    SaveReg: array[0..15] of uint8;
    SaveAt: array[0..15] of int32;
  end;
  // The exception being dispatched (the filters' pointers' first word points at it, as
  // an EXCEPTION_RECORD's first DWORD is its code): ADAM_PLATFORM_RAISE_CODE,
  // ADAM_PLATFORM_ABORT_CODE or ADAM_PLATFORM_FAULT_CODE (its Kind an
  // ADAM_PLATFORM_FAULT_*)
  PlatformException = record
    Code: uint32;
    Kind: int32;
  end;
  // A finally funclet's run (PlatformFrameHandler, unwinding): the frame it belongs to as
  // it was before the unwind left it (PcReturn: its pc a return address; false for a
  // faulting frame's), the scope after its own, the run around it (nil: the thread's
  // first). A raise out of the funclet meets the handler's frame and goes on from that
  // frame at that scope (Windows' collided unwind): the frames between, partly unwound
  // already, are not walked a second time
  PlatformFinallyRun = record
    Regs: PlatformRegisters;
    PcReturn: bool;
    ScopeNext: int64;
    Outer: ptr to PlatformFinallyRun;
  end;
  // What the walk (DoWalk) hands a frame's handler (PlatformFrameHandler's ADispatch): the
  // frame's scope table (its count, then 16 bytes per scope), the first scope to look at,
  // whether the frame's pc is a return address (false: a faulting frame's), the phase;
  // unwinding: the catching frame is this one (IsTarget) and its catch's address
  // (TargetPc); searching: the catch the handler found (Found)
  PlatformDispatch = record
    Scopes: uint64;
    ScopeFirst: int64;
    PcReturn: bool;
    Unwinding: bool;
    IsTarget: bool;
    TargetPc: uint64;
    Found: uint64;
  end;
  // A scope's filter (exception pointers, frame: above 0 caught) and a finally funclet
  // (abnormal, frame), as the compiler makes them; a frame's handler
  PlatformFilterRoutine = func(const APointers: ptr; const AFrame: ptr): int32;
  PlatformFinallyRoutine = func(const AAbnormal: uint8; const AFrame: ptr);
  PlatformHandlerRoutine = func(const ARecord: ptr; const AFrame: ptr; const AContext: ptr;
    const ADispatch: ptr): int32;

const
  // Exception codes of a dispatch (System.Runtime.Win64's values, so a code reads the same
  // on both targets): the runtime's raise, a generator's abort, a hardware fault
  ADAM_PLATFORM_RAISE_CODE: uint32 = 0xE0414441;
  ADAM_PLATFORM_ABORT_CODE: uint32 = 0xE0414442;
  ADAM_PLATFORM_FAULT_CODE: uint32 = 0xE0414443;
  // rsp's unwind number
  ADAM_PLATFORM_UNWIND_RSP: int64 = 4;
  // A function table entry's bytes
  ADAM_PLATFORM_PDATA_ENTRY: uint64 = 12;
  // UNWIND_INFO's flags (bits 3-7 of its first byte): a handler for the dispatch, for the
  // unwind, chained info
  UNW_FLAG_EHANDLER: uint64 = 1;
  UNW_FLAG_UHANDLER: uint64 = 2;
  UNW_FLAG_CHAININFO: uint64 = 4;
  // The unwind codes (UWOP_*); UWOP_EPILOG exists from version 2 on
  UWOP_PUSH_NONVOL: uint64 = 0;
  UWOP_ALLOC_LARGE: uint64 = 1;
  UWOP_ALLOC_SMALL: uint64 = 2;
  UWOP_SET_FPREG: uint64 = 3;
  UWOP_EPILOG: uint64 = 6;
  UWOP_SAVE_XMM128: uint64 = 8;
  UWOP_SAVE_XMM128_FAR: uint64 = 9;
  // A scope table entry's bytes (begin, end, handler, target)
  ADAM_PLATFORM_SCOPE_ENTRY: uint64 = 16;

var
  // Adam's function table sorted by start (DoFunctions: made once from adam_pdata, from
  // the C heap, kept for the process's life), GFunctionCount entries; the lock (a zeroed
  // pthread_mutex_t) makes threads raising at once build it once
  GFunctionsReady: bool;
  GFunctionsLock: array[0..4] of uint64;
  GFunctions: ptr to PlatformFunction;
  GFunctionCount: int64;

threadstatic
  // The finally funclets running on this thread (PlatformFrameHandler), the innermost first
  GFinallyRuns: ptr to PlatformFinallyRun;
  // The hardware fault kind (ADAM_PLATFORM_FAULT_*) a guard's filter took on this thread
  // (PlatformCatch), waiting for that guard's except part (PlatformFaultTaken); 0 when none
  GFaultPending: int32;
  // A hardware fault the signal handler took on this thread (DoFaultSignal), waiting for
  // its dispatch (DoFaultRaise, where the handler returns to): the faulting frame's
  // registers and its kind (ADAM_PLATFORM_FAULT_*)
  GFaultStart: PlatformRegisters;
  GFaultKind: int32;
  // True while a dispatch searches the frames (DoTryDispatch): a fault then is the
  // unwinder's own, reported as one no guard took
  GFaultSearching: bool;

type
  // What a thread PlatformThreadStart made runs first (System.Runtime's ThreadRun), given
  // the block it was started with
  PlatformThreadRun = func(const ABlock: ptr);

  // A coroutine (LX4e, plan H5): its stack pointer while it is not running (its
  // callee-saved registers and floating-point control words pushed below it:
  // __adam_switch's), its stack (mmap'd: Map / MapSize the whole mapping, a guard
  // page at its low end; nil for a thread's own coroutine, which runs on the thread's stack),
  // the stack's bounds (StackLow .. StackHigh: what PlatformStackBase and the leak tracker's
  // walk tell), its run and block (nil for a thread's own)
  PlatformCoroutine = record
    SavedRsp: uint64;
    Map: ptr;
    MapSize: uint64;
    StackLow: uint64;
    StackHigh: uint64;
    Run: func(const ABlock: ptr);
    Block: ptr;
  end;

threadstatic
  // The coroutine running on this thread (nil: none yet), written by the switch that
  // starts it (PlatformCoroutineSwitch), and the thread's own coroutine (DoThreadCoroutine:
  // nil until a switch needs it), given back as the thread ends (DoCoroutineThreadEnd).
  // Neither is read once a switch returns: the coroutine may run on another thread
  GCoroutineCurrent: ptr to PlatformCoroutine;
  GCoroutineThread: ptr to PlatformCoroutine;

// A thread's end (PlatformThreadCallback, on that thread, on its own coroutine: a thread
// ends only from there): its own coroutine given back
func DoCoroutineThreadEnd();
var
  LCoroutine: ptr to PlatformCoroutine;
begin
  LCoroutine := GCoroutineThread;
  if LCoroutine = nil then
    return;
  end;
  GCoroutineThread := nil;
  GCoroutineCurrent := nil;
  free(ptr(LCoroutine));
end;

// The byte, uint16, uint32 and uint64 at AAddress (little-endian)
func DoByteAt(const AAddress: uint64): uint64;
var
  LAt: ptr to const uint8;
begin
  LAt := ptr to const uint8(AAddress);
  return uint64(LAt^);
end;

func DoHalfAt(const AAddress: uint64): uint64;
var
  LAt: ptr to const uint16;
begin
  LAt := ptr to const uint16(AAddress);
  return uint64(LAt^);
end;

func DoLongAt(const AAddress: uint64): uint64;
var
  LAt: ptr to const uint32;
begin
  LAt := ptr to const uint32(AAddress);
  return uint64(LAt^);
end;

func DoWordAt(const AAddress: uint64): uint64;
var
  LAt: ptr to const uint64;
begin
  LAt := ptr to const uint64(AAddress);
  return LAt^;
end;

// The address an unwind field at AField names: the field's own address plus the int32
// it holds (an RVA32 is written PC32 on this target)
func DoRelative(const AField: uint64): uint64;
var
  LValue: uint64;
begin
  LValue := DoLongAt(AField);
  if LValue >= 0x80000000 then
    return AField - (0x100000000 - LValue);
  end;
  return AField + LValue;
end;

// Function table entries AA and AB swapped
func DoSwapFunctions(const AA: ptr to PlatformFunction; const AB: ptr to PlatformFunction);
var
  LHold: PlatformFunction;
begin
  LHold := AA^;
  AA^ := AB^;
  AB^ := LHold;
end;

// The heap of AFunctions' first ACount entries (by Start) made whole again at ARoot
// (heapsort's sift down)
func DoSiftFunctions(const AFunctions: ptr to PlatformFunction; const ARoot: int64;
  const ACount: int64);
var
  LRoot: int64;
  LChild: int64;
begin
  LRoot := ARoot;
  while LRoot * 2 + 1 < ACount do
    LChild := LRoot * 2 + 1;
    if (LChild + 1 < ACount) and (AFunctions[LChild].Start < AFunctions[LChild + 1].Start) then
      LChild := LChild + 1;
    end;
    if AFunctions[LRoot].Start >= AFunctions[LChild].Start then
      return;
    end;
    DoSwapFunctions(addr of AFunctions[LRoot], addr of AFunctions[LChild]);
    LRoot := LChild;
  end;
end;

// AFunctions' ACount entries sorted by Start (a heapsort: the linker lays the table in
// section order, which is no address order once COMDAT pieces and removal move code)
func DoSortFunctions(const AFunctions: ptr to PlatformFunction; const ACount: int64);
var
  LI: int64;
  LSorted: bool;
begin
  LSorted := true;
  LI := 1;
  while LSorted and (LI < ACount) do
    LSorted := AFunctions[LI - 1].Start <= AFunctions[LI].Start;
    LI := LI + 1;
  end;
  if LSorted then
    return;
  end;
  LI := ACount div 2 - 1;
  while LI >= 0 do
    DoSiftFunctions(AFunctions, LI, ACount);
    LI := LI - 1;
  end;
  LI := ACount - 1;
  while LI > 0 do
    DoSwapFunctions(addr of AFunctions[0], addr of AFunctions[LI]);
    DoSiftFunctions(AFunctions, 0, LI);
    LI := LI - 1;
  end;
end;

// Adam's function table (GFunctions), made the first time it is asked for: adam_pdata's
// entries as addresses, empty ones (a removed function's) left out, sorted by start
func DoFunctions();
var
  LFirst: uint64;
  LLast: uint64;
  LAt: uint64;
  LCount: int64;
  LTable: ptr to PlatformFunction;
  LEntry: PlatformFunction;
begin
  pthread_mutex_lock(ptr(addr of GFunctionsLock));
  if not GFunctionsReady then
    LFirst := uint64(ptr(addr of GPdataStart));
    LLast := uint64(ptr(addr of GPdataStop));
    LTable := nil;
    LCount := 0;
    if LLast > LFirst then
      LTable := ptr to PlatformFunction(malloc((LLast - LFirst) div ADAM_PLATFORM_PDATA_ENTRY *
        uint64(size(PlatformFunction)) + 1));
    end;
    if LTable <> nil then
      LAt := LFirst;
      while LAt + ADAM_PLATFORM_PDATA_ENTRY <= LLast do
        LEntry.Start := DoRelative(LAt);
        LEntry.Stop := DoRelative(LAt + 4);
        LEntry.Info := DoRelative(LAt + 8);
        if (DoLongAt(LAt) <> 0) and (LEntry.Start < LEntry.Stop) then
          LTable[LCount] := LEntry;
          LCount := LCount + 1;
        end;
        LAt := LAt + ADAM_PLATFORM_PDATA_ENTRY;
      end;
      DoSortFunctions(LTable, LCount);
    end;
    GFunctions := LTable;
    GFunctionCount := LCount;
    GFunctionsReady := true;
  end;
  pthread_mutex_unlock(ptr(addr of GFunctionsLock));
end;

// The function of Adam's table whose code holds APc; nil when none does (a bare leaf, or
// code that is not Adam's: a C library's, glibc's)
func DoFindFunction(const APc: uint64): ptr to PlatformFunction;
var
  LLow: int64;
  LHigh: int64;
  LMiddle: int64;
begin
  if not GFunctionsReady then
    DoFunctions();
  end;
  // the last entry starting at or below APc
  LLow := 0;
  LHigh := GFunctionCount - 1;
  while LLow <= LHigh do
    LMiddle := (LLow + LHigh) div 2;
    if GFunctions[LMiddle].Start <= APc then
      LLow := LMiddle + 1;
    else
      LHigh := LMiddle - 1;
    end;
  end;
  if (LHigh < 0) or (APc >= GFunctions[LHigh].Stop) then
    return nil;
  end;
  return addr of GFunctions[LHigh];
end;

// The slots the unwind code at ASlot takes: UWOP_ALLOC_LARGE 2 (info 0) or 3,
// UWOP_SAVE_XMM128 2, UWOP_SAVE_XMM128_FAR 3, every other 1
func DoCodeSlots(const ASlot: uint64): uint64;
var
  LOp: uint64;
begin
  LOp := DoByteAt(ASlot + 1) & 15;
  if LOp = UWOP_ALLOC_LARGE then
    if (DoByteAt(ASlot + 1) shr 4) = 0 then
      return 2;
    end;
    return 3;
  end;
  if LOp = UWOP_SAVE_XMM128 then
    return 2;
  end;
  if LOp = UWOP_SAVE_XMM128_FAR then
    return 3;
  end;
  return 1;
end;

// True for an unwind code AOp the unwinder reads (Adam.Backend.Unwind's, UWOP_EPILOG from
// version 2 on): a frame that saves a register another way is beyond it
func DoKnownCode(const AOp: uint64; const AVersion: uint64): bool;
begin
  if (AOp = UWOP_PUSH_NONVOL) or (AOp = UWOP_ALLOC_SMALL) or (AOp = UWOP_ALLOC_LARGE) or
    (AOp = UWOP_SET_FPREG) or (AOp = UWOP_SAVE_XMM128) or (AOp = UWOP_SAVE_XMM128_FAR) then
    return true;
  end;
  return (AOp = UWOP_EPILOG) and (AVersion = 2);
end;

// AFacts of the frame at APc (AReturn: APc is a return address, so its call is the byte
// before it: the function is looked up there, past a call that ends its function); false
// when its unwind data is beyond this unwinder (chained info, an unknown code). The codes
// run last prologue step first; one whose prologue offset is past APc's has not run yet
// (a fault inside a prologue). Without Adam unwind data AFacts are a bare leaf's
// (its return address at its rsp) with no Entry
func DoFrameFacts(const APc: uint64; const AReturn: bool; var AFacts: PlatformFrameFacts): bool;
var
  LEntry: ptr to PlatformFunction;
  LInfo: uint64;
  LHeader: uint64;
  LVersion: uint64;
  LCount: uint64;
  LFrame: uint64;
  LOffset: uint64;
  LAt: uint64;
  LSlot: uint64;
  LOp: uint64;
  LOpInfo: uint64;
  LRan: bool;
  LTotal: int64;
  LFramed: bool;
begin
  AFacts.Pc := APc;
  AFacts.Entry := nil;
  AFacts.Total := 0;
  AFacts.FrameReg := -1;
  AFacts.FrameOffset := 0;
  AFacts.SaveCount := 0;
  if AReturn then
    LEntry := DoFindFunction(APc - 1);
  else
    LEntry := DoFindFunction(APc);
  end;
  if LEntry = nil then
    return true;
  end;
  AFacts.Entry := LEntry;
  LInfo := LEntry^.Info;
  LHeader := DoByteAt(LInfo);
  LVersion := LHeader & 7;
  if ((LVersion <> 1) and (LVersion <> 2)) or (((LHeader shr 3) & UNW_FLAG_CHAININFO) <> 0) then
    return false;
  end;
  LOffset := APc - LEntry^.Start;
  LCount := DoByteAt(LInfo + 2);
  LFrame := DoByteAt(LInfo + 3);
  // the frame register is the base once its step ran
  LFramed := false;
  LAt := 0;
  while LAt < LCount do
    LSlot := LInfo + 4 + LAt * 2;
    LOp := DoByteAt(LSlot + 1) & 15;
    if (LOp = UWOP_SET_FPREG) and (DoByteAt(LSlot) <= LOffset) then
      LFramed := (LFrame & 15) <> 0;
    end;
    LAt := LAt + DoCodeSlots(LSlot);
  end;
  if LFramed then
    AFacts.FrameReg := int64(LFrame & 15);
    AFacts.FrameOffset := int64(LFrame shr 4) * 16;
  end;
  LTotal := 0;
  LAt := 0;
  while LAt < LCount do
    LSlot := LInfo + 4 + LAt * 2;
    LOp := DoByteAt(LSlot + 1) & 15;
    LOpInfo := DoByteAt(LSlot + 1) shr 4;
    LRan := DoByteAt(LSlot) <= LOffset;
    if not DoKnownCode(LOp, LVersion) then
      return false;
    end;
    if LRan and (LOp = UWOP_PUSH_NONVOL) then
      AFacts.SaveReg[AFacts.SaveCount] := uint8(LOpInfo);
      AFacts.SaveAt[AFacts.SaveCount] := int32(LTotal);
      AFacts.SaveCount := AFacts.SaveCount + 1;
      LTotal := LTotal + 8;
    end;
    if LRan and (LOp = UWOP_ALLOC_SMALL) then
      LTotal := LTotal + int64(LOpInfo * 8 + 8);
    end;
    if LRan and (LOp = UWOP_ALLOC_LARGE) then
      if LOpInfo = 0 then
        LTotal := LTotal + int64(DoHalfAt(LSlot + 2) * 8);
      else
        LTotal := LTotal + int64(DoLongAt(LSlot + 2));
      end;
    end;
    // UWOP_SET_FPREG was taken above (the base is the frame register from there on); a
    // vector save restores nothing a frame reads (no vector register is callee-saved on
    // SysV); a version 2 epilogue's description says nothing of a call's frame
    LAt := LAt + DoCodeSlots(LSlot);
  end;
  AFacts.Total := LTotal;
  return true;
end;

// The base of the frame ARegs are in, by AFacts: its rsp or its frame register less the
// offset (the frame a scope's filter and funclets are handed)
func DoFrameBase(const ARegs: PlatformRegisters; const AFacts: PlatformFrameFacts): uint64;
begin
  if AFacts.FrameReg < 0 then
    return ARegs.Regs[ADAM_PLATFORM_UNWIND_RSP];
  end;
  return ARegs.Regs[AFacts.FrameReg] - uint64(AFacts.FrameOffset);
end;

// ARegs unwound out of the frame AFacts describe: each register it saved read back, its
// return address the new pc, rsp past it
func DoUnwindFrame(var ARegs: PlatformRegisters; const AFacts: PlatformFrameFacts);
var
  LBase: uint64;
  LI: int64;
begin
  LBase := DoFrameBase(ARegs, AFacts);
  for LI := 0 to AFacts.SaveCount - 1 do
    ARegs.Regs[int64(AFacts.SaveReg[LI])] := DoWordAt(LBase + uint64(int64(AFacts.SaveAt[LI])));
  end;
  ARegs.Pc := DoWordAt(LBase + uint64(AFacts.Total));
  ARegs.Regs[ADAM_PLATFORM_UNWIND_RSP] := LBase + uint64(AFacts.Total) + 8;
end;

// The handler data of the function AEntry (its frame handler's field, the scope table
// after it); 0 when it has none (no UHANDLER / EHANDLER flag)
func DoHandlerData(const AEntry: ptr to PlatformFunction): uint64;
var
  LInfo: uint64;
  LCount: uint64;
begin
  LInfo := AEntry^.Info;
  if ((DoByteAt(LInfo) shr 3) & (UNW_FLAG_EHANDLER | UNW_FLAG_UHANDLER)) = 0 then
    return 0;
  end;
  LCount := DoByteAt(LInfo + 2);
  return LInfo + 4 + ((LCount + 1) & 0xFE) * 2;
end;

// glibc: each loaded object's program headers visited (the exe, libc.so.6, a dlopen'd
// library) until the visitor gives nonzero: a foreign frame's .eh_frame_hdr is found there
func dl_iterate_phdr(const AVisit: func(const AInfo: ptr; const ASize: uint64;
  const AData: ptr): int32; const AData: ptr): int32; external "c";

type
  // A foreign pc's search (DoPhdrVisit's data): the pc, then the .eh_frame_hdr of the
  // object whose loaded segment holds it (0: none found)
  PlatformObjectSearch = record
    Pc: uint64;
    Header: uint64;
  end;
  // A register's rule in a CFI row (DoForeignUnwind): Kind 0 unchanged (same value or
  // undefined), 1 saved at CFA + Value, 2 held in the register Value
  PlatformCfiRule = record
    Kind: int64;
    Value: int64;
  end;
  // A CFI row: the CFA (CfaReg's value plus CfaOffset, DWARF numbers) and the rules of the
  // 16 general registers and the return address (column 16)
  PlatformCfiRow = record
    CfaReg: int64;
    CfaOffset: int64;
    Rules: array[0..16] of PlatformCfiRule;
  end;
  // A CFI program's reading state: the bytes read up to At, the CIE's code and data
  // alignment factors and pointer encoding
  PlatformCfiCursor = record
    At: uint64;
    CodeAlign: uint64;
    DataAlign: int64;
    Encoding: uint64;
  end;

const
  // dl_phdr_info's fields, an Elf64_Phdr's bytes and fields, the segment kinds read
  ADAM_PLATFORM_PHDR_INFO_ADDR: uint64 = 0;
  ADAM_PLATFORM_PHDR_INFO_PHDR: uint64 = 16;
  ADAM_PLATFORM_PHDR_INFO_PHNUM: uint64 = 24;
  ADAM_PLATFORM_PHDR_BYTES: uint64 = 56;
  ADAM_PLATFORM_PHDR_VADDR: uint64 = 16;
  ADAM_PLATFORM_PHDR_MEMSZ: uint64 = 40;
  PT_LOAD: uint32 = 1;
  PT_GNU_EH_FRAME: uint32 = 0x6474E550;
  // The DWARF pointer encodings (DW_EH_PE_*): the value's form (low nibble), its base
  // (high bits), and none at all
  DW_EH_PE_absptr: uint64 = 0x00;
  DW_EH_PE_uleb128: uint64 = 0x01;
  DW_EH_PE_udata2: uint64 = 0x02;
  DW_EH_PE_udata4: uint64 = 0x03;
  DW_EH_PE_udata8: uint64 = 0x04;
  DW_EH_PE_sleb128: uint64 = 0x09;
  DW_EH_PE_sdata2: uint64 = 0x0A;
  DW_EH_PE_sdata4: uint64 = 0x0B;
  DW_EH_PE_sdata8: uint64 = 0x0C;
  DW_EH_PE_pcrel: uint64 = 0x10;
  DW_EH_PE_datarel: uint64 = 0x30;
  DW_EH_PE_indirect: uint64 = 0x80;
  DW_EH_PE_omit: uint64 = 0xFF;
  // The call frame instructions read (DW_CFA_*; the first three in the top two bits)
  DW_CFA_advance_loc: uint64 = 0x40;
  DW_CFA_offset: uint64 = 0x80;
  DW_CFA_restore: uint64 = 0xC0;
  DW_CFA_nop: uint64 = 0x00;
  DW_CFA_set_loc: uint64 = 0x01;
  DW_CFA_advance_loc1: uint64 = 0x02;
  DW_CFA_advance_loc2: uint64 = 0x03;
  DW_CFA_advance_loc4: uint64 = 0x04;
  DW_CFA_offset_extended: uint64 = 0x05;
  DW_CFA_restore_extended: uint64 = 0x06;
  DW_CFA_undefined: uint64 = 0x07;
  DW_CFA_same_value: uint64 = 0x08;
  DW_CFA_register: uint64 = 0x09;
  DW_CFA_remember_state: uint64 = 0x0A;
  DW_CFA_restore_state: uint64 = 0x0B;
  DW_CFA_def_cfa: uint64 = 0x0C;
  DW_CFA_def_cfa_register: uint64 = 0x0D;
  DW_CFA_def_cfa_offset: uint64 = 0x0E;
  DW_CFA_offset_extended_sf: uint64 = 0x11;
  DW_CFA_def_cfa_sf: uint64 = 0x12;
  DW_CFA_def_cfa_offset_sf: uint64 = 0x13;
  DW_CFA_GNU_args_size: uint64 = 0x2E;
  DW_CFA_GNU_negative_offset_extended: uint64 = 0x2F;
  // The return address's column (x86_64), the deepest remember_state nesting kept
  ADAM_PLATFORM_CFI_RA: int64 = 16;
  ADAM_PLATFORM_CFI_STATES: int64 = 8;
  // The unwind number (PlatformRegisters' order) of each DWARF register 0 .. 15 (rax rdx
  // rcx rbx rsi rdi rbp rsp r8 .. r15)
  ADAM_PLATFORM_DWARF_REG: array[0..15] of int64 = [0, 2, 1, 3, 6, 7, 5, 4, 8, 9, 10, 11, 12,
    13, 14, 15];

// dl_iterate_phdr's visitor: the object AInfo whose PT_LOAD segment holds the search's pc
// (AData) gives its PT_GNU_EH_FRAME's address (1: the walk stops); 0 to go on
func DoPhdrVisit(const AInfo: ptr; const ASize: uint64; const AData: ptr): int32;
var
  LSearch: ptr to PlatformObjectSearch;
  LBase: uint64;
  LPhdrs: uint64;
  LCount: uint64;
  LPhdr: uint64;
  LHeader: uint64;
  LHolds: bool;
  LI: uint64;
begin
  LSearch := ptr to PlatformObjectSearch(AData);
  LBase := DoWordAt(uint64(AInfo) + ADAM_PLATFORM_PHDR_INFO_ADDR);
  LPhdrs := DoWordAt(uint64(AInfo) + ADAM_PLATFORM_PHDR_INFO_PHDR);
  LCount := DoHalfAt(uint64(AInfo) + ADAM_PLATFORM_PHDR_INFO_PHNUM);
  LHolds := false;
  LHeader := 0;
  LI := 0;
  while LI < LCount do
    LPhdr := LPhdrs + LI * ADAM_PLATFORM_PHDR_BYTES;
    if uint32(DoLongAt(LPhdr)) = PT_LOAD then
      if (LSearch^.Pc >= LBase + DoWordAt(LPhdr + ADAM_PLATFORM_PHDR_VADDR)) and
        (LSearch^.Pc < LBase + DoWordAt(LPhdr + ADAM_PLATFORM_PHDR_VADDR) +
        DoWordAt(LPhdr + ADAM_PLATFORM_PHDR_MEMSZ)) then
        LHolds := true;
      end;
    end;
    if uint32(DoLongAt(LPhdr)) = PT_GNU_EH_FRAME then
      LHeader := LBase + DoWordAt(LPhdr + ADAM_PLATFORM_PHDR_VADDR);
    end;
    LI := LI + 1;
  end;
  if not LHolds then
    return 0;
  end;
  LSearch^.Header := LHeader;
  return 1;
end;

// An unsigned and a signed LEB128 at ACursor's place, the cursor moved past it
func DoUleb(var AAt: uint64): uint64;
var
  LValue: uint64;
  LShift: uint64;
  LByte: uint64;
begin
  LValue := 0;
  LShift := 0;
  repeat
    LByte := DoByteAt(AAt);
    AAt := AAt + 1;
    if LShift < 64 then
      LValue := LValue | ((LByte & 0x7F) shl LShift);
    end;
    LShift := LShift + 7;
  until (LByte & 0x80) = 0;
  return LValue;
end;

func DoSleb(var AAt: uint64): int64;
var
  LValue: uint64;
  LShift: uint64;
  LByte: uint64;
begin
  LValue := 0;
  LShift := 0;
  repeat
    LByte := DoByteAt(AAt);
    AAt := AAt + 1;
    if LShift < 64 then
      LValue := LValue | ((LByte & 0x7F) shl LShift);
    end;
    LShift := LShift + 7;
  until (LByte & 0x80) = 0;
  if (LShift < 64) and ((LByte & 0x40) <> 0) then
    // the sign bit carried up through the bits above the last byte
    LValue := LValue | (0xFFFFFFFFFFFFFFFF shl LShift);
  end;
  return int64(LValue);
end;

// A value AValue of AWidth bytes read as signed (two's complement), as a uint64
func DoSigned(const AValue: uint64; const AWidth: uint64): uint64;
var
  LSign: uint64;
begin
  LSign := uint64(1) shl (AWidth * 8 - 1);
  if (AValue & LSign) = 0 then
    return AValue;
  end;
  return AValue | (0xFFFFFFFFFFFFFFFF shl (AWidth * 8));
end;

// The pointer at AAt in the encoding AEncoding (ABase: .eh_frame_hdr's start, the datarel
// base), AAt moved past it; AOk false for an encoding this reader has no rule for
func DoEncoded(var AAt: uint64; const AEncoding: uint64; const ABase: uint64;
  var AOk: bool): uint64;
var
  LField: uint64;
  LForm: uint64;
  LValue: uint64;
begin
  LField := AAt;
  LForm := AEncoding & 0x0F;
  LValue := 0;
  if (LForm = DW_EH_PE_absptr) or (LForm = DW_EH_PE_udata8) or (LForm = DW_EH_PE_sdata8) then
    LValue := DoWordAt(AAt);
    AAt := AAt + 8;
  else
    if LForm = DW_EH_PE_uleb128 then
      LValue := DoUleb(AAt);
    else
      if LForm = DW_EH_PE_sleb128 then
        LValue := uint64(DoSleb(AAt));
      else
        if (LForm = DW_EH_PE_udata2) or (LForm = DW_EH_PE_sdata2) then
          LValue := DoHalfAt(AAt);
          if LForm = DW_EH_PE_sdata2 then
            LValue := DoSigned(LValue, 2);
          end;
          AAt := AAt + 2;
        else
          if (LForm = DW_EH_PE_udata4) or (LForm = DW_EH_PE_sdata4) then
            LValue := DoLongAt(AAt);
            if LForm = DW_EH_PE_sdata4 then
              LValue := DoSigned(LValue, 4);
            end;
            AAt := AAt + 4;
          else
            AOk := false;
            return 0;
          end;
        end;
      end;
    end;
  end;
  // the base, wrapping as the address arithmetic of a signed offset does
  if (AEncoding & 0x70) = DW_EH_PE_pcrel then
    LValue := LValue + LField;
  end;
  if (AEncoding & 0x70) = DW_EH_PE_datarel then
    LValue := LValue + ABase;
  end;
  if ((AEncoding & 0x70) <> 0) and ((AEncoding & 0x70) <> DW_EH_PE_pcrel) and
    ((AEncoding & 0x70) <> DW_EH_PE_datarel) then
    AOk := false;
    return 0;
  end;
  if (AEncoding & DW_EH_PE_indirect) <> 0 then
    LValue := DoWordAt(LValue);
  end;
  return LValue;
end;

// The FDE covering APc in the .eh_frame_hdr at AHeader (its sorted table searched: the
// last entry starting at or below APc); 0 when there is none or the table is in a form
// this reader does not take (anything but datarel sdata4 entries)
func DoFindFde(const AHeader: uint64; const APc: uint64): uint64;
var
  LAt: uint64;
  LOk: bool;
  LCount: uint64;
  LTable: uint64;
  LLow: int64;
  LHigh: int64;
  LMiddle: int64;
  LStart: uint64;
begin
  if (DoByteAt(AHeader) <> 1) or (DoByteAt(AHeader + 3) <> (DW_EH_PE_datarel | DW_EH_PE_sdata4)) or
    (DoByteAt(AHeader + 2) = DW_EH_PE_omit) then
    return 0;
  end;
  LOk := true;
  LAt := AHeader + 4;
  DoEncoded(LAt, DoByteAt(AHeader + 1), AHeader, LOk);
  LCount := DoEncoded(LAt, DoByteAt(AHeader + 2), AHeader, LOk);
  if not LOk then
    return 0;
  end;
  LTable := LAt;
  LLow := 0;
  LHigh := int64(LCount) - 1;
  while LLow <= LHigh do
    LMiddle := (LLow + LHigh) div 2;
    LStart := AHeader + DoSigned(DoLongAt(LTable + uint64(LMiddle) * 8), 4);
    if LStart <= APc then
      LLow := LMiddle + 1;
    else
      LHigh := LMiddle - 1;
    end;
  end;
  if LHigh < 0 then
    return 0;
  end;
  return AHeader + DoSigned(DoLongAt(LTable + uint64(LHigh) * 8 + 4), 4);
end;

// The CFI instructions from ACursor's place up to AEnd run into ARow while their location
// (ALocation, advanced by them) is at or below APc (AToEnd: all of them, a CIE's initial
// ones); AInitial the CIE's row (DW_CFA_restore's). False on an instruction this reader
// has no rule for (an expression, a deeper remember_state)
func DoRunCfi(var ACursor: PlatformCfiCursor; const AEnd: uint64; const APc: uint64;
  const AToEnd: bool; var ALocation: uint64; var ARow: PlatformCfiRow;
  const AInitial: PlatformCfiRow): bool;
var
  LStates: array[0..7] of PlatformCfiRow;
  LDepth: int64;
  LOp: uint64;
  LReg: uint64;
  LOk: bool;
begin
  LDepth := 0;
  while ACursor.At < AEnd do
    LOp := DoByteAt(ACursor.At);
    ACursor.At := ACursor.At + 1;
    if (LOp & 0xC0) = DW_CFA_advance_loc then
      ALocation := ALocation + (LOp & 0x3F) * ACursor.CodeAlign;
      if (not AToEnd) and (ALocation > APc) then
        return true;
      end;
      skip;
    end;
    if (LOp & 0xC0) = DW_CFA_offset then
      LReg := LOp & 0x3F;
      if LReg <= 16 then
        ARow.Rules[int64(LReg)].Kind := 1;
        ARow.Rules[int64(LReg)].Value := int64(DoUleb(ACursor.At)) * ACursor.DataAlign;
      else
        DoUleb(ACursor.At);
      end;
      skip;
    end;
    if (LOp & 0xC0) = DW_CFA_restore then
      LReg := LOp & 0x3F;
      if LReg <= 16 then
        ARow.Rules[int64(LReg)] := AInitial.Rules[int64(LReg)];
      end;
      skip;
    end;
    if LOp = DW_CFA_nop then
      skip;
    end;
    if (LOp = DW_CFA_set_loc) or (LOp = DW_CFA_advance_loc1) or (LOp = DW_CFA_advance_loc2) or
      (LOp = DW_CFA_advance_loc4) then
      if LOp = DW_CFA_set_loc then
        LOk := true;
        ALocation := DoEncoded(ACursor.At, ACursor.Encoding, 0, LOk);
        if not LOk then
          return false;
        end;
      end;
      if LOp = DW_CFA_advance_loc1 then
        ALocation := ALocation + DoByteAt(ACursor.At) * ACursor.CodeAlign;
        ACursor.At := ACursor.At + 1;
      end;
      if LOp = DW_CFA_advance_loc2 then
        ALocation := ALocation + DoHalfAt(ACursor.At) * ACursor.CodeAlign;
        ACursor.At := ACursor.At + 2;
      end;
      if LOp = DW_CFA_advance_loc4 then
        ALocation := ALocation + DoLongAt(ACursor.At) * ACursor.CodeAlign;
        ACursor.At := ACursor.At + 4;
      end;
      if (not AToEnd) and (ALocation > APc) then
        return true;
      end;
      skip;
    end;
    if (LOp = DW_CFA_offset_extended) or (LOp = DW_CFA_offset_extended_sf) or
      (LOp = DW_CFA_GNU_negative_offset_extended) then
      LReg := DoUleb(ACursor.At);
      if LReg > 16 then
        return false;
      end;
      ARow.Rules[int64(LReg)].Kind := 1;
      if LOp = DW_CFA_offset_extended then
        ARow.Rules[int64(LReg)].Value := int64(DoUleb(ACursor.At)) * ACursor.DataAlign;
      end;
      if LOp = DW_CFA_offset_extended_sf then
        ARow.Rules[int64(LReg)].Value := DoSleb(ACursor.At) * ACursor.DataAlign;
      end;
      if LOp = DW_CFA_GNU_negative_offset_extended then
        ARow.Rules[int64(LReg)].Value := 0 - int64(DoUleb(ACursor.At)) * ACursor.DataAlign;
      end;
      skip;
    end;
    if (LOp = DW_CFA_restore_extended) or (LOp = DW_CFA_undefined) or
      (LOp = DW_CFA_same_value) then
      LReg := DoUleb(ACursor.At);
      if LReg > 16 then
        return false;
      end;
      if LOp = DW_CFA_restore_extended then
        ARow.Rules[int64(LReg)] := AInitial.Rules[int64(LReg)];
      else
        ARow.Rules[int64(LReg)].Kind := 0;
        ARow.Rules[int64(LReg)].Value := 0;
      end;
      skip;
    end;
    if LOp = DW_CFA_register then
      LReg := DoUleb(ACursor.At);
      if LReg > 16 then
        return false;
      end;
      ARow.Rules[int64(LReg)].Kind := 2;
      ARow.Rules[int64(LReg)].Value := int64(DoUleb(ACursor.At));
      skip;
    end;
    if LOp = DW_CFA_remember_state then
      if LDepth >= ADAM_PLATFORM_CFI_STATES then
        return false;
      end;
      LStates[LDepth] := ARow;
      LDepth := LDepth + 1;
      skip;
    end;
    if LOp = DW_CFA_restore_state then
      if LDepth = 0 then
        return false;
      end;
      LDepth := LDepth - 1;
      // the CFA is the remembered one too (DWARF 5 sec 6.4.2.4: the whole row)
      ARow := LStates[LDepth];
      skip;
    end;
    if (LOp = DW_CFA_def_cfa) or (LOp = DW_CFA_def_cfa_sf) then
      ARow.CfaReg := int64(DoUleb(ACursor.At));
      if LOp = DW_CFA_def_cfa then
        ARow.CfaOffset := int64(DoUleb(ACursor.At));
      else
        ARow.CfaOffset := DoSleb(ACursor.At) * ACursor.DataAlign;
      end;
      skip;
    end;
    if LOp = DW_CFA_def_cfa_register then
      ARow.CfaReg := int64(DoUleb(ACursor.At));
      skip;
    end;
    if LOp = DW_CFA_def_cfa_offset then
      ARow.CfaOffset := int64(DoUleb(ACursor.At));
      skip;
    end;
    if LOp = DW_CFA_def_cfa_offset_sf then
      ARow.CfaOffset := DoSleb(ACursor.At) * ACursor.DataAlign;
      skip;
    end;
    if LOp = DW_CFA_GNU_args_size then
      DoUleb(ACursor.At);
      skip;
    end;
    return false;
  end;
  return true;
end;

// ARegs unwound out of a foreign frame (code with no Adam unwind data: a C library's,
// glibc's) by its .eh_frame CFI: the object holding the pc (dl_iterate_phdr), its FDE
// (.eh_frame_hdr's table), the CIE's and FDE's instructions run up to the call (AReturn:
// the pc is a return address, so the return address less 1; else the pc of a faulting
// instruction, as it is), then the CFA and every saved register read back. False when there
// is no FDE for it or its CFI is beyond this reader (a 64-bit record, an augmentation it
// does not know, an expression); a C frame has no scopes to run
func DoForeignUnwind(var ARegs: PlatformRegisters; const AReturn: bool): bool;
var
  LSearch: PlatformObjectSearch;
  LFde: uint64;
  LCie: uint64;
  LAt: uint64;
  LEnd: uint64;
  LCieEnd: uint64;
  LAugment: uint64;
  LCursor: PlatformCfiCursor;
  LInitial: PlatformCfiRow;
  LRow: PlatformCfiRow;
  LStart: uint64;
  LRange: uint64;
  LLocation: uint64;
  LPc: uint64;
  LCfa: uint64;
  LOld: PlatformRegisters;
  LOk: bool;
  LZ: bool;
  LLetter: uint64;
  LI: int64;
begin
  LPc := ARegs.Pc;
  if AReturn then
    LPc := ARegs.Pc - 1;
  end;
  LSearch.Pc := LPc;
  LSearch.Header := 0;
  dl_iterate_phdr(DoPhdrVisit, ptr(addr of LSearch));
  if LSearch.Header = 0 then
    return false;
  end;
  LFde := DoFindFde(LSearch.Header, LPc);
  if (LFde = 0) or (DoLongAt(LFde) = 0xFFFFFFFF) or (DoLongAt(LFde + 4) = 0) then
    return false;
  end;
  LEnd := LFde + 4 + DoLongAt(LFde);
  LCie := LFde + 4 - DoLongAt(LFde + 4);
  if (DoLongAt(LCie) = 0xFFFFFFFF) or (DoLongAt(LCie + 4) <> 0) then
    return false;
  end;
  LCieEnd := LCie + 4 + DoLongAt(LCie);
  // the CIE: version, augmentation string, alignments, return register, its data
  LAt := LCie + 9;
  LAugment := LAt;
  while DoByteAt(LAt) <> 0 do
    LAt := LAt + 1;
  end;
  LAt := LAt + 1;
  LCursor.CodeAlign := DoUleb(LAt);
  LCursor.DataAlign := DoSleb(LAt);
  if DoByteAt(LCie + 8) = 1 then
    LAt := LAt + 1;
  else
    DoUleb(LAt);
  end;
  LCursor.Encoding := DW_EH_PE_absptr;
  LOk := true;
  LZ := DoByteAt(LAugment) = 0x7A;
  if LZ then
    DoUleb(LAt);
    LI := 1;
    LLetter := DoByteAt(LAugment + uint64(LI));
    while LLetter <> 0 do
      if LLetter = 0x52 then
        // 'R': the FDE's pointer encoding
        LCursor.Encoding := DoByteAt(LAt);
        LAt := LAt + 1;
      else
        if LLetter = 0x50 then
          // 'P': the personality routine (C++'s; never called here)
          LAt := LAt + 1;
          DoEncoded(LAt, DoByteAt(LAt - 1), 0, LOk);
        else
          if LLetter = 0x4C then
            // 'L': the LSDA's encoding
            LAt := LAt + 1;
          else
            if LLetter <> 0x53 then
              // 'S' (a signal frame) needs nothing; any other letter is unknown
              return false;
            end;
          end;
        end;
      end;
      LI := LI + 1;
      LLetter := DoByteAt(LAugment + uint64(LI));
    end;
  else
    if DoByteAt(LAugment) <> 0 then
      return false;
    end;
  end;
  if not LOk then
    return false;
  end;
  // the CIE's initial instructions: the row every FDE starts from
  LInitial.CfaReg := 7;
  LInitial.CfaOffset := 8;
  for LI := 0 to 16 do
    LInitial.Rules[LI].Kind := 0;
    LInitial.Rules[LI].Value := 0;
  end;
  LCursor.At := LAt;
  LLocation := 0;
  if not DoRunCfi(LCursor, LCieEnd, 0, true, LLocation, LInitial, LInitial) then
    return false;
  end;
  // the FDE: its range, its augmentation data passed over, its instructions to the pc
  LAt := LFde + 8;
  LStart := DoEncoded(LAt, LCursor.Encoding, 0, LOk);
  LRange := DoEncoded(LAt, LCursor.Encoding & 0x0F, 0, LOk);
  if (not LOk) or (LPc < LStart) or (LPc >= LStart + LRange) then
    return false;
  end;
  if LZ then
    LAt := LAt + DoUleb(LAt);
  end;
  LRow := LInitial;
  LCursor.At := LAt;
  LLocation := LStart;
  if not DoRunCfi(LCursor, LEnd, LPc, false, LLocation, LRow, LInitial) then
    return false;
  end;
  if (LRow.CfaReg < 0) or (LRow.CfaReg > 15) or (LRow.Rules[ADAM_PLATFORM_CFI_RA].Kind <> 1) then
    return false;
  end;
  // the caller's registers: each saved one read back from the CFA, each moved one copied
  LOld := ARegs;
  LCfa := LOld.Regs[ADAM_PLATFORM_DWARF_REG[LRow.CfaReg]] + uint64(LRow.CfaOffset);
  for LI := 0 to 15 do
    if LRow.Rules[LI].Kind = 1 then
      ARegs.Regs[ADAM_PLATFORM_DWARF_REG[LI]] := DoWordAt(LCfa + uint64(LRow.Rules[LI].Value));
    end;
    if (LRow.Rules[LI].Kind = 2) and (LRow.Rules[LI].Value >= 0) and (LRow.Rules[LI].Value <= 15) then
      ARegs.Regs[ADAM_PLATFORM_DWARF_REG[LI]] :=
        LOld.Regs[ADAM_PLATFORM_DWARF_REG[LRow.Rules[LI].Value]];
    end;
  end;
  ARegs.Pc := DoWordAt(LCfa + uint64(LRow.Rules[ADAM_PLATFORM_CFI_RA].Value));
  ARegs.Regs[ADAM_PLATFORM_UNWIND_RSP] := LCfa;
  return true;
end;

// No frame catches the exception: the walk reached code no unwind data describes (neither
// Adam's nor an .eh_frame this unwinder reads), unwind data it cannot read, or the stack's
// end. The process stops (SIGABRT) with the reason on stderr
func DoNoCatch(const AWhy: ptr to const char); noreturn;
begin
  DoWriteErrorText(ptr to const char("System.Runtime.Linux64: no frame catches the exception ("));
  DoWriteErrorText(AWhy);
  DoWriteErrorText(ptr to const char(")\n"));
  abort();
end;

// The handler the unwinder (DoWalk) calls for a frame whose unwind data holds a guard's
// scope table (the compiler names it as the frame's handler, as on win64, where it is the
// OS's language handler): ARecord the exception's pointers, AFrame the frame's base,
// AContext its registers (PlatformRegisters), ADispatch the walk's PlatformDispatch. Its
// scopes from ScopeFirst on, innermost first, each holding the frame's pc: searching, a
// catching one's filter is called and a catch ends the search (1, its target in Found);
// unwinding, a finally's funclet runs (abnormal), on the catching frame up to its catching
// scope. 0 otherwise
public func PlatformFrameHandler(const ARecord: ptr; const AFrame: ptr; const AContext: ptr;
  const ADispatch: ptr): int32;
var
  LDispatch: ptr to PlatformDispatch;
  LRegs: ptr to PlatformRegisters;
  LRun: PlatformFinallyRun;
  LFilter: PlatformFilterRoutine;
  LFinally: PlatformFinallyRoutine;
  LCount: int64;
  LScope: uint64;
  LPc: uint64;
  LI: int64;
begin
  LDispatch := ptr to PlatformDispatch(ADispatch);
  LRegs := ptr to PlatformRegisters(AContext);
  LPc := LRegs^.Pc;
  LCount := int64(DoLongAt(LDispatch^.Scopes));
  LI := LDispatch^.ScopeFirst;
  while LI < LCount do
    LScope := LDispatch^.Scopes + 4 + uint64(LI) * ADAM_PLATFORM_SCOPE_ENTRY;
    if (LPc >= DoRelative(LScope)) and (LPc < DoRelative(LScope + 4)) then
      if DoLongAt(LScope + 12) <> 0 then
        // a catching scope
        if not LDispatch^.Unwinding then
          LFilter := PlatformFilterRoutine(ptr(DoRelative(LScope + 8)));
          if LFilter(ARecord, AFrame) > 0 then
            LDispatch^.Found := DoRelative(LScope + 12);
            return 1;
          end;
        end;
        if LDispatch^.Unwinding and LDispatch^.IsTarget and
          (DoRelative(LScope + 12) = LDispatch^.TargetPc) then
          return 0;
        end;
      else
        if LDispatch^.Unwinding then
          // a finally: a raise out of it goes on from this frame past this scope
          LRun.Regs := LRegs^;
          LRun.PcReturn := LDispatch^.PcReturn;
          LRun.ScopeNext := LI + 1;
          LRun.Outer := GFinallyRuns;
          GFinallyRuns := addr of LRun;
          LFinally := PlatformFinallyRoutine(ptr(DoRelative(LScope + 8)));
          LFinally(1, AFrame);
          GFinallyRuns := LRun.Outer;
        end;
      end;
    end;
    LI := LI + 1;
  end;
  return 0;
end;

// The two phases over the frames from AStart (Windows' x64 dispatch): searching (not
// AUnwinding), each frame's handler calls its catching scopes' filters until one catches
// (ADepth, AFrame: that frame's place in the walk and its base, ATarget the catch's
// address; true); unwinding, each frame's handler runs its finally funclets, innermost
// first, up to the catching frame, where the walk resumes at the catch (the
// frame's registers loaded: DoResumeAt). A frame of a handler running a finally
// (GFinallyRuns: a raise out of that funclet) is passed over to the frame the funclet
// belongs to, at the scope after it; a foreign frame unwinds by its .eh_frame
// (DoForeignUnwind). AFault: AStart is a faulting frame (LX4c), its pc the instruction
// that faulted, not a return address (every frame after it is a caller's); with no unwind
// data of any kind it is a bare leaf's (its return address at its rsp), as Windows unwinds
// a frame no function entry describes. False (searching): no frame catches it
func DoWalk(const AStart: PlatformRegisters; const APointers: ptr;
  const AUnwinding: bool; const AFault: bool; var ADepth: int64;
  var AFrame: uint64; var ATarget: uint64): bool;
var
  LRegs: PlatformRegisters;
  LFacts: PlatformFrameFacts;
  LDispatch: PlatformDispatch;
  LCursor: ptr to PlatformFinallyRun;
  LData: uint64;
  LHandler: PlatformHandlerRoutine;
  LBase: uint64;
  LDepth: int64;
  LResult: int32;
  LSelf: PlatformHandlerRoutine;
  LReturn: bool;
begin
  LSelf := PlatformFrameHandler;
  LRegs := AStart;
  LCursor := GFinallyRuns;
  LDispatch.ScopeFirst := 0;
  LDepth := 0;
  LReturn := not AFault;
  while true do
    if not DoFrameFacts(LRegs.Pc, LReturn, LFacts) then
      DoNoCatch(ptr to const char("unwind data the unwinder cannot read"));
    end;
    if LFacts.Entry = nil then
      // a foreign frame (a C library's, glibc's: a callback's caller) has no scopes: its
      // .eh_frame unwinds it
      if not DoForeignUnwind(LRegs, LReturn) then
        if LReturn then
          if AUnwinding then
            DoNoCatch(ptr to const char("a frame no unwind data describes, while unwinding"));
          end;
          return false;
        end;
        // the faulting frame with no unwind data at all: a bare leaf (AFacts say so)
        DoUnwindFrame(LRegs, LFacts);
      end;
      LReturn := true;
      LDispatch.ScopeFirst := 0;
      LDepth := LDepth + 1;
      if LRegs.Pc = 0 then
        if AUnwinding then
          DoNoCatch(ptr to const char("the stack's end while unwinding"));
        end;
        return false;
      end;
      skip;
    end;
    LData := DoHandlerData(LFacts.Entry);
    if (LCursor <> nil) and (LFacts.Entry^.Start = uint64(ptr(LSelf))) then
      // a handler running a finally: on from the funclet's own frame, past its scope
      LRegs := LCursor^.Regs;
      LDispatch.ScopeFirst := LCursor^.ScopeNext;
      LReturn := LCursor^.PcReturn;
      LCursor := LCursor^.Outer;
    else
      LBase := DoFrameBase(LRegs, LFacts);
      if LData <> 0 then
        LDispatch.Scopes := LData + 4;
        LDispatch.PcReturn := LReturn;
        LDispatch.Unwinding := AUnwinding;
        LDispatch.IsTarget := AUnwinding and (LDepth = ADepth) and (LBase = AFrame);
        LDispatch.TargetPc := ATarget;
        LDispatch.Found := 0;
        LHandler := PlatformHandlerRoutine(ptr(DoRelative(LData)));
        LResult := LHandler(APointers, ptr(LBase), ptr(addr of LRegs), ptr(addr of LDispatch));
        if (not AUnwinding) and (LResult > 0) then
          ADepth := LDepth;
          AFrame := LBase;
          ATarget := LDispatch.Found;
          return true;
        end;
      end;
      if AUnwinding and (LDepth = ADepth) then
        // the catching frame: the finally runs the walk passed over are abandoned with it
        GFinallyRuns := LCursor;
        DoResumeAt(ptr(addr of LRegs), ATarget);
      end;
      DoUnwindFrame(LRegs, LFacts);
      LReturn := true;
      LDispatch.ScopeFirst := 0;
      LDepth := LDepth + 1;
      if LRegs.Pc = 0 then
        if AUnwinding then
          DoNoCatch(ptr to const char("the stack's end while unwinding"));
        end;
        return false;
      end;
    end;
  end;
end;

// The exception ACode (AKind: a fault's kind) dispatched from the frame AStart describes
// (AFault: a faulting frame, its pc the instruction that faulted): the frames are searched
// for a catching scope, then unwound to it, where the code resumes (never returning). It
// returns when no frame catches it, nothing unwound. While it searches a fault is the
// unwinder's own (GFaultSearching: the signal handler reports it as no guard took it)
func DoTryDispatch(const AStart: PlatformRegisters; const ACode: uint32; const AKind: int32;
  const AFault: bool);
var
  LRecord: PlatformException;
  LPointers: array[0..1] of ptr;
  LStart: PlatformRegisters;
  LDepth: int64;
  LFrame: uint64;
  LTarget: uint64;
  LFound: bool;
begin
  LRecord.Code := ACode;
  LRecord.Kind := AKind;
  LStart := AStart;
  LPointers[0] := ptr(addr of LRecord);
  LPointers[1] := ptr(addr of LStart);
  LDepth := -1;
  LFrame := 0;
  LTarget := 0;
  GFaultSearching := true;
  LFound := DoWalk(LStart, ptr(addr of LPointers), false, AFault, LDepth, LFrame, LTarget);
  GFaultSearching := false;
  if not LFound then
    return;
  end;
  DoWalk(LStart, ptr(addr of LPointers), true, AFault, LDepth, LFrame, LTarget);
  DoNoCatch(ptr to const char("the catching frame was not met again"));
end;

// The exception ACode (AKind: a fault's kind) dispatched from the caller's frame on
// (DoTryDispatch); it never returns
func DoDispatch(const ACode: uint32; const AKind: int32); noreturn;
var
  LStart: PlatformRegisters;
begin
  memset(ptr(addr of LStart), 0, uint64(size(PlatformRegisters)));
  DoSaveRegisters(ptr(addr of LStart));
  DoTryDispatch(LStart, ACode, AKind, false);
  DoNoCatch(ptr to const char("no catching scope, or a frame no unwind data describes"));
end;

// Raises the runtime's exception (ADAM_PLATFORM_RAISE_CODE): the unwinder walks the frames
// for one whose scope catches it, then unwinds the frames in between (their finally and
// cleanup funclets run) and resumes at the catch; it never returns (plan H1)
public func PlatformRaise(); noreturn;
begin
  DoDispatch(ADAM_PLATFORM_RAISE_CODE, 0);
end;

// Raises a generator's abort (ADAM_PLATFORM_ABORT_CODE): no guard's except part takes it,
// so the frames up to the generator's own start unwind (their finally and cleanup funclets
// run) and its last catching scope (PlatformCatchAbort's) ends the generator; it never
// returns
public func PlatformAbort(); noreturn;
begin
  DoDispatch(ADAM_PLATFORM_ABORT_CODE, 0);
end;

// The exception's code and fault kind from a filter's APointers (its first word the
// PlatformException)
func DoExceptionOf(const APointers: ptr): ptr to PlatformException;
var
  LPointers: ptr to ptr;
begin
  LPointers := ptr to ptr(APointers);
  return ptr to PlatformException(LPointers[0]);
end;

// The filter of a guard's catching scope, called as the exception is dispatched (APointers
// the exception's pointers, AFrame the guard's frame): 1 (caught) for the runtime's own
// exception and for a hardware fault (BNF sec 5: a guard takes both), whose kind is kept
// for the guard's except part (GFaultPending, PlatformFaultTaken); 0 (search on) for any
// other, a generator's abort included (PlatformCatchAbort's alone)
public func PlatformCatch(const APointers: ptr; const AFrame: ptr): int32;
var
  LException: ptr to PlatformException;
begin
  LException := DoExceptionOf(APointers);
  if LException^.Code = ADAM_PLATFORM_RAISE_CODE then
    GFaultPending := 0;
    return 1;
  end;
  if LException^.Code = ADAM_PLATFORM_FAULT_CODE then
    GFaultPending := LException^.Kind;
    return 1;
  end;
  return 0;
end;

// The filter of a last catching scope (the entry's, a module teardown's, a started
// thread's), whose catch reports the raise and ends the process with its teardown
// (System.Runtime's Unhandled): 1 for the runtime's own exception only (a hardware fault
// goes on to the fault handler, PlatformAtFault: reported, no teardown, BNF sec 1)
public func PlatformCatchRaise(const APointers: ptr; const AFrame: ptr): int32;
begin
  if DoExceptionOf(APointers)^.Code = ADAM_PLATFORM_RAISE_CODE then
    GFaultPending := 0;
    return 1;
  end;
  return 0;
end;

// The filter of a generator's own start's last catching scope (System.Runtime's
// GeneratorRun), whose catch ends the generator (GeneratorEnd): 1 for a generator's abort
// only (PlatformAbort)
public func PlatformCatchAbort(const APointers: ptr; const AFrame: ptr): int32;
begin
  if DoExceptionOf(APointers)^.Code = ADAM_PLATFORM_ABORT_CODE then
    return 1;
  end;
  return 0;
end;

// A guard's except part's start (System.Runtime's RaiseTaken): the hardware fault kind
// its filter took (PlatformCatch), 0 when it took a raise. A caught stack overflow needs
// nothing made again: the stack's guard (the kernel's gap below a main thread's stack,
// pthread's guard page, a coroutine's) stays, so the next overflow faults the same way
public func PlatformFaultTaken(): int32;
var
  LKind: int32;
begin
  LKind := GFaultPending;
  GFaultPending := 0;
  return LKind;
end;

// Writes the ACount bytes at AText to stderr in one system call, no stdio (its lock may be
// held by the code that faulted): the fault report's line
public func PlatformWriteErrorDirect(const AText: ptr; const ACount: int64);
begin
  write(STDERR_FILENO, AText, uint64(ACount));
end;

// Ends the process at once with the exit code ACode: no exit-time handler runs, no stream
// is flushed (PaskalCPP's report_unguarded_fault)
public func PlatformTerminate(const ACode: int32); noreturn;
begin
  _exit(ACode);
end;

// The stand-ins for C's stat / fstat / lstat and their 64 forms (x86_64's struct stat64 is
// struct stat), which glibc's libc_nonshared.a defines below glibc 2.33 (its stat-2.32.o
// wrappers) and an Adam image does not carry: the path's (link
// followed) / the open file's / the path's own (link not followed) facts into AStat, the
// kernel's own calls (SYS_stat / SYS_fstat / SYS_lstat through syscall: no hook between, so
// Adam's own FileExists / FileSize mean the real file system, as System.IO.Win64's do); 0, or
// -1 with errno set. A C library's stat / fstat / lstat meet System.HookIO.Linux64's hooks by
// their own names when it is linked
public func PlatformCStat(const APath: ptr to const char; var AStat: PlatformStat): int32;
begin
  return int32(syscall(SYS_stat, APath, addr of AStat));
end;

public func PlatformCFstat(const AFile: int32; var AStat: PlatformStat): int32;
begin
  return int32(syscall(SYS_fstat, int64(AFile), addr of AStat));
end;

public func PlatformCLstat(const APath: ptr to const char; var AStat: PlatformStat): int32;
begin
  return int32(syscall(SYS_lstat, APath, addr of AStat));
end;

// The stand-in for C's atexit, which libc_nonshared.a defines and an Adam image does not
// carry: registers AHandler in the exit-time list glibc's exit runs (__cxa_atexit, the
// program's own: no dso handle); 0, or nonzero when the list has no room
public func PlatformCAtExit(const AHandler: func()): int32;
begin
  return __cxa_atexit(AHandler, nil, nil);
end;

// AHandler run when the process ends through exit, however it is called (the runtime's
// Halt or a program's own call of glibc's exit), the last one registered first
public func PlatformAtExit(const AHandler: func());
begin
  PlatformCAtExit(AHandler);
end;

// A .so's load and unload handed on (System.Runtime.Win64's loader events; LX6b: its
// init / fini arrays)
public func PlatformDLLEvent(const AModule: ptr; const AReason: int32; const AReserved: ptr): bool;
begin
  DoPending(ptr to const char("PlatformDLLEvent"), ptr to const char("LX6b"));
end;

// AHandler run on each thread but the main one as it ends (PlatformThreadCallback), the
// thread's own last code: its threadstatics are still there to release
public func PlatformAtThreadEnd(const AHandler: func());
begin
  GThreadEnd := AHandler;
end;

// The calling thread's fault state made ready and given back (the hardware faults'
// section below: DoFaultThreadReady, DoFaultThreadEnd)
forward func DoFaultThreadReady();
forward func DoFaultThreadEnd();

// A thread's end handed on (AReason ADAM_PLATFORM_THREAD_END; the other reasons ask
// nothing): the registered thread end (PlatformAtThreadEnd) runs once per thread. Its
// caller on this target is the thread key's destructor LX4d registers
public func PlatformThreadCallback(const AModule: ptr; const AReason: uint32;
  const AReserved: ptr);
var
  LEnd: func();
begin
  if (AReason <> ADAM_PLATFORM_THREAD_END) or GThreadEndRan then
    return;
  end;
  GThreadEndRan := true;
  LEnd := GThreadEnd;
  if ptr(LEnd) <> nil then
    LEnd();
  end;
  DoCoroutineThreadEnd();
  DoFaultThreadEnd();
end;

// The base (the high end) of the stack the calling code runs on: the thread's own
// (pthread_getattr_np: its lowest address and size), so two places compare as places on
// one stack only when their bases are the same; 0 when it cannot be read. On a coroutine
// (PlatformCoroutineSwitch's) its own stack's
public func PlatformStackBase(): uint64;
var
  LAttributes: array[0..6] of uint64;
  LLow: ptr;
  LSize: uint64;
begin
  if (GCoroutineCurrent <> nil) and (GCoroutineCurrent^.StackHigh <> 0) then
    return GCoroutineCurrent^.StackHigh;
  end;
  if pthread_getattr_np(pthread_self(), ptr(addr of LAttributes)) <> 0 then
    return 0;
  end;
  LLow := nil;
  LSize := 0;
  if pthread_attr_getstack(ptr(addr of LAttributes), LLow, LSize) <> 0 then
    pthread_attr_destroy(ptr(addr of LAttributes));
    return 0;
  end;
  pthread_attr_destroy(ptr(addr of LAttributes));
  return uint64(LLow) + LSize;
end;

@ifdef DEBUG
const
  // The per-thread cache's entry count (GFrameCache's length; a power of two)
  ADAM_PLATFORM_FRAME_CACHE: int64 = 256;

threadstatic
  // This thread's frame facts by return address (Adam code only: an exe's code is never
  // unloaded), and its stack's bounds (0 until the thread's first capture)
  GFrameCache: array[0..255] of PlatformFrameFacts;
  GFrameLow: uint64;
  GFrameHigh: uint64;

// This thread's stack bounds read (pthread_getattr_np: its lowest address and size)
func DoFrameStart();
var
  LAttributes: array[0..6] of uint64;
  LLow: ptr;
  LSize: uint64;
begin
  GFrameLow := 1;
  GFrameHigh := 0;
  if pthread_getattr_np(pthread_self(), ptr(addr of LAttributes)) <> 0 then
    return;
  end;
  LLow := nil;
  LSize := 0;
  if pthread_attr_getstack(ptr(addr of LAttributes), LLow, LSize) = 0 then
    GFrameLow := uint64(LLow);
    GFrameHigh := uint64(LLow) + LSize;
  end;
  pthread_attr_destroy(ptr(addr of LAttributes));
end;

// The leak tracker's frames (M4.L2; debug builds only): up to ACount return addresses of
// the calling thread into AFrames, innermost first, ASkip frames of the caller's own on
// left out (0: the caller's return address first), 0 past the last; the count captured.
// Frame 0 of the walk is this routine's own. The walk is the unwinder's (DoFrameFacts,
// DoUnwindFrame), a frame's facts kept in a per-thread cache by return address; it ends at
// a frame with no Adam unwind data (glibc's __libc_start_main, a C library's), a slot off
// the thread's stack or a nil return address. The registers come from __adam_registers
public func PlatformCaptureFrames(const ASkip: int32; const ACount: int32;
  const AFrames: ptr): int32;
var
  LRegs: PlatformRegisters;
  LFrames: ptr to uint64;
  LEntry: ptr to PlatformFrameFacts;
  LMiss: PlatformFrameFacts;
  LBase: uint64;
  LIndex: int32;
  LCaptured: int32;
  LI: int32;
begin
  LFrames := ptr to uint64(AFrames);
  for LI := 0 to ACount - 1 do
    LFrames[LI] := 0;
  end;
  if GFrameHigh = 0 then
    DoFrameStart();
  end;
  DoSaveRegisters(ptr(addr of LRegs));
  LIndex := 0;
  LCaptured := 0;
  while LCaptured < ACount do
    if LIndex > ASkip then
      LFrames[LCaptured] := LRegs.Pc;
      LCaptured := LCaptured + 1;
      if LCaptured >= ACount then
        return LCaptured;
      end;
    end;
    // the frame's facts: this thread's cache entry for its pc, else worked out into LMiss
    LEntry := addr of GFrameCache[int64((LRegs.Pc xor (LRegs.Pc shr 10)) &
      uint64(ADAM_PLATFORM_FRAME_CACHE - 1))];
    if LEntry^.Pc <> LRegs.Pc then
      if not DoFrameFacts(LRegs.Pc, true, LMiss) then
        return LCaptured;
      end;
      if LMiss.Entry = nil then
        return LCaptured;
      end;
      LEntry^ := LMiss;
    end;
    // every slot the unwind reads on this thread's stack
    LBase := DoFrameBase(LRegs, LEntry^);
    if (LBase < GFrameLow) or (LBase + uint64(LEntry^.Total) + 8 > GFrameHigh) then
      return LCaptured;
    end;
    DoUnwindFrame(LRegs, LEntry^);
    if LRegs.Pc = 0 then
      return LCaptured;
    end;
    LIndex := LIndex + 1;
  end;
  return LCaptured;
end;
@endif

// ASize bytes from the heap, uninitialized; nil when there is no room
public func PlatformAlloc(const ASize: int64): ptr;
begin
  return malloc(uint64(ASize));
end;

// The block at APointer grown or shrunk to ASize bytes, its contents kept up to the
// smaller size, maybe moved (the new address); nil APointer allocates
public func PlatformResize(const APointer: ptr; const ASize: int64): ptr;
begin
  return realloc(APointer, uint64(ASize));
end;

// The usable bytes of the heap block at APointer (not nil): at least the size it was last
// given (setlength grows within it before it asks the heap again)
public func PlatformBlockSize(const APointer: ptr): int64;
begin
  return int64(malloc_usable_size(APointer));
end;

// The block at APointer back to the heap; nil does nothing
public func PlatformFree(const APointer: ptr);
begin
  free(APointer);
end;

// ACount bytes copied from ASource to ADest (the two do not overlap)
public func PlatformCopy(const ADest: ptr; const ASource: ptr; const ACount: int64);
begin
  memcpy(ADest, ASource, uint64(ACount));
end;

// ACount bytes at AAddress set to 0
public func PlatformZero(const AAddress: ptr; const ACount: int64);
begin
  memset(AAddress, 0, uint64(ACount));
end;

// glibc: the threads (PlatformThreadStart .. PlatformThreadDetach): a new thread running
// AStart(AArgument) (its pthread_t into AThread, 0 on success), one waited for (its result
// into AResult when not nil), one joined only if it has ended (EBUSY while it runs), one
// never joined (its resources freed as it ends)
func pthread_create(var AThread: uint64; const AAttributes: ptr;
  const AStart: func(AArgument: ptr): ptr; const AArgument: ptr): int32; external "c";
func pthread_join(const AThread: uint64; const AResult: ptr): int32; external "c";
func pthread_tryjoin_np(const AThread: uint64; const AResult: ptr): int32; external "c";
func pthread_detach(const AThread: uint64): int32; external "c";
// glibc: a thread key (its destructor called on each thread whose value for the key is not
// nil as that thread ends, by return or pthread_exit, its TLS still there), made once
// however many threads start at the same time (pthread_once: a pthread_once_t, an int32,
// 0 until done)
func pthread_key_create(var AKey: uint32; const ADestructor: func(AValue: ptr)): int32;
  external "c";
func pthread_setspecific(const AKey: uint32; const AValue: ptr): int32; external "c";
func pthread_once(const AOnce: ptr; const AInit: func()): int32; external "c";

const
  // The thread key's value a thread PlatformThreadStart made holds: not nil, so the key's
  // destructor (DoThreadKeyEnd) runs at its end
  ADAM_PLATFORM_THREAD_MARK: uint64 = 1;

var
  // pthread_once's word for the thread key (DoThreadKeyMake), the key, and whether it was
  // made (false: pthread_key_create refused, no thread is started)
  GThreadKeyOnce: int32;
  GThreadKey: uint32;
  GThreadKeyReady: bool;

// The thread key's destructor: a thread PlatformThreadStart made is ending (its run routine
// returned, or it called pthread_exit), on that thread with its threadstatics there: the
// thread end handed on (PlatformThreadCallback), as win64's loader does at DLL_THREAD_DETACH
func DoThreadKeyEnd(AValue: ptr);
begin
  PlatformThreadCallback(nil, ADAM_PLATFORM_THREAD_END, nil);
end;

// The thread key made, once (pthread_once's init)
func DoThreadKeyMake();
begin
  GThreadKeyReady := pthread_key_create(GThreadKey, DoThreadKeyEnd) = 0;
end;

// The OS's start of a thread PlatformThreadStart made (pthread_create's start routine):
// AParameter is its two-word block from the C heap (the run routine, then its block), freed
// here before the run routine is called on this thread; the thread key marked first, so the
// thread's end (DoThreadKeyEnd) runs however the thread ends, then its fault state made
// ready (DoFaultThreadReady: a stack overflow is caught on it too); the thread's result is nil
func DoThreadProc(AParameter: ptr): ptr;
var
  LSlots: ptr to ptr;
  LRun: PlatformThreadRun;
  LBlock: ptr;
begin
  LSlots := ptr to ptr(AParameter);
  LRun := PlatformThreadRun(LSlots[0]);
  LBlock := LSlots[1];
  free(AParameter);
  pthread_setspecific(GThreadKey, ptr(ADAM_PLATFORM_THREAD_MARK));
  DoFaultThreadReady();
  LRun(LBlock);
  return nil;
end;

// A new thread that runs ARun(ABlock) (System.Runtime's ThreadRun), started at once: its
// handle (its pthread_t, PlatformThreadJoin's; never 0 in glibc), or 0 when it could not be
// started (no room, the thread key not made, or glibc refused)
public func PlatformThreadStart(const ARun: func(const ABlock: ptr); const ABlock: ptr): uint64;
var
  LSlots: ptr to ptr;
  LThread: uint64;
begin
  pthread_once(ptr(addr of GThreadKeyOnce), DoThreadKeyMake);
  if not GThreadKeyReady then
    return 0;
  end;
  LSlots := ptr to ptr(malloc(16));
  if LSlots = nil then
    return 0;
  end;
  LSlots[0] := ptr(ARun);
  LSlots[1] := ABlock;
  LThread := 0;
  if pthread_create(LThread, nil, DoThreadProc, ptr(LSlots)) <> 0 then
    free(ptr(LSlots));
    return 0;
  end;
  return LThread;
end;

// Waits for the thread AThread (PlatformThreadStart's) to end, then its resources are freed
public func PlatformThreadJoin(const AThread: uint64);
begin
  pthread_join(AThread, nil);
end;

// The thread AThread (PlatformThreadStart's) joined only if it has ended already, never
// waiting: true with its resources freed; false (still running) leaves it as it was
public func PlatformThreadTryJoin(const AThread: uint64): bool;
begin
  return pthread_tryjoin_np(AThread, nil) = 0;
end;

// The thread AThread (PlatformThreadStart's) never joined: its resources freed as it ends,
// the thread running on (or ended) unaffected
public func PlatformThreadDetach(const AThread: uint64);
begin
  pthread_detach(AThread);
end;

// glibc: memory mapped, protected and given back
func mmap(const AAddress: ptr; const ALength: uint64; const AProtection: int32;
  const AFlags: int32; const AFile: int32; const AOffset: int64): ptr; external "c";
func mprotect(const AAddress: ptr; const ALength: uint64; const AProtection: int32): int32;
  external "c";
func munmap(const AAddress: ptr; const ALength: uint64): int32; external "c";

const
  // A coroutine's stack (as win64's reserve: 1 MiB), the guard page below it (a page's
  // bytes when sysconf cannot tell: _SC_PAGESIZE)
  ADAM_PLATFORM_COROUTINE_STACK: uint64 = 1048576;
  ADAM_PLATFORM_PAGE_DEFAULT: uint64 = 4096;
  _SC_PAGESIZE: int32 = 30;
  // sys/mman.h (x86_64): the protections and mapping flags, and mmap's failure
  PROT_NONE: int32 = 0;
  PROT_READ: int32 = 1;
  PROT_WRITE: int32 = 2;
  PROT_EXEC: int32 = 4;
  MAP_PRIVATE: int32 = 0x02;
  MAP_ANONYMOUS: int32 = 0x20;
  MAP_STACK: int32 = 0x20000;
  ADAM_PLATFORM_MAP_FAILED: uint64 = 0xFFFFFFFFFFFFFFFF;
  // A new coroutine's first switch (its stack's top, as __adam_switch pops it): the
  // floating-point control words (MXCSR 0x1F80 then the x87 control word 0x037F: the ABI's
  // initial state), six zeroed callee-saved registers, DoCoroutineStart as the return
  // address, a nil return address above it (the unwinder's end of the stack)
  ADAM_PLATFORM_FP_CONTROL: uint64 = 0x0000037F00001F80;
  ADAM_PLATFORM_COROUTINE_FIRST: int64 = 9;

// The calling thread's stack bounds (pthread_getattr_np: its lowest address and size) into
// ALow / AHigh; false when they cannot be read
func DoThreadStack(var ALow: uint64; var AHigh: uint64): bool;
var
  LAttributes: array[0..6] of uint64;
  LLow: ptr;
  LSize: uint64;
  LOk: bool;
begin
  if pthread_getattr_np(pthread_self(), ptr(addr of LAttributes)) <> 0 then
    return false;
  end;
  LLow := nil;
  LSize := 0;
  LOk := pthread_attr_getstack(ptr(addr of LAttributes), LLow, LSize) = 0;
  pthread_attr_destroy(ptr(addr of LAttributes));
  if LOk then
    ALow := uint64(LLow);
    AHigh := uint64(LLow) + LSize;
  end;
  return LOk;
end;

// The calling thread's own coroutine (GCoroutineThread), made the first time it is asked
// for: no stack of its own (the thread's: its bounds kept), its stack pointer kept the first
// time it switches away; nil when there is no room
func DoThreadCoroutine(): ptr to PlatformCoroutine;
var
  LCoroutine: ptr to PlatformCoroutine;
  LLow: uint64;
  LHigh: uint64;
begin
  if GCoroutineThread <> nil then
    return GCoroutineThread;
  end;
  LCoroutine := ptr to PlatformCoroutine(malloc(uint64(size(PlatformCoroutine))));
  if LCoroutine = nil then
    return nil;
  end;
  // Map, Run and Block stay nil: a thread's own coroutine has no stack or run of its own
  memset(ptr(LCoroutine), 0, uint64(size(PlatformCoroutine)));
  LLow := 0;
  LHigh := 0;
  if DoThreadStack(LLow, LHigh) then
    LCoroutine^.StackLow := LLow;
    LCoroutine^.StackHigh := LHigh;
  end;
  GCoroutineThread := LCoroutine;
  GCoroutineCurrent := LCoroutine;
  return LCoroutine;
end;

// A coroutine's start (its first switch returns here, on its own stack): the coroutine is
// the one the switch to it wrote (GCoroutineCurrent), its run called with its block. A run
// never returns (it ends by switching away for good, System.Runtime's GeneratorEnd): there
// is nothing to return to (the slot above holds nil), so the process ends here
func DoCoroutineStart();
var
  LCoroutine: ptr to PlatformCoroutine;
  LRun: func(const ABlock: ptr);
begin
  LCoroutine := GCoroutineCurrent;
  LRun := LCoroutine^.Run;
  LRun(LCoroutine^.Block);
  PlatformTerminate(1);
end;

// A new coroutine that runs ARun(ABlock) on a stack of its own (System.Runtime's
// GeneratorRun) once it is first switched to (PlatformCoroutineSwitch), not before; ARun
// never returns. Its stack is ADAM_PLATFORM_COROUTINE_STACK bytes mapped (pages taken as
// it grows) over a guard page, so an overflow faults rather than writing past it. nil when
// it could not be made (no room, or the OS refused)
public func PlatformCoroutineNew(const ARun: func(const ABlock: ptr); const ABlock: ptr): ptr;
var
  LCoroutine: ptr to PlatformCoroutine;
  LPage: uint64;
  LMap: ptr;
  LSlots: ptr to uint64;
  LStart: func();
  LI: int64;
begin
  LPage := ADAM_PLATFORM_PAGE_DEFAULT;
  if sysconf(_SC_PAGESIZE) > 0 then
    LPage := uint64(sysconf(_SC_PAGESIZE));
  end;
  LCoroutine := ptr to PlatformCoroutine(malloc(uint64(size(PlatformCoroutine))));
  if LCoroutine = nil then
    return nil;
  end;
  memset(ptr(LCoroutine), 0, uint64(size(PlatformCoroutine)));
  LMap := mmap(nil, ADAM_PLATFORM_COROUTINE_STACK + LPage, PROT_READ | PROT_WRITE,
    MAP_PRIVATE | MAP_ANONYMOUS | MAP_STACK, -1, 0);
  if uint64(LMap) = ADAM_PLATFORM_MAP_FAILED then
    free(ptr(LCoroutine));
    return nil;
  end;
  if mprotect(LMap, LPage, PROT_NONE) <> 0 then
    munmap(LMap, ADAM_PLATFORM_COROUTINE_STACK + LPage);
    free(ptr(LCoroutine));
    return nil;
  end;
  LCoroutine^.Map := LMap;
  LCoroutine^.MapSize := ADAM_PLATFORM_COROUTINE_STACK + LPage;
  LCoroutine^.StackLow := uint64(LMap) + LPage;
  LCoroutine^.StackHigh := uint64(LMap) + LPage + ADAM_PLATFORM_COROUTINE_STACK;
  LCoroutine^.Run := ARun;
  LCoroutine^.Block := ABlock;
  // its first switch's frame at the stack's top (ADAM_PLATFORM_COROUTINE_FIRST words)
  LStart := DoCoroutineStart;
  LSlots := ptr to uint64(LCoroutine^.StackHigh - uint64(ADAM_PLATFORM_COROUTINE_FIRST) * 8);
  LSlots[0] := ADAM_PLATFORM_FP_CONTROL;
  for LI := 1 to 6 do
    LSlots[LI] := 0;
  end;
  LSlots[7] := uint64(ptr(LStart));
  LSlots[8] := 0;
  LCoroutine^.SavedRsp := uint64(ptr(LSlots));
  return ptr(LCoroutine);
end;

// The coroutine running on the calling thread: the one switched to last, or the thread's
// own (made the first time: DoThreadCoroutine); what a switch back names. nil when there
// is no room for the thread's own
public func PlatformCoroutineSelf(): ptr;
begin
  if GCoroutineCurrent <> nil then
    return ptr(GCoroutineCurrent);
  end;
  return ptr(DoThreadCoroutine());
end;

// The calling thread switched to the coroutine ATo (PlatformCoroutineNew's, or one
// PlatformCoroutineSelf named), which runs from where it last switched away (its run's
// start the first time); this returns when something switches back to the coroutine that
// called it, perhaps on another thread. The calling thread runs a coroutine already
// (PlatformCoroutineSelf gave one); ATo is never the running one, nor one running on
// another thread. The running coroutine (and, in a debug build, the leak tracker's stack
// bounds: ATo's) is written before the switch and nothing of this thread's is read after
// it (the thread may be another one by then)
public func PlatformCoroutineSwitch(const ATo: ptr);
var
  LTo: ptr to PlatformCoroutine;
  LFrom: ptr to PlatformCoroutine;
begin
  LTo := ptr to PlatformCoroutine(ATo);
  LFrom := GCoroutineCurrent;
  GCoroutineCurrent := LTo;
@ifdef DEBUG
  if GFrameHigh = 0 then
    DoFrameStart();
  end;
  if LTo^.StackHigh <> 0 then
    GFrameLow := LTo^.StackLow;
    GFrameHigh := LTo^.StackHigh;
  end;
@endif
  DoSwitchStack(ptr(addr of LFrom^.SavedRsp), ptr(addr of LTo^.SavedRsp));
end;

// The coroutine ACoroutine (PlatformCoroutineNew's) freed, its stack with it: it is not
// running anywhere (finished, or never switched to again); nil does nothing
public func PlatformCoroutineFree(const ACoroutine: ptr);
var
  LCoroutine: ptr to PlatformCoroutine;
begin
  if ACoroutine = nil then
    return;
  end;
  LCoroutine := ptr to PlatformCoroutine(ACoroutine);
  if LCoroutine^.Map <> nil then
    munmap(LCoroutine^.Map, LCoroutine^.MapSize);
  end;
  free(ACoroutine);
end;

// ---- Hardware faults (plan H2): SIGSEGV / SIGBUS / SIGFPE / SIGILL and stack overflow

// glibc: a signal's action, the thread's alternate signal stack, a signal sent to a thread
func sigaction(const ASignal: int32; const AAction: ptr; const AOld: ptr): int32; external "c";
func sigaltstack(const AStack: ptr; const AOld: ptr): int32; external "c";
func pthread_kill(const AThread: uint64; const ASignal: int32): int32; external "c";

type
  // struct sigaction (x86_64 glibc, 152 bytes): its tag shares sigaction's name, so the
  // record is the runtime's; its fields keep the header's names (the handler's union as
  // sa_sigaction, the int's padding as pad0)
  PlatformSigaction = record
    sa_sigaction: ptr;
    sa_mask: array[0..15] of uint64;
    sa_flags: int32;
    pad0: int32;
    sa_restorer: ptr;
  end;
  // stack_t (x86_64, 24 bytes): an alternate signal stack
  stack_t = record
    ss_sp: ptr;
    ss_flags: int32;
    pad0: int32;
    ss_size: uint64;
  end;
  // A signal handler as SA_SIGINFO calls it: the signal, its siginfo_t, its ucontext_t
  PlatformSignalHandler = func(ASignal: int32; AInfo: ptr; AContext: ptr);

const
  // signal.h (x86_64): the hardware fault signals, sigaction's flags, sigaltstack's off
  SIGILL: int32 = 4;
  SIGBUS: int32 = 7;
  SIGFPE: int32 = 8;
  SIGSEGV: int32 = 11;
  SA_SIGINFO: int32 = 4;
  SA_ONSTACK: int32 = 0x08000000;
  SS_DISABLE: int32 = 2;
  // siginfo_t's si_code of a SIGFPE: integer divide (by zero, or a quotient past its
  // width: x86's #DE gives both), integer overflow, float divide by zero, overflow, underflow
  FPE_INTDIV: int32 = 1;
  FPE_INTOVF: int32 = 2;
  FPE_FLTDIV: int32 = 3;
  FPE_FLTOVF: int32 = 4;
  FPE_FLTUND: int32 = 5;
  // sys/ucontext.h (x86_64): gregs' indices of rsp and rip
  REG_RSP: int64 = 15;
  REG_RIP: int64 = 16;
  // sys/mman.h: no swap space reserved for a mapping
  MAP_NORESERVE: int32 = 0x4000;
  // The signals the fault handler takes, in GFaultBefore's order
  ADAM_PLATFORM_FAULT_SIGNALS: array[0..3] of int32 = [11, 7, 8, 4];
  ADAM_PLATFORM_FAULT_SIGNAL_COUNT: int64 = 4;
  // gregs' index of each register by its unwind number (PlatformRegisters' order: rax rcx
  // rdx rbx rsp rbp rsi rdi r8 .. r15 are REG_RAX 13, REG_RCX 14, REG_RDX 12, REG_RBX 11,
  // REG_RSP 15, REG_RBP 10, REG_RSI 9, REG_RDI 8, REG_R8 .. REG_R15 0 .. 7)
  ADAM_PLATFORM_GREG_OF: array[0..15] of int64 = [13, 14, 12, 11, 15, 10, 9, 8, 0, 1, 2, 3,
    4, 5, 6, 7];
  // Byte offsets: siginfo_t's si_code and si_addr, ucontext_t's uc_mcontext.gregs
  ADAM_PLATFORM_SI_CODE: uint64 = 8;
  ADAM_PLATFORM_SI_ADDR: uint64 = 16;
  ADAM_PLATFORM_UC_GREGS: uint64 = 40;
  // A thread's alternate signal stack: the handler runs there, and so does the dispatch of
  // a stack overflow (DoFaultSignal: its frames' finally parts with it); virtual memory only
  // until it is touched (MAP_NORESERVE), a guard page below it
  ADAM_PLATFORM_SIGNAL_STACK: uint64 = 262144;
  // The x86_64 ABI's red zone below a frame's rsp, which a leaf may use: the dispatch's
  // frames start below it
  ADAM_PLATFORM_RED_ZONE: uint64 = 128;
  // The stack a fault's dispatch needs left on the faulting stack, or it runs on the
  // alternate signal stack
  ADAM_PLATFORM_FAULT_ROOM: uint64 = 65536;
  // How far below a stack's low end an access fault still counts as running off its end
  // (a stack overflow): the kernel's guard gap below a main thread's stack (256 pages)
  ADAM_PLATFORM_STACK_GAP: uint64 = 1048576;

var
  // True once the fault handler is installed (PlatformAtFault), with the page size it uses
  // and the actions it replaced, by ADAM_PLATFORM_FAULT_SIGNALS' order (put back for a
  // signal that is no fault: DoFaultPassOn)
  GFaultReady: bool;
  GFaultPage: uint64;
  GFaultBefore: array[0..3] of PlatformSigaction;

threadstatic
  // This thread's alternate signal stack (DoFaultThreadReady: GSignalMap the whole
  // mapping, a guard page at its low end; nil when it has none) and the bounds it runs in;
  // the thread's own stack's low end (0: unknown, no fault counts as a stack overflow)
  GSignalMap: ptr;
  GSignalLow: uint64;
  GSignalHigh: uint64;
  GStackLow: uint64;

// The calling thread's fault state made ready (its start's, DoThreadProc; the main
// thread's at PlatformAtFault): its stack's low end kept, its alternate signal stack mapped
// and given to the kernel, so a fault is handled even with the thread's stack spent; once
func DoFaultThreadReady();
var
  LLow: uint64;
  LHigh: uint64;
  LMap: ptr;
  LStack: stack_t;
begin
  if (not GFaultReady) or (GSignalMap <> nil) then
    return;
  end;
  LLow := 0;
  LHigh := 0;
  if DoThreadStack(LLow, LHigh) then
    GStackLow := LLow;
  end;
  LMap := mmap(nil, ADAM_PLATFORM_SIGNAL_STACK + GFaultPage, PROT_READ | PROT_WRITE,
    MAP_PRIVATE | MAP_ANONYMOUS | MAP_STACK | MAP_NORESERVE, -1, 0);
  if uint64(LMap) = ADAM_PLATFORM_MAP_FAILED then
    return;
  end;
  if mprotect(LMap, GFaultPage, PROT_NONE) <> 0 then
    munmap(LMap, ADAM_PLATFORM_SIGNAL_STACK + GFaultPage);
    return;
  end;
  LStack.ss_sp := ptr(uint64(LMap) + GFaultPage);
  LStack.ss_flags := 0;
  LStack.pad0 := 0;
  LStack.ss_size := ADAM_PLATFORM_SIGNAL_STACK;
  if sigaltstack(ptr(addr of LStack), nil) <> 0 then
    munmap(LMap, ADAM_PLATFORM_SIGNAL_STACK + GFaultPage);
    return;
  end;
  GSignalMap := LMap;
  GSignalLow := uint64(LMap) + GFaultPage;
  GSignalHigh := GSignalLow + ADAM_PLATFORM_SIGNAL_STACK;
end;

// The calling thread's fault state given back as it ends (PlatformThreadCallback): its
// alternate signal stack taken from the kernel, then unmapped
func DoFaultThreadEnd();
var
  LStack: stack_t;
begin
  if GSignalMap = nil then
    return;
  end;
  LStack.ss_sp := nil;
  LStack.ss_flags := SS_DISABLE;
  LStack.pad0 := 0;
  LStack.ss_size := 0;
  sigaltstack(ptr(addr of LStack), nil);
  munmap(GSignalMap, ADAM_PLATFORM_SIGNAL_STACK + GFaultPage);
  GSignalMap := nil;
  GSignalLow := 0;
  GSignalHigh := 0;
end;

// The low end of the stack the faulting code ran on: a coroutine's own (PlatformCoroutineNew's,
// above its guard page), else the thread's (GStackLow); 0 when unknown
func DoFaultStackLow(): uint64;
begin
  if (GCoroutineCurrent <> nil) and (GCoroutineCurrent^.Map <> nil) then
    return GCoroutineCurrent^.StackLow;
  end;
  return GStackLow;
end;

// True when an access fault at AAddress with the stack pointer at ARsp ran off the stack's
// end: rsp below the stack's first page, or the address in that page or the guard gap
// below it (ADAM_PLATFORM_STACK_GAP)
func DoIsStackFault(const AAddress: uint64; const ARsp: uint64): bool;
var
  LLow: uint64;
begin
  LLow := DoFaultStackLow();
  if LLow = 0 then
    return false;
  end;
  if ARsp < LLow + GFaultPage then
    return true;
  end;
  return (AAddress < LLow + GFaultPage) and (AAddress + ADAM_PLATFORM_STACK_GAP >= LLow);
end;

// The value of the general register ANumber (an unwind number, 0 .. 15) of ARegs, as the
// operand an instruction names (its width masked by the caller), AHighByte: ah / ch / dh /
// bh (a byte operand 4 .. 7 with no REX prefix: bits 8 .. 15 of rax .. rbx)
func DoRegisterOperand(const ARegs: PlatformRegisters; const ANumber: uint64;
  const AHighByte: bool): uint64;
begin
  if AHighByte then
    return (ARegs.Regs[ANumber - 4] shr 8) & 0xFF;
  end;
  return ARegs.Regs[ANumber];
end;

// True when AByte is an instruction prefix the divisor's decode passes over (lock, rep,
// the segment overrides that add nothing in 64-bit mode); the operand size and address size
// prefixes are read by the decode itself
func DoIsPassedPrefix(const AByte: uint64): bool;
begin
  return (AByte = 0xF0) or (AByte = 0xF2) or (AByte = 0xF3) or (AByte = 0x2E) or
    (AByte = 0x36) or (AByte = 0x3E) or (AByte = 0x26);
end;

// The signed value of the AWidth-byte (1 or 4) displacement at AAddress
func DoDisplacement(const AAddress: uint64; const AWidth: uint64): uint64;
var
  LValue: uint64;
begin
  if AWidth = 1 then
    LValue := DoByteAt(AAddress);
    if LValue >= 0x80 then
      return LValue | 0xFFFFFFFFFFFFFF00;
    end;
    return LValue;
  end;
  LValue := DoLongAt(AAddress);
  if LValue >= 0x80000000 then
    return LValue | 0xFFFFFFFF00000000;
  end;
  return LValue;
end;

// True when the integer divide that faulted at ARegs.Pc (a SIGFPE FPE_INTDIV: x86's #DE,
// which the kernel gives for a zero divisor and for a quotient past its width alike) has a
// zero divisor: its div / idiv (F6 / F7 /6, /7) decoded, the divisor read from its
// register or memory operand (prefixes, REX, ModRM, SIB, disp8 / disp32, rip-relative).
// An fs / gs operand or an instruction that is no divide counts as a zero divisor (the
// kernel's own reading of #DE)
func DoDivisorZero(const ARegs: PlatformRegisters): bool;
var
  LAt: uint64;
  LByte: uint64;
  LRex: uint64;
  LOperand16: bool;
  LAddress32: bool;
  LWidth: uint64;
  LModrm: uint64;
  LMod: uint64;
  LRm: uint64;
  LSib: uint64;
  LIndex: uint64;
  LBase: uint64;
  LAddress: uint64;
  LDisplacement: uint64;
  LValue: uint64;
begin
  LAt := ARegs.Pc;
  LOperand16 := false;
  LAddress32 := false;
  LByte := DoByteAt(LAt);
  while DoIsPassedPrefix(LByte) or (LByte = 0x66) or (LByte = 0x67) or (LByte = 0x64) or
    (LByte = 0x65) do
    if (LByte = 0x64) or (LByte = 0x65) then
      return true;
    end;
    if LByte = 0x66 then
      LOperand16 := true;
    end;
    if LByte = 0x67 then
      LAddress32 := true;
    end;
    LAt := LAt + 1;
    LByte := DoByteAt(LAt);
  end;
  LRex := 0;
  if (LByte & 0xF0) = 0x40 then
    LRex := LByte;
    LAt := LAt + 1;
    LByte := DoByteAt(LAt);
  end;
  if (LByte <> 0xF6) and (LByte <> 0xF7) then
    return true;
  end;
  // the operand's width: F6 a byte, F7 by REX.W / the operand size prefix
  LWidth := 4;
  if LByte = 0xF6 then
    LWidth := 1;
  end;
  if (LByte = 0xF7) and LOperand16 then
    LWidth := 2;
  end;
  if (LByte = 0xF7) and ((LRex & 8) <> 0) then
    LWidth := 8;
  end;
  LModrm := DoByteAt(LAt + 1);
  LAt := LAt + 2;
  LMod := LModrm shr 6;
  LRm := LModrm & 7;
  if LMod = 3 then
    // a register divisor (REX.B extends it; a byte one with no REX: ah .. bh for 4 .. 7)
    LValue := DoRegisterOperand(ARegs, LRm + ((LRex & 1) shl 3),
      (LWidth = 1) and (LRex = 0) and (LRm >= 4));
  else
    // a memory divisor: base + index * scale + displacement, or rip-relative
    LAddress := 0;
    LDisplacement := 0;
    if LRm = 4 then
      LSib := DoByteAt(LAt);
      LAt := LAt + 1;
      LIndex := ((LSib shr 3) & 7) + (((LRex shr 1) & 1) shl 3);
      LBase := (LSib & 7) + ((LRex & 1) shl 3);
      // index 4 with no REX.X is none
      if LIndex <> 4 then
        LAddress := ARegs.Regs[LIndex] shl (LSib shr 6);
      end;
      if ((LSib & 7) = 5) and (LMod = 0) then
        // no base: a disp32 alone
        LDisplacement := DoDisplacement(LAt, 4);
        LAt := LAt + 4;
      else
        LAddress := LAddress + ARegs.Regs[LBase];
      end;
    else
      if (LRm = 5) and (LMod = 0) then
        // rip-relative: the next instruction's address (a div has no immediate) + disp32
        LDisplacement := DoDisplacement(LAt, 4);
        LAt := LAt + 4;
        LAddress := LAt;
      else
        LAddress := ARegs.Regs[LRm + ((LRex & 1) shl 3)];
      end;
    end;
    if LMod = 1 then
      LDisplacement := DoDisplacement(LAt, 1);
    end;
    if LMod = 2 then
      LDisplacement := DoDisplacement(LAt, 4);
    end;
    LAddress := LAddress + LDisplacement;
    if LAddress32 then
      LAddress := LAddress & 0xFFFFFFFF;
    end;
    // the divide read its operand before it faulted: the memory is there
    LValue := DoWordAt(LAddress);
  end;
  if LWidth = 1 then
    LValue := LValue & 0xFF;
  end;
  if LWidth = 2 then
    LValue := LValue & 0xFFFF;
  end;
  if LWidth = 4 then
    LValue := LValue & 0xFFFFFFFF;
  end;
  return LValue = 0;
end;

// The hardware fault kind (ADAM_PLATFORM_FAULT_*) of the signal ASignal with siginfo_t's
// si_code ACode and si_addr AAddress, the faulting frame's registers ARegs (System.Runtime.Win64's
// DoFaultKind's kinds for the same faults)
func DoSignalKind(const ASignal: int32; const ACode: int32; const AAddress: uint64;
  const ARegs: PlatformRegisters): int32;
begin
  if ASignal = SIGSEGV then
    if DoIsStackFault(AAddress, ARegs.Regs[ADAM_PLATFORM_UNWIND_RSP]) then
      return ADAM_PLATFORM_FAULT_STACK;
    end;
    return ADAM_PLATFORM_FAULT_ACCESS;
  end;
  if ASignal = SIGBUS then
    return ADAM_PLATFORM_FAULT_BUS;
  end;
  if ASignal = SIGILL then
    return ADAM_PLATFORM_FAULT_INSTRUCTION;
  end;
  if ACode = FPE_INTDIV then
    if DoDivisorZero(ARegs) then
      return ADAM_PLATFORM_FAULT_DIVIDE;
    end;
    return ADAM_PLATFORM_FAULT_OVERFLOW;
  end;
  if ACode = FPE_FLTDIV then
    return ADAM_PLATFORM_FAULT_DIVIDE;
  end;
  if (ACode = FPE_INTOVF) or (ACode = FPE_FLTOVF) or (ACode = FPE_FLTUND) then
    return ADAM_PLATFORM_FAULT_OVERFLOW;
  end;
  return ADAM_PLATFORM_FAULT_OTHER;
end;

// A fault's dispatch, where the signal handler (DoFaultSignal) returned to (the signal's
// mask given back by the kernel's sigreturn), on the faulting stack below the faulting
// frame or on the alternate signal stack: the frames from the faulting one are searched and
// unwound to the guard that takes it (DoTryDispatch, never returning); none takes it: the
// fault handler (PlatformAtFault) reports it with nothing unwound and ends the process
func DoFaultRaise();
var
  LStart: PlatformRegisters;
  LKind: int32;
  LHandler: func(const AKind: int32);
begin
  LStart := GFaultStart;
  LKind := GFaultKind;
  DoTryDispatch(LStart, ADAM_PLATFORM_FAULT_CODE, LKind, true);
  LHandler := GFaultHandler;
  if ptr(LHandler) <> nil then
    LHandler(LKind);
  end;
  DoNoCatch(ptr to const char("a hardware fault no guard takes"));
end;

// A signal of ADAM_PLATFORM_FAULT_SIGNALS that is no hardware fault (sent by kill /
// tgkill / sigqueue: si_code 0 or below): the action the fault handler replaced is put back
// and the signal sent to this thread again, pending until the handler returns (the signal
// is blocked in it), then taken as it would have been
func DoFaultPassOn(const ASignal: int32);
var
  LI: int64;
begin
  for LI := 0 to ADAM_PLATFORM_FAULT_SIGNAL_COUNT - 1 do
    if ADAM_PLATFORM_FAULT_SIGNALS[LI] = ASignal then
      sigaction(ASignal, ptr(addr of GFaultBefore[LI]), nil);
    end;
  end;
  pthread_kill(pthread_self(), ASignal);
end;

// The fault handler (SA_SIGINFO | SA_ONSTACK: on the thread's alternate signal stack): the
// faulting frame's registers (the ucontext's gregs) and the fault's kind kept for its
// dispatch (GFaultStart, GFaultKind), then the ucontext's rip set to DoFaultRaise and its
// rsp below the faulting frame (past the red zone), or at the alternate signal stack's top
// for a stack overflow or a stack with too little left (not when the fault ran on the
// alternate stack already: a fault in an overflow's dispatch goes on below it); a nil
// return address above, the walk's start being the kept registers. The dispatch then runs
// as ordinary code once the handler returns, so no handler frame lies between it and the
// faulting frame. A fault while a dispatch searches (the unwinder's own) is reported at
// once, as one no guard took
func DoFaultSignal(ASignal: int32; AInfo: ptr; AContext: ptr);
var
  LCode: int32;
  LAddress: uint64;
  LGregs: ptr to uint64;
  LKind: int32;
  LRsp: uint64;
  LTop: uint64;
  LLow: uint64;
  LOnSignalStack: bool;
  LHandler: func(const AKind: int32);
  LRaise: func();
  LSlot: ptr to uint64;
  LI: int64;
begin
  LCode := (ptr to int32(uint64(AInfo) + ADAM_PLATFORM_SI_CODE))^;
  if LCode <= 0 then
    DoFaultPassOn(ASignal);
    return;
  end;
  LAddress := (ptr to uint64(uint64(AInfo) + ADAM_PLATFORM_SI_ADDR))^;
  LGregs := ptr to uint64(uint64(AContext) + ADAM_PLATFORM_UC_GREGS);
  for LI := 0 to 15 do
    GFaultStart.Regs[LI] := LGregs[ADAM_PLATFORM_GREG_OF[LI]];
  end;
  GFaultStart.Pc := LGregs[REG_RIP];
  LKind := DoSignalKind(ASignal, LCode, LAddress, GFaultStart);
  if GFaultSearching then
    LHandler := GFaultHandler;
    LHandler(LKind);
  end;
  GFaultKind := LKind;
  LRsp := GFaultStart.Regs[ADAM_PLATFORM_UNWIND_RSP];
  LOnSignalStack := (LRsp >= GSignalLow) and (LRsp < GSignalHigh);
  LTop := LRsp - ADAM_PLATFORM_RED_ZONE;
  if (GSignalMap <> nil) and not LOnSignalStack then
    LLow := DoFaultStackLow();
    if (LKind = ADAM_PLATFORM_FAULT_STACK) or
      ((LLow <> 0) and (LTop < LLow + ADAM_PLATFORM_FAULT_ROOM)) then
      LTop := GSignalHigh;
    end;
  end;
  // as at a function's entry: rsp 8 past a 16-byte boundary, the return address slot
  LTop := (LTop & 0xFFFFFFFFFFFFFFF0) - 8;
  LSlot := ptr to uint64(LTop);
  LSlot[0] := 0;
  LRaise := DoFaultRaise;
  LGregs[REG_RSP] := LTop;
  LGregs[REG_RIP] := uint64(ptr(LRaise));
end;

// AHandler called with the fault kind (ADAM_PLATFORM_FAULT_*) of a hardware fault no guard
// took, on the faulting thread with nothing unwound (DoFaultRaise); it reports the fault and
// ends the process, never returning. The fault handler (DoFaultSignal) installed for SIGSEGV,
// SIGBUS, SIGFPE and SIGILL and the main thread's fault state made ready (a thread
// PlatformThreadStart makes gets its own at its start)
public func PlatformAtFault(const AHandler: func(const AKind: int32));
var
  LAction: PlatformSigaction;
  LSignal: PlatformSignalHandler;
  LI: int64;
begin
  GFaultHandler := AHandler;
  if GFaultReady then
    return;
  end;
  GFaultPage := ADAM_PLATFORM_PAGE_DEFAULT;
  if sysconf(_SC_PAGESIZE) > 0 then
    GFaultPage := uint64(sysconf(_SC_PAGESIZE));
  end;
  GFaultReady := true;
  DoFaultThreadReady();
  memset(ptr(addr of LAction), 0, uint64(size(PlatformSigaction)));
  LSignal := DoFaultSignal;
  LAction.sa_sigaction := ptr(LSignal);
  LAction.sa_flags := SA_SIGINFO | SA_ONSTACK;
  for LI := 0 to ADAM_PLATFORM_FAULT_SIGNAL_COUNT - 1 do
    sigaction(ADAM_PLATFORM_FAULT_SIGNALS[LI], ptr(addr of LAction),
      ptr(addr of GFaultBefore[LI]));
  end;
end;

// ASize bytes of zeroed memory that may be written and run (System.Runtime's C callback
// thunks, CB1: ThunkNew), kept for the process's life; nil when the OS refused
public func PlatformExecAlloc(const ASize: int64): ptr;
var
  LMap: ptr;
begin
  LMap := mmap(nil, uint64(ASize), PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS,
    -1, 0);
  if uint64(LMap) = ADAM_PLATFORM_MAP_FAILED then
    return nil;
  end;
  return LMap;
end;

// The processors online (a for parallel's workers when it gives no count, T2); at least 1
public func PlatformCPUCount(): int64;
var
  LCount: int64;
begin
  LCount := sysconf(_SC_NPROCESSORS_ONLN);
  if LCount < 1 then
    return 1;
  end;
  return LCount;
end;

// The calling thread sleeps for AMilliseconds (a signal that wakes it early: the rest
// slept again)
public func PlatformSleep(const AMilliseconds: uint32);
var
  LWant: timespec;
  LLeft: timespec;
begin
  LWant.tv_sec := int64(AMilliseconds div 1000);
  LWant.tv_nsec := int64(AMilliseconds mod 1000) * 1000000;
  while nanosleep(addr of LWant, addr of LLeft) <> 0 do
    if DoErrno() <> EINTR then
      return;
    end;
    LWant := LLeft;
  end;
end;

// A lock's size in bytes (System.Runtime's LockCreate takes that many from the heap)
public func PlatformLockSize(): int64;
begin
  return ADAM_PLATFORM_LOCK_SIZE;
end;

// The lock at ALock (PlatformLockSize bytes) made free: a default (normal) mutex
public func PlatformLockInit(const ALock: ptr);
begin
  pthread_mutex_init(ALock, nil);
end;

// Waits until the lock at ALock is free, then holds it (exclusively)
public func PlatformLockEnter(const ALock: ptr);
begin
  pthread_mutex_lock(ALock);
end;

// Lets go of the lock at ALock, which the calling thread holds
public func PlatformLockLeave(const ALock: ptr);
begin
  pthread_mutex_unlock(ALock);
end;

// The lock at ALock no longer used (no thread holds it or waits for it)
public func PlatformLockDone(const ALock: ptr);
begin
  pthread_mutex_destroy(ALock);
end;

const
  // sys/syscall.h (x86_64): the futex call; linux/futex.h's FUTEX_WAIT / FUTEX_WAKE with
  // FUTEX_PRIVATE_FLAG (the word is this process's own)
  SYS_futex: int64 = 202;
  FUTEX_WAIT_PRIVATE: int64 = 128;
  FUTEX_WAKE_PRIVATE: int64 = 129;
  // Nanoseconds per millisecond and per second (a futex wait's relative timespec)
  ADAM_PLATFORM_NS_PER_MS: int64 = 1000000;
  ADAM_PLATFORM_MS_PER_SECOND: int64 = 1000;

// Sleeps while the int32 at AWord holds AExpected (futex FUTEX_WAIT: the kernel compares
// and sleeps in one step, so a wake between the caller's read and this sleep is never
// lost), up to AMilliseconds (negative: no end); back early on a wake, a signal or the word
// already changed, so the caller reads the word again (as win64's RtlWaitOnAddress)
public func PlatformWaitWord(const AWord: ptr; const AExpected: int32;
  const AMilliseconds: int64);
var
  LTimeout: timespec;
begin
  if AMilliseconds < 0 then
    syscall(SYS_futex, AWord, FUTEX_WAIT_PRIVATE, int64(AExpected), nil, nil, int64(0));
    return;
  end;
  // Relative to now (FUTEX_WAIT's timeout is a duration)
  LTimeout.tv_sec := AMilliseconds div ADAM_PLATFORM_MS_PER_SECOND;
  LTimeout.tv_nsec := (AMilliseconds mod ADAM_PLATFORM_MS_PER_SECOND) * ADAM_PLATFORM_NS_PER_MS;
  syscall(SYS_futex, AWord, FUTEX_WAIT_PRIVATE, int64(AExpected), addr of LTimeout, nil,
    int64(0));
end;

// Wakes one thread sleeping on the word at AWord (PlatformWaitWord), if one is (futex
// FUTEX_WAKE of 1)
public func PlatformWakeWord(const AWord: ptr);
begin
  syscall(SYS_futex, AWord, FUTEX_WAKE_PRIVATE, int64(1), nil, nil, int64(0));
end;

// Milliseconds since a fixed point (CLOCK_MONOTONIC), never going back: only a difference
// of two means anything
public func PlatformMilliseconds(): int64;
var
  LNow: timespec;
begin
  LNow.tv_sec := 0;
  LNow.tv_nsec := 0;
  clock_gettime(CLOCK_MONOTONIC, LNow);
  return LNow.tv_sec * 1000 + LNow.tv_nsec div 1000000;
end;

// The ACount (1 .. 17) leading decimal digits of AValue's magnitude (finite, not 0),
// correctly rounded, written to ADigits (ASize bytes, at least ACount + 1), and the place of
// the decimal point: the magnitude is 0.D1D2.. times ten to the ADecimalPoint. False when
// the C runtime refused (glibc's ecvt_r)
public func PlatformFloatDigits(const AValue: float64; const ACount: int32;
  const ADigits: ptr to char; const ASize: int64; var ADecimalPoint: int32): bool;
var
  LDecimal: int32;
  LSign: int32;
begin
  LDecimal := 0;
  LSign := 0;
  if ecvt_r(AValue, ACount, LDecimal, LSign, ADigits, uint64(ASize)) <> 0 then
    return false;
  end;
  ADecimalPoint := LDecimal;
  return true;
end;

// The decimal text AText (C's strtod form, NUL-terminated) as the nearest float64
public func PlatformParseFloat64(const AText: ptr to const char): float64;
begin
  return strtod(AText, nil);
end;

// The decimal text AText (C's strtof form, NUL-terminated) as the nearest float32 (read
// straight to float32: through a float64 it would round twice)
public func PlatformParseFloat32(const AText: ptr to const char): float32;
begin
  return strtof(AText, nil);
end;

// The file descriptor of the handle AHandle (this unit's handles are a descriptor + 1: 0
// is no handle, as on every target)
func DoFileOf(const AHandle: uint64): int32;
begin
  return int32(AHandle) - 1;
end;

// The handle of the open descriptor AFile (0 .. : never 0)
func DoHandleOf(const AFile: int32): uint64;
begin
  return uint64(AFile) + 1;
end;

// Opens the NUL-terminated path APath with AFlags (O_CLOEXEC added: no program this one
// starts inherits it), a created file's mode ADAM_PLATFORM_CREATE_MODE: its descriptor,
// -1 when it is not opened (a call a signal broke off made again) or is a folder (closed
// again: a file handle never names one, as on win64)
func DoOpen(const APath: ptr to const char; const AFlags: int32): int32;
var
  LFile: int32;
  LStat: PlatformStat;
begin
  LFile := open(APath, AFlags | O_CLOEXEC, ADAM_PLATFORM_CREATE_MODE);
  while (LFile < 0) and (DoErrno() = EINTR) do
    LFile := open(APath, AFlags | O_CLOEXEC, ADAM_PLATFORM_CREATE_MODE);
  end;
  if LFile < 0 then
    return -1;
  end;
  if PlatformCFstat(LFile, LStat) <> 0 then
    close(LFile);
    return -1;
  end;
  if (LStat.st_mode & S_IFMT) = S_IFDIR then
    close(LFile);
    return -1;
  end;
  return LFile;
end;

// The whole file at the NUL-terminated path APath read into a new block from the C heap
// (a NUL after its bytes; the caller frees it), its byte count into ASize; nil when it
// cannot be read. For /proc files, whose size reads as 0: read until the end, the room
// doubled while it fills
func DoReadWhole(const APath: ptr to const char; var ASize: int64): ptr to char;
var
  LFile: int32;
  LText: ptr to char;
  LMore: ptr to char;
  LRoom: int64;
  LGot: int64;
begin
  ASize := 0;
  LFile := DoOpen(APath, O_RDONLY);
  if LFile < 0 then
    return nil;
  end;
  LRoom := ADAM_PLATFORM_CMDLINE_START;
  LText := ptr to char(malloc(uint64(LRoom) + 1));
  if LText = nil then
    close(LFile);
    return nil;
  end;
  while true do
    if ASize = LRoom then
      LMore := ptr to char(realloc(ptr(LText), uint64(LRoom * 2) + 1));
      if LMore = nil then
        free(ptr(LText));
        close(LFile);
        return nil;
      end;
      LText := LMore;
      LRoom := LRoom * 2;
    end;
    LGot := read(LFile, ptr(addr of LText[ASize]), uint64(LRoom - ASize));
    if LGot < 0 then
      if DoErrno() <> EINTR then
        free(ptr(LText));
        close(LFile);
        return nil;
      end;
    else
      if LGot = 0 then
        leave;
      end;
      ASize := ASize + LGot;
    end;
  end;
  close(LFile);
  LText[ASize] := '\0';
  return LText;
end;

// The process's arguments read, the first time they are asked for: the kernel's argv
// (/proc/self/cmdline: each argument with a NUL after it), whatever started the program
// and whether it is an exe or a .so; no arguments read (the file unreadable) is one empty
// argument 0, as a program always has its own name
func DoReadyArguments();
var
  LText: ptr to char;
  LSize: int64;
  LCount: int64;
  LAt: int64;
  LIndex: int64;
begin
  // Taken on every ask: two threads asking first at once would read the arguments twice
  pthread_mutex_lock(ptr(addr of GArgumentsLock));
  if not GArgumentsReady then
    LText := DoReadWhole(ptr to const char(ADAM_PLATFORM_CMDLINE), LSize);
    if (LText = nil) or (LSize = 0) then
      free(ptr(LText));
      // Room for the NUL DoReadWhole puts after the bytes, as it does
      LText := ptr to char(malloc(2));
      if LText = nil then
        pthread_mutex_unlock(ptr(addr of GArgumentsLock));
        return;
      end;
      LText[0] := '\0';
      LText[1] := '\0';
      LSize := 1;
    end;
    // A last argument with no NUL after it (never from the kernel) ends at the NUL
    // DoReadWhole put after the bytes
    if LText[LSize - 1] <> '\0' then
      LSize := LSize + 1;
    end;
    LCount := 0;
    LAt := 0;
    while LAt < LSize do
      if LText[LAt] = '\0' then
        LCount := LCount + 1;
      end;
      LAt := LAt + 1;
    end;
    GArguments := ptr to ptr to const char(malloc(uint64(LCount) * 8));
    LIndex := 0;
    LAt := 0;
    while LIndex < LCount do
      GArguments[LIndex] := ptr to const char(addr of LText[LAt]);
      while LText[LAt] <> '\0' do
        LAt := LAt + 1;
      end;
      LAt := LAt + 1;
      LIndex := LIndex + 1;
    end;
    GArgumentText := LText;
    GArgumentCount := int32(LCount);
    GArgumentsReady := true;
  end;
  pthread_mutex_unlock(ptr(addr of GArgumentsLock));
end;

// The number of the process's arguments, its own name included (C's argc)
public func PlatformArgCount(): int32;
begin
  DoReadyArguments();
  return GArgumentCount;
end;

// The process's argument AIndex (0 its own name, C's argv[AIndex]): its NUL-terminated
// bytes, this unit's own (never freed); AIndex is in 0 .. PlatformArgCount() - 1
public func PlatformArg(const AIndex: int32): ptr to const char;
begin
  DoReadyArguments();
  return GArguments[int64(AIndex)];
end;

// Opens the file at the NUL-terminated UTF-8 path APath for reading (relative to the working
// folder); AHandle is its handle for PlatformReadFile / PlatformCloseFile. False (AHandle 0)
// when it cannot be opened (missing, a folder, no access)
public func PlatformOpenFile(const APath: ptr to const char; var AHandle: uint64): bool;
var
  LFile: int32;
begin
  AHandle := 0;
  LFile := DoOpen(APath, O_RDONLY);
  if LFile < 0 then
    return false;
  end;
  AHandle := DoHandleOf(LFile);
  return true;
end;

// Up to ACount bytes (ACount above 0) of the file AHandle (PlatformOpenFile's) read into
// ABuffer at its current place: the bytes read, 0 at its end, -1 when the read fails
public func PlatformReadFile(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): int64;
var
  LWant: int64;
  LGot: int64;
begin
  LWant := ACount;
  if LWant > ADAM_PLATFORM_READ_CHUNK then
    LWant := ADAM_PLATFORM_READ_CHUNK;
  end;
  LGot := read(DoFileOf(AHandle), ABuffer, uint64(LWant));
  while (LGot < 0) and (DoErrno() = EINTR) do
    LGot := read(DoFileOf(AHandle), ABuffer, uint64(LWant));
  end;
  if LGot < 0 then
    return -1;
  end;
  return LGot;
end;

// Closes the file AHandle (PlatformOpenFile's or PlatformOpenFileMode's)
public func PlatformCloseFile(const AHandle: uint64);
begin
  close(DoFileOf(AHandle));
end;

// open's flags for System.Runtime's file mode AMode (read: it must exist; write: created or
// emptied; read write: it must exist, kept; append: created when missing, kept, at place 0
// as on win64: the runtime moves to its end); false for a value that is no mode
func DoModeFlags(const AMode: int32; var AFlags: int32): bool;
begin
  if AMode = ADAM_PLATFORM_MODE_READ then
    AFlags := O_RDONLY;
    return true;
  end;
  if AMode = ADAM_PLATFORM_MODE_WRITE then
    AFlags := O_WRONLY | O_CREAT | O_TRUNC;
    return true;
  end;
  if AMode = ADAM_PLATFORM_MODE_READ_WRITE then
    AFlags := O_RDWR;
    return true;
  end;
  if AMode = ADAM_PLATFORM_MODE_APPEND then
    AFlags := O_WRONLY | O_CREAT;
    return true;
  end;
  return false;
end;

// Opens the file at the NUL-terminated UTF-8 path APath (relative to the working folder) in
// System.Runtime's file mode AMode; AHandle is its handle, at place 0. False (AHandle 0)
// when it cannot be opened so (missing for read / read write, a folder, no access, no mode)
public func PlatformOpenFileMode(const APath: ptr to const char; const AMode: int32;
  var AHandle: uint64): bool;
var
  LFlags: int32;
  LFile: int32;
begin
  AHandle := 0;
  LFlags := 0;
  if not DoModeFlags(AMode, LFlags) then
    return false;
  end;
  LFile := DoOpen(APath, LFlags);
  if LFile < 0 then
    return false;
  end;
  AHandle := DoHandleOf(LFile);
  return true;
end;

// Up to ACount bytes (ACount above 0) of ABuffer written to the file AHandle at its place
// (past its end: the gap reads as zeros): the bytes written, -1 when the write fails
public func PlatformWriteFile(const AHandle: uint64; const ABuffer: ptr to const;
  const ACount: int64): int64;
var
  LWant: int64;
  LPut: int64;
begin
  LWant := ACount;
  if LWant > ADAM_PLATFORM_READ_CHUNK then
    LWant := ADAM_PLATFORM_READ_CHUNK;
  end;
  LPut := write(DoFileOf(AHandle), ABuffer, uint64(LWant));
  while (LPut < 0) and (DoErrno() = EINTR) do
    LPut := write(DoFileOf(AHandle), ABuffer, uint64(LWant));
  end;
  if LPut < 0 then
    return -1;
  end;
  return LPut;
end;

// Moves the place of the file AHandle to AOffset from AOrigin (ADAM_PLATFORM_SEEK_*: the
// start, the place, the end): the new place, -1 when it cannot move there (before the
// start); past the end is a place
public func PlatformSeekFile(const AHandle: uint64; const AOffset: int64; const AOrigin: int32): int64;
begin
  if (AOrigin < ADAM_PLATFORM_SEEK_START) or (AOrigin > ADAM_PLATFORM_SEEK_END) then
    return -1;
  end;
  return lseek(DoFileOf(AHandle), AOffset, AOrigin);
end;

// The size in bytes of the file AHandle, -1 when it cannot be read
public func PlatformFileSize(const AHandle: uint64): int64;
var
  LStat: PlatformStat;
begin
  if PlatformCFstat(DoFileOf(AHandle), LStat) <> 0 then
    return -1;
  end;
  return LStat.st_size;
end;

// Sets the size of the file AHandle (open for writing) to ASize bytes: shorter drops the
// tail, longer reads as zeros; its place is kept (it may then lie past the end). False when
// it cannot be set
public func PlatformTruncateFile(const AHandle: uint64; const ASize: int64): bool;
begin
  if ASize < 0 then
    return false;
  end;
  return ftruncate(DoFileOf(AHandle), ASize) = 0;
end;

// What is at the NUL-terminated UTF-8 path APath (relative to the working folder), a link
// followed to its target (stat): ADAM_PLATFORM_PATH_FILE (ASize its size in bytes),
// ADAM_PLATFORM_PATH_FOLDER, or ADAM_PLATFORM_PATH_NONE (nothing there, a link whose target
// is gone, or one the OS refuses to read); ASize is 0 but for a file
public func PlatformPathKind(const APath: ptr to const char; var ASize: int64): int32;
var
  LStat: PlatformStat;
begin
  ASize := 0;
  if PlatformCStat(APath, LStat) <> 0 then
    return ADAM_PLATFORM_PATH_NONE;
  end;
  if (LStat.st_mode & S_IFMT) = S_IFDIR then
    return ADAM_PLATFORM_PATH_FOLDER;
  end;
  ASize := LStat.st_size;
  return ADAM_PLATFORM_PATH_FILE;
end;

// True when the NUL-terminated UTF-8 path APath (relative to the working folder) is itself a
// symbolic link, read without following it (lstat). False for anything else, nothing there,
// or a path that cannot be read
public func PlatformPathIsLink(const APath: ptr to const char): bool;
var
  LStat: PlatformStat;
begin
  if PlatformCLstat(APath, LStat) <> 0 then
    return false;
  end;
  return (LStat.st_mode & S_IFMT) = S_IFLNK;
end;

// Deletes the file at the NUL-terminated UTF-8 path APath (relative to the working folder);
// false when it is not deleted (missing, a folder, no access to its folder)
public func PlatformRemoveFile(const APath: ptr to const char): bool;
begin
  return unlink(APath) = 0;
end;

// True when the NUL-terminated entry name AName is "." or ".." (the folder itself, its
// parent)
func DoIsDotName(const AName: ptr to const char): bool;
begin
  if AName[0] <> '.' then
    return false;
  end;
  if AName[1] = '\0' then
    return true;
  end;
  return (AName[1] = '.') and (AName[2] = '\0');
end;

// Every name in the folder at the NUL-terminated UTF-8 path APath (relative to the working
// folder; "." and ".." left out), in the OS's order, with a NUL after each: the bytes they
// take, their NULs counted (0 for an empty folder), written into AText while they fit in
// its ASize bytes (AText nil: only counted), so AText holds them all when the result is at
// most ASize. -1 when APath is no folder that can be listed (missing, a file, no access) or
// the listing fails part way
public func PlatformListFolder(const APath: ptr to const char; const AText: ptr to char;
  const ASize: int64): int64;
var
  LFolder: ptr;
  LEntry: ptr to dirent;
  LName: ptr to const char;
  LTotal: int64;
  LBytes: int64;
  LOk: bool;
begin
  LFolder := opendir(APath);
  if LFolder = nil then
    return -1;
  end;
  LTotal := 0;
  LOk := true;
  while true do
    // readdir's nil is the end with errno unchanged, a failure with it set
    DoSetErrno(0);
    LEntry := readdir(LFolder);
    if LEntry = nil then
      LOk := DoErrno() = 0;
      leave;
    end;
    LName := ptr to const char(addr of LEntry^.d_name[0]);
    if not DoIsDotName(LName) then
      LBytes := int64(strlen(LName)) + 1;
      if (AText <> nil) and (LTotal + LBytes <= ASize) then
        memcpy(ptr(addr of AText[LTotal]), ptr(LName), uint64(LBytes));
      end;
      LTotal := LTotal + LBytes;
    end;
  end;
  closedir(LFolder);
  if not LOk then
    return -1;
  end;
  return LTotal;
end;

// The last write time of the file or folder at the NUL-terminated UTF-8 path APath
// (relative to the working folder) as the local time of that date (the time zone's rules
// for it, localtime_r): AYear, AMonth 1..12, ADay 1..31, AHour 0..23, AMinute and ASecond
// 0..59. False (every field 0) when it cannot be read
public func PlatformFileLocalTime(const APath: ptr to const char; var AYear: int32;
  var AMonth: int32; var ADay: int32; var AHour: int32; var AMinute: int32;
  var ASecond: int32): bool;
var
  LStat: PlatformStat;
  LSeconds: int64;
  LLocal: tm;
begin
  AYear := 0;
  AMonth := 0;
  ADay := 0;
  AHour := 0;
  AMinute := 0;
  ASecond := 0;
  if PlatformCStat(APath, LStat) <> 0 then
    return false;
  end;
  LSeconds := LStat.st_mtim.tv_sec;
  if localtime_r(addr of LSeconds, LLocal) = nil then
    return false;
  end;
  AYear := LLocal.tm_year + 1900;
  AMonth := LLocal.tm_mon + 1;
  ADay := LLocal.tm_mday;
  AHour := LLocal.tm_hour;
  AMinute := LLocal.tm_min;
  // A leap second (60) reads as the minute's last, as on win64
  ASecond := LLocal.tm_sec;
  if ASecond > 59 then
    ASecond := 59;
  end;
  return true;
end;

// The path of the program's exe (/proc/self/exe's target, the kernel's absolute path) into
// AText (ASize bytes; a NUL after the path when path and NUL fit, else nothing written):
// the bytes the path takes, its NUL not counted; 0 when it cannot be read
public func PlatformExePath(const AText: ptr to char; const ASize: int64): int64;
var
  LRoom: uint64;
  LPath: ptr to char;
  LGot: int64;
begin
  LRoom := ADAM_PLATFORM_PATH_START;
  while true do
    LPath := ptr to char(malloc(LRoom));
    if LPath = nil then
      return 0;
    end;
    LGot := readlink(ptr to const char(ADAM_PLATFORM_SELF_EXE), LPath, LRoom);
    if LGot <= 0 then
      free(ptr(LPath));
      return 0;
    end;
    // A path that fills the room may have been cut: try again with twice the room
    if uint64(LGot) < LRoom then
      leave;
    end;
    free(ptr(LPath));
    LRoom := LRoom * 2;
  end;
  if (AText <> nil) and (LGot < ASize) then
    memcpy(ptr(AText), ptr(LPath), uint64(LGot));
    AText[LGot] := '\0';
  end;
  free(ptr(LPath));
  return LGot;
end;

// The working folder as a NUL-terminated path in a new block from the C heap (the caller
// frees it); nil when it cannot be read
func DoWorkingFolder(): ptr to char;
var
  LRoom: uint64;
  LText: ptr to char;
begin
  LRoom := ADAM_PLATFORM_PATH_START;
  while true do
    LText := ptr to char(malloc(LRoom));
    if LText = nil then
      return nil;
    end;
    // The kernel's call (no hook between): the path's length with its NUL, or -1 with errno
    if syscall(SYS_getcwd, LText, LRoom) > 0 then
      return LText;
    end;
    free(ptr(LText));
    // ERANGE: the room was too small; anything else (a working folder gone) is a failure
    if DoErrno() <> ADAM_PLATFORM_ERANGE then
      return nil;
    end;
    LRoom := LRoom * 2;
  end;
end;

// The NUL-terminated UTF-8 path APath made full: the working folder joined to a relative
// path, "." and ".." folded as text (a ".." at the root stays at the root; the disk is never
// touched, links are not followed: System.Runtime.Win64's GetFullPathNameW rule), as UTF-8
// into AText (ASize bytes; a NUL after the path when path and NUL fit, else nothing
// written): the bytes the full path takes, its NUL not counted; 0 when it cannot be made
public func PlatformFullPath(const APath: ptr to const char; const AText: ptr to char;
  const ASize: int64): int64;
var
  LFolder: ptr to char;
  LFolderLength: int64;
  LPathLength: int64;
  LJoined: ptr to char;
  LLength: int64;
  LOut: int64;
  LAt: int64;
  LStart: int64;
  LCount: int64;
begin
  LPathLength := int64(strlen(APath));
  LFolder := nil;
  LFolderLength := 0;
  if (LPathLength = 0) or (APath[0] <> '/') then
    LFolder := DoWorkingFolder();
    if LFolder = nil then
      return 0;
    end;
    LFolderLength := int64(strlen(ptr to const char(LFolder)));
  end;
  // The folder, a '/', the path, the NUL: what is folded below (in place, never longer)
  LJoined := ptr to char(malloc(uint64(LFolderLength + LPathLength + 2)));
  if LJoined = nil then
    free(ptr(LFolder));
    return 0;
  end;
  LLength := 0;
  if LFolder <> nil then
    memcpy(ptr(LJoined), ptr(LFolder), uint64(LFolderLength));
    LJoined[LFolderLength] := '/';
    LLength := LFolderLength + 1;
    free(ptr(LFolder));
  end;
  memcpy(ptr(addr of LJoined[LLength]), ptr(APath), uint64(LPathLength));
  LLength := LLength + LPathLength;
  // Each segment between '/'s: empty and "." dropped, ".." takes the last kept one off,
  // any other kept as "/<segment>". The written end LOut never passes the read place LAt
  // (each kept segment is written as long as it was read), so the fold runs in place
  LOut := 0;
  LAt := 0;
  while LAt < LLength do
    while (LAt < LLength) and (LJoined[LAt] = '/') do
      LAt := LAt + 1;
    end;
    LStart := LAt;
    while (LAt < LLength) and (LJoined[LAt] <> '/') do
      LAt := LAt + 1;
    end;
    LCount := LAt - LStart;
    if (LCount = 0) or ((LCount = 1) and (LJoined[LStart] = '.')) then
      skip;
    end;
    if (LCount = 2) and (LJoined[LStart] = '.') and (LJoined[LStart + 1] = '.') then
      while (LOut > 0) and (LJoined[LOut - 1] <> '/') do
        LOut := LOut - 1;
      end;
      if LOut > 0 then
        LOut := LOut - 1;
      end;
      skip;
    end;
    // Copied forward byte by byte: the two ranges may overlap, the written one first
    LJoined[LOut] := '/';
    LOut := LOut + 1;
    LAt := LStart;
    while LAt < LStart + LCount do
      LJoined[LOut] := LJoined[LAt];
      LOut := LOut + 1;
      LAt := LAt + 1;
    end;
  end;
  // Nothing kept: the root
  if LOut = 0 then
    LJoined[0] := '/';
    LOut := 1;
  end;
  if (AText <> nil) and (LOut < ASize) then
    memcpy(ptr(AText), ptr(LJoined), uint64(LOut));
    AText[LOut] := '\0';
  end;
  free(ptr(LJoined));
  return LOut;
end;

// glibc: the object a loaded address lies in (its link map through AExtra), a handle's own
// link map
func dladdr1(const AAddress: ptr; const AInfo: ptr; var AExtra: ptr; const AFlags: int32): int32;
  external "c";
func dlinfo(const AHandle: ptr; const ARequest: int32; var AResult: ptr): int32; external "c";

const
  // dlfcn.h: dladdr1's link map request, dlinfo's
  RTLD_DL_LINKMAP: int32 = 2;
  RTLD_DI_LINKMAP: int32 = 2;

// The routine AName of the shared library ALibrary (a NUL-terminated file name, "libc.so.6")
// when the process has it loaded (dlopen with RTLD_NOLOAD never loads one; its reference is
// given back at once), its default version as dlsym binds it, looked up in that library
// alone as win64's GetProcAddress is (dlsym on a handle also searches the library's
// dependencies: a symbol found in another object is no definition of this one's); nil when
// it is not loaded or defines no such symbol
public func PlatformFindLoaded(const ALibrary: ptr to const char;
  const AName: ptr to const char): ptr;
var
  LLibrary: ptr;
  LFound: ptr;
  LOwn: ptr;
  LHolder: ptr;
  // a Dl_info (four words), which dladdr1 fills
  LInfo: array[0..3] of uint64;
begin
  if (ALibrary = nil) or (AName = nil) then
    return nil;
  end;
  LLibrary := dlopen(ALibrary, RTLD_NOW | RTLD_NOLOAD);
  if LLibrary = nil then
    return nil;
  end;
  LFound := dlsym(LLibrary, AName);
  LOwn := nil;
  LHolder := nil;
  if LFound <> nil then
    if (dlinfo(LLibrary, RTLD_DI_LINKMAP, LOwn) <> 0) or
      (dladdr1(LFound, ptr(addr of LInfo), LHolder, RTLD_DL_LINKMAP) = 0) or
      (LOwn <> LHolder) then
      LFound := nil;
    end;
  end;
  dlclose(LLibrary);
  return LFound;
end;

// The C runtime's definition of the C name AName: libc.so.6's (glibc, loaded with every Adam
// exe, looked in alone: a name the program itself defines, a HookIO hook, is never found
// here); nil when it has none
public func PlatformFindCRuntime(const AName: ptr to const char): ptr;
begin
  return PlatformFindLoaded(ptr to const char(ADAM_PLATFORM_C_RUNTIME), AName);
end;

// The calling thread's C errno (glibc's: what C functions report)
public func PlatformErrno(): int32;
begin
  return DoErrno();
end;

// The calling thread's C errno set to AValue
public func PlatformSetErrno(const AValue: int32);
begin
  DoSetErrno(AValue);
end;

// The run-time hooks (PlatformHookInstall / PlatformHookUninstall, PaskalCPP's HookABI run-time
// level; LX4f, the win64 import-table patch's linux form): a hook writes its replacement into
// every GOT slot of its C name (a R_X86_64_JUMP_SLOT or R_X86_64_GLOB_DAT relocation naming
// it) in every loaded object, records each slot and what it held, and puts exactly that back
// into every recorded slot whose object is still loaded. A slot in the object's RELRO range
// is made writable for its store and read-only again after it. glibc has no load
// notification (win64's loader DLL notification): the first install hooks dlopen and dlclose
// themselves (internal hooks, the same GOT patch), so an object loaded through dlopen gets
// every hook written into it as its dlopen returns, and an unload through dlclose drops its
// slots. An object glibc loads on its own (NSS, gconv) is not patched (his OK 2026-11-25).
// Calls that do not go through a slot (inside the defining object, a link-time hook's own
// symbol) are the link-time level's. Every walk of the objects runs under the table lock and
// inside dl_iterate_phdr, whose loader lock keeps a visited object mapped (no pin needed).

const
  // elf.h: the dynamic tags read, the program header kinds, the relocation kinds that are
  // import slots, an Elf64_Dyn's / Elf64_Rela's / Elf64_Sym's bytes
  DT_NULL: int64 = 0;
  DT_PLTRELSZ: int64 = 2;
  DT_STRTAB: int64 = 5;
  DT_SYMTAB: int64 = 6;
  DT_RELA: int64 = 7;
  DT_RELASZ: int64 = 8;
  DT_JMPREL: int64 = 23;
  PT_DYNAMIC: uint32 = 2;
  PT_GNU_RELRO: uint32 = 0x6474E552;
  R_X86_64_GLOB_DAT: uint64 = 6;
  R_X86_64_JUMP_SLOT: uint64 = 7;
  ADAM_PLATFORM_DYN_BYTES: uint64 = 16;
  ADAM_PLATFORM_RELA_BYTES: uint64 = 24;
  ADAM_PLATFORM_SYM_BYTES: uint64 = 24;
  // A pointer's bytes
  ADAM_PLATFORM_ADDRESS_SIZE: uint64 = 8;

type
  // One GOT slot a run-time hook wrote: the slot, what it held, the object it is in (its
  // .dynamic's loaded address: one per loaded object, never 0); Keep: a walk's mark
  // (DoHookPrune: its object was seen; DoHookRestoreLocked: it could not go back)
  PlatformHookSlot = record
    Address: ptr to uint64;
    Old: uint64;
    Base: uint64;
    Keep: bool;
  end;

  // A run-time hook: its C name (a copy, NUL-terminated), the replacement, every slot it
  // wrote (Slots: SlotCount of SlotCapacity used); Removing: its slots are being put back, an
  // object loaded now is not patched with it; Internal: dlopen's / dlclose's own (DoHookLoads),
  // never a user's, never uninstalled
  PlatformHookEntry = record
    Name: ptr to char;
    Replacement: uint64;
    Slots: ptr to PlatformHookSlot;
    SlotCount: int64;
    SlotCapacity: int64;
    Removing: bool;
    Internal: bool;
  end;

  // A loaded object's import tables (DoHookObjectOf): its id (its .dynamic's address), load
  // bias, string and symbol tables, its .rela.dyn and .rela.plt (address, bytes), its RELRO
  // range (Low .. High: none when equal)
  PlatformHookObject = record
    Id: uint64;
    Bias: uint64;
    StrTab: uint64;
    SymTab: uint64;
    Rela: uint64;
    RelaSize: uint64;
    JmpRel: uint64;
    JmpRelSize: uint64;
    RelroLow: uint64;
    RelroHigh: uint64;
  end;

  // A walk of the objects (dl_iterate_phdr's data): the hook it is for (nil: every hook that
  // is not being removed), the first failure (0, or C's errno value), the original's search
  // (Name: the C name, Found: the first slot's value)
  PlatformHookWalk = record
    Entry: ptr to PlatformHookEntry;
    Code: int32;
    Name: ptr to const char;
    Found: uint64;
  end;

  // glibc's dlopen and dlclose as the internal hooks call them
  PlatformDlopen = func(AFile: ptr to const char; AMode: int32): ptr;
  PlatformDlclose = func(AHandle: ptr): int32;

var
  // The run-time hooks: the run lock makes installs and uninstalls run one at a time; the
  // table lock (taken first, then the loader's in dl_iterate_phdr: always in that order)
  // guards the list and every hook's slots; GHookEntries: GHookEntryCount entry addresses of
  // GHookEntryCapacity, the internal hooks first; GHookLoadsReady once dlopen / dlclose are
  // hooked, GHookDlopen / GHookDlclose what they reached (glibc's)
  GHookRunLock: array[0..4] of uint64;
  GHookTableLock: array[0..4] of uint64;
  GHookEntries: ptr to uint64;
  GHookEntryCount: int64;
  GHookEntryCapacity: int64;
  GHookLoadsReady: bool;
  GHookDlopen: PlatformDlopen;
  GHookDlclose: PlatformDlclose;

// A d_ptr of .dynamic: glibc rewrites it to an address as it loads an object (the vDSO's,
// read-only, stays relative to ABias)
func DoHookDynamicPointer(const AValue: uint64; const ABias: uint64): uint64;
begin
  if AValue < ABias then
    return AValue + ABias;
  end;
  return AValue;
end;

// The import tables of the loaded object dl_iterate_phdr hands as AInfo into AObject;
// false when it has no .dynamic or no symbol / string table (nothing it imports by name)
func DoHookObjectOf(const AInfo: ptr; var AObject: PlatformHookObject): bool;
var
  LPhdrs: uint64;
  LCount: uint64;
  LPhdr: uint64;
  LKind: uint32;
  LDynamic: uint64;
  LTag: int64;
  LValue: uint64;
  LI: uint64;
begin
  memset(ptr(addr of AObject), 0, uint64(size(PlatformHookObject)));
  AObject.Bias := DoWordAt(uint64(AInfo) + ADAM_PLATFORM_PHDR_INFO_ADDR);
  LPhdrs := DoWordAt(uint64(AInfo) + ADAM_PLATFORM_PHDR_INFO_PHDR);
  LCount := DoHalfAt(uint64(AInfo) + ADAM_PLATFORM_PHDR_INFO_PHNUM);
  LDynamic := 0;
  for LI := 0 to LCount - 1 do
    LPhdr := LPhdrs + LI * ADAM_PLATFORM_PHDR_BYTES;
    LKind := uint32(DoLongAt(LPhdr));
    if LKind = PT_DYNAMIC then
      LDynamic := AObject.Bias + DoWordAt(LPhdr + ADAM_PLATFORM_PHDR_VADDR);
    end;
    if LKind = PT_GNU_RELRO then
      AObject.RelroLow := AObject.Bias + DoWordAt(LPhdr + ADAM_PLATFORM_PHDR_VADDR);
      AObject.RelroHigh := AObject.RelroLow + DoWordAt(LPhdr + ADAM_PLATFORM_PHDR_MEMSZ);
    end;
  end;
  if (LCount = 0) or (LDynamic = 0) then
    return false;
  end;
  AObject.Id := LDynamic;
  LTag := int64(DoWordAt(LDynamic));
  while LTag <> DT_NULL do
    LValue := DoWordAt(LDynamic + 8);
    if LTag = DT_STRTAB then
      AObject.StrTab := DoHookDynamicPointer(LValue, AObject.Bias);
    end;
    if LTag = DT_SYMTAB then
      AObject.SymTab := DoHookDynamicPointer(LValue, AObject.Bias);
    end;
    if LTag = DT_RELA then
      AObject.Rela := DoHookDynamicPointer(LValue, AObject.Bias);
    end;
    if LTag = DT_RELASZ then
      AObject.RelaSize := LValue;
    end;
    if LTag = DT_JMPREL then
      AObject.JmpRel := DoHookDynamicPointer(LValue, AObject.Bias);
    end;
    if LTag = DT_PLTRELSZ then
      AObject.JmpRelSize := LValue;
    end;
    LDynamic := LDynamic + ADAM_PLATFORM_DYN_BYTES;
    LTag := int64(DoWordAt(LDynamic));
  end;
  return (AObject.StrTab <> 0) and (AObject.SymTab <> 0);
end;

// The import slot number AIndex (from 0) of the C name AName in the object AObject, counted
// over its .rela.plt then its .rela.dyn (JUMP_SLOT and GLOB_DAT relocations whose symbol is
// named AName, a versioned one by its base name); nil when it has fewer. Only the
// relocations are read, so a slot written never changes what a later call finds
func DoHookImportSlot(const AObject: PlatformHookObject; const AName: ptr to const char;
  const AIndex: int64): ptr to uint64;
var
  LTable: uint64;
  LSize: uint64;
  LAt: uint64;
  LInfo: uint64;
  LKind: uint64;
  LSymbol: uint64;
  LNameAt: uint64;
  LSeen: int64;
  LPass: int64;
begin
  LSeen := 0;
  for LPass := 0 to 1 do
    LTable := AObject.JmpRel;
    LSize := AObject.JmpRelSize;
    if LPass = 1 then
      LTable := AObject.Rela;
      LSize := AObject.RelaSize;
    end;
    LAt := 0;
    while (LTable <> 0) and (LAt + ADAM_PLATFORM_RELA_BYTES <= LSize) do
      LInfo := DoWordAt(LTable + LAt + 8);
      LKind := LInfo & 0xFFFFFFFF;
      LSymbol := LInfo shr 32;
      if ((LKind = R_X86_64_JUMP_SLOT) or (LKind = R_X86_64_GLOB_DAT)) and (LSymbol <> 0) then
        LNameAt := AObject.StrTab + DoLongAt(AObject.SymTab + LSymbol * ADAM_PLATFORM_SYM_BYTES);
        if strcmp(ptr to const char(LNameAt), AName) = 0 then
          if LSeen = AIndex then
            return ptr to uint64(AObject.Bias + DoWordAt(LTable + LAt));
          end;
          LSeen := LSeen + 1;
        end;
      end;
      LAt := LAt + ADAM_PLATFORM_RELA_BYTES;
    end;
  end;
  return nil;
end;

// AValue stored in the slot ASlot of the object AObject: a slot in its RELRO range has its
// page made writable for the store and read-only again after it (one aligned 8-byte store: a
// thread calling through the slot meanwhile reads the old or the new value, never a mix);
// false when the protection cannot be changed (nothing written then)
func DoHookWriteSlot(const AObject: PlatformHookObject; const ASlot: ptr to uint64;
  const AValue: uint64): bool;
var
  LPage: uint64;
  LRelro: bool;
begin
  LRelro := (uint64(ASlot) >= AObject.RelroLow) and (uint64(ASlot) < AObject.RelroHigh);
  if not LRelro then
    ASlot^ := AValue;
    return true;
  end;
  LPage := uint64(ASlot) - (uint64(ASlot) mod GFaultPage);
  if mprotect(ptr(LPage), GFaultPage, PROT_READ | PROT_WRITE) <> 0 then
    return false;
  end;
  ASlot^ := AValue;
  mprotect(ptr(LPage), GFaultPage, PROT_READ);
  return true;
end;

// Where the hook AEntry recorded the slot at the address ASlot; -1 when it did not
func DoHookSlotIndex(const AEntry: ptr to PlatformHookEntry; const ASlot: uint64): int64;
var
  LI: int64;
begin
  for LI := 0 to AEntry^.SlotCount - 1 do
    if uint64(AEntry^.Slots[LI].Address) = ASlot then
      return LI;
    end;
  end;
  return -1;
end;

// The slot ASlot of the object ABase, holding AOld, recorded for the hook AEntry; false when
// its list cannot grow
func DoHookAddSlot(const AEntry: ptr to PlatformHookEntry; const ASlot: ptr to uint64;
  const AOld: uint64; const ABase: uint64): bool;
var
  LRoom: int64;
  LSlots: ptr to PlatformHookSlot;
begin
  if AEntry^.SlotCount = AEntry^.SlotCapacity then
    LRoom := (AEntry^.SlotCapacity * 2) + 4;
    LSlots := ptr to PlatformHookSlot(realloc(ptr(AEntry^.Slots),
      uint64(LRoom) * uint64(size(PlatformHookSlot))));
    if LSlots = nil then
      return false;
    end;
    AEntry^.Slots := LSlots;
    AEntry^.SlotCapacity := LRoom;
  end;
  AEntry^.Slots[AEntry^.SlotCount].Address := ASlot;
  AEntry^.Slots[AEntry^.SlotCount].Old := AOld;
  AEntry^.Slots[AEntry^.SlotCount].Base := ABase;
  AEntry^.Slots[AEntry^.SlotCount].Keep := true;
  AEntry^.SlotCount := AEntry^.SlotCount + 1;
  return true;
end;

// The hook AEntry's slots not marked Keep dropped (the others keep their order)
func DoHookDropUnkept(const AEntry: ptr to PlatformHookEntry);
var
  LI: int64;
  LOut: int64;
begin
  LOut := 0;
  for LI := 0 to AEntry^.SlotCount - 1 do
    if AEntry^.Slots[LI].Keep then
      AEntry^.Slots[LOut] := AEntry^.Slots[LI];
      LOut := LOut + 1;
    end;
  end;
  AEntry^.SlotCount := LOut;
end;

// The hook AEntry written into every slot of its name in the object AObject not recorded
// yet: 0, or ENOMEM / EACCES when one could not be recorded / written (the ones that were
// stay recorded). Nothing for a hook being removed
func DoHookPatchObject(const AEntry: ptr to PlatformHookEntry;
  const AObject: PlatformHookObject): int32;
var
  LIndex: int64;
  LSlot: ptr to uint64;
begin
  if AEntry^.Removing then
    return 0;
  end;
  LIndex := 0;
  LSlot := DoHookImportSlot(AObject, AEntry^.Name, LIndex);
  while LSlot <> nil do
    if DoHookSlotIndex(AEntry, uint64(LSlot)) < 0 then
      if not DoHookAddSlot(AEntry, LSlot, LSlot^, AObject.Id) then
        return ADAM_PLATFORM_ENOMEM;
      end;
      if not DoHookWriteSlot(AObject, LSlot, AEntry^.Replacement) then
        AEntry^.SlotCount := AEntry^.SlotCount - 1;
        return ADAM_PLATFORM_EACCES;
      end;
    end;
    LIndex := LIndex + 1;
    LSlot := DoHookImportSlot(AObject, AEntry^.Name, LIndex);
  end;
  return 0;
end;

// dl_iterate_phdr's visitor writing hooks into the object AInfo: the walk's hook, or every
// hook (its Entry nil), in the list's order; the walk's first failure kept, the walk goes on
// (a failed object keeps what it holds)
func DoHookPatchVisit(const AInfo: ptr; const ASize: uint64; const AData: ptr): int32;
var
  LWalk: ptr to PlatformHookWalk;
  LObject: PlatformHookObject;
  LCode: int32;
  LI: int64;
begin
  LWalk := ptr to PlatformHookWalk(AData);
  if not DoHookObjectOf(AInfo, LObject) then
    return 0;
  end;
  if LWalk^.Entry <> nil then
    LCode := DoHookPatchObject(LWalk^.Entry, LObject);
    if (LCode <> 0) and (LWalk^.Code = 0) then
      LWalk^.Code := LCode;
    end;
    return 0;
  end;
  for LI := 0 to GHookEntryCount - 1 do
    DoHookPatchObject(ptr to PlatformHookEntry(GHookEntries[LI]), LObject);
  end;
  return 0;
end;

// dl_iterate_phdr's visitor marking every recorded slot of the object AInfo kept
// (DoHookPrune)
func DoHookSeeVisit(const AInfo: ptr; const ASize: uint64; const AData: ptr): int32;
var
  LObject: PlatformHookObject;
  LEntry: ptr to PlatformHookEntry;
  LI: int64;
  LJ: int64;
begin
  if not DoHookObjectOf(AInfo, LObject) then
    return 0;
  end;
  for LI := 0 to GHookEntryCount - 1 do
    LEntry := ptr to PlatformHookEntry(GHookEntries[LI]);
    for LJ := 0 to LEntry^.SlotCount - 1 do
      if LEntry^.Slots[LJ].Base = LObject.Id then
        LEntry^.Slots[LJ].Keep := true;
      end;
    end;
  end;
  return 0;
end;

// The slots of objects no longer loaded dropped from every hook (nothing is written into a
// gone object). The caller holds the table lock
func DoHookPrune();
var
  LEntry: ptr to PlatformHookEntry;
  LI: int64;
  LJ: int64;
begin
  for LI := 0 to GHookEntryCount - 1 do
    LEntry := ptr to PlatformHookEntry(GHookEntries[LI]);
    for LJ := 0 to LEntry^.SlotCount - 1 do
      LEntry^.Slots[LJ].Keep := false;
    end;
  end;
  dl_iterate_phdr(DoHookSeeVisit, nil);
  for LI := 0 to GHookEntryCount - 1 do
    DoHookDropUnkept(ptr to PlatformHookEntry(GHookEntries[LI]));
  end;
end;

// dl_iterate_phdr's visitor putting the walk's hook's slots in the object AInfo back: a slot
// that cannot go back stays marked kept
func DoHookRestoreVisit(const AInfo: ptr; const ASize: uint64; const AData: ptr): int32;
var
  LWalk: ptr to PlatformHookWalk;
  LObject: PlatformHookObject;
  LEntry: ptr to PlatformHookEntry;
  LJ: int64;
begin
  LWalk := ptr to PlatformHookWalk(AData);
  if not DoHookObjectOf(AInfo, LObject) then
    return 0;
  end;
  LEntry := LWalk^.Entry;
  for LJ := 0 to LEntry^.SlotCount - 1 do
    if LEntry^.Slots[LJ].Base = LObject.Id then
      LEntry^.Slots[LJ].Keep := not DoHookWriteSlot(LObject, LEntry^.Slots[LJ].Address,
        LEntry^.Slots[LJ].Old);
    end;
  end;
  return 0;
end;

// Every slot of the hook AEntry whose object is still loaded given back what it held; those
// that went back and those of gone objects dropped: 0 when none is left, EACCES when one
// could not go back. The caller holds the table lock
func DoHookRestoreLocked(const AEntry: ptr to PlatformHookEntry): int32;
var
  LWalk: PlatformHookWalk;
  LJ: int64;
begin
  for LJ := 0 to AEntry^.SlotCount - 1 do
    AEntry^.Slots[LJ].Keep := false;
  end;
  memset(ptr(addr of LWalk), 0, uint64(size(PlatformHookWalk)));
  LWalk.Entry := AEntry;
  dl_iterate_phdr(DoHookRestoreVisit, ptr(addr of LWalk));
  DoHookDropUnkept(AEntry);
  if AEntry^.SlotCount > 0 then
    return ADAM_PLATFORM_EACCES;
  end;
  return 0;
end;

// dl_iterate_phdr's visitor of the original's search: the first object (load order) with
// a slot of the walk's name gives that slot's value (1: the walk stops)
func DoHookFindVisit(const AInfo: ptr; const ASize: uint64; const AData: ptr): int32;
var
  LWalk: ptr to PlatformHookWalk;
  LObject: PlatformHookObject;
  LSlot: ptr to uint64;
begin
  LWalk := ptr to PlatformHookWalk(AData);
  if not DoHookObjectOf(AInfo, LObject) then
    return 0;
  end;
  LSlot := DoHookImportSlot(LObject, LWalk^.Name, 0);
  if LSlot = nil then
    return 0;
  end;
  LWalk^.Found := LSlot^;
  return 1;
end;

// What the C name AName's slots reach: the value of its first slot in load order; when no
// object imports it yet, the first object's definition of it (dlsym, RTLD_DEFAULT); 0 when
// none has it. The caller holds the table lock
func DoHookOriginal(const AName: ptr to const char): uint64;
var
  LWalk: PlatformHookWalk;
begin
  memset(ptr(addr of LWalk), 0, uint64(size(PlatformHookWalk)));
  LWalk.Name := AName;
  dl_iterate_phdr(DoHookFindVisit, ptr(addr of LWalk));
  if LWalk.Found = 0 then
    LWalk.Found := uint64(dlsym(nil, AName));
  end;
  return LWalk.Found;
end;

// The hook AEntry written into every loaded object: 0, or ENOMEM / EACCES (the first
// failure; what was written stays recorded). The caller holds the table lock
func DoHookApplyLocked(const AEntry: ptr to PlatformHookEntry): int32;
var
  LWalk: PlatformHookWalk;
begin
  memset(ptr(addr of LWalk), 0, uint64(size(PlatformHookWalk)));
  LWalk.Entry := AEntry;
  dl_iterate_phdr(DoHookPatchVisit, ptr(addr of LWalk));
  return LWalk.Code;
end;

// The internal hook of dlopen: glibc's dlopen, then (it loaded something) the slots of
// unloaded objects dropped and every hook written into every object (a new one gets them
// all; what is recorded is not written again); C's errno kept as dlopen left it
func DoHookDlopenHook(AFile: ptr to const char; AMode: int32): ptr;
var
  LHandle: ptr;
  LErrno: int32;
  LWalk: PlatformHookWalk;
begin
  LHandle := GHookDlopen(AFile, AMode);
  if LHandle = nil then
    return nil;
  end;
  LErrno := DoErrno();
  pthread_mutex_lock(ptr(addr of GHookTableLock));
  DoHookPrune();
  memset(ptr(addr of LWalk), 0, uint64(size(PlatformHookWalk)));
  dl_iterate_phdr(DoHookPatchVisit, ptr(addr of LWalk));
  pthread_mutex_unlock(ptr(addr of GHookTableLock));
  DoSetErrno(LErrno);
  return LHandle;
end;

// The internal hook of dlclose: glibc's dlclose, then the slots of the objects it unloaded
// dropped; C's errno kept as dlclose left it
func DoHookDlcloseHook(AHandle: ptr): int32;
var
  LResult: int32;
  LErrno: int32;
begin
  LResult := GHookDlclose(AHandle);
  LErrno := DoErrno();
  pthread_mutex_lock(ptr(addr of GHookTableLock));
  DoHookPrune();
  pthread_mutex_unlock(ptr(addr of GHookTableLock));
  DoSetErrno(LErrno);
  return LResult;
end;

// Where the hook whose record is at the address AEntry is among the hooks; -1 when it is
// not one (the caller holds the table lock)
func DoHookEntryIndex(const AEntry: uint64): int64;
var
  LI: int64;
begin
  for LI := 0 to GHookEntryCount - 1 do
    if GHookEntries[LI] = AEntry then
      return LI;
    end;
  end;
  return -1;
end;

// Where a user's hook (never an internal one) of the C name AName is among the hooks; -1
// when none has it (the caller holds the table lock)
func DoHookNameIndex(const AName: ptr to const char): int64;
var
  LI: int64;
  LEntry: ptr to PlatformHookEntry;
begin
  for LI := 0 to GHookEntryCount - 1 do
    LEntry := ptr to PlatformHookEntry(GHookEntries[LI]);
    if (not LEntry^.Internal) and (strcmp(LEntry^.Name, AName) = 0) then
      return LI;
    end;
  end;
  return -1;
end;

// The hook AEntry added to the hooks; false when their list cannot grow (the caller holds
// the table lock)
func DoHookJoin(const AEntry: ptr to PlatformHookEntry): bool;
var
  LRoom: int64;
  LEntries: ptr to uint64;
begin
  if GHookEntryCount = GHookEntryCapacity then
    LRoom := (GHookEntryCapacity * 2) + 4;
    LEntries := ptr to uint64(realloc(ptr(GHookEntries),
      uint64(LRoom) * ADAM_PLATFORM_ADDRESS_SIZE));
    if LEntries = nil then
      return false;
    end;
    GHookEntries := LEntries;
    GHookEntryCapacity := LRoom;
  end;
  GHookEntries[GHookEntryCount] := uint64(AEntry);
  GHookEntryCount := GHookEntryCount + 1;
  return true;
end;

// The hook AEntry taken out of the hooks (the others keep their order; the caller holds the
// table lock)
func DoHookLeave(const AEntry: ptr to PlatformHookEntry);
var
  LAt: int64;
  LI: int64;
begin
  LAt := DoHookEntryIndex(uint64(AEntry));
  if LAt < 0 then
    return;
  end;
  for LI := LAt to GHookEntryCount - 2 do
    GHookEntries[LI] := GHookEntries[LI + 1];
  end;
  GHookEntryCount := GHookEntryCount - 1;
end;

// A new hook record of the C name AName (copied) and AReplacement, with no slot; nil when
// out of memory
func DoHookNewEntry(const AName: ptr to const char; const AReplacement: ptr;
  const AInternal: bool): ptr to PlatformHookEntry;
var
  LLength: uint64;
  LName: ptr to char;
  LEntry: ptr to PlatformHookEntry;
begin
  LLength := strlen(AName);
  LName := ptr to char(malloc(LLength + 1));
  if LName = nil then
    return nil;
  end;
  // the name's bytes and its NUL
  memcpy(ptr(LName), ptr(AName), LLength + 1);
  LEntry := ptr to PlatformHookEntry(malloc(uint64(size(PlatformHookEntry))));
  if LEntry = nil then
    free(ptr(LName));
    return nil;
  end;
  LEntry^.Name := LName;
  LEntry^.Replacement := uint64(AReplacement);
  LEntry^.Slots := nil;
  LEntry^.SlotCount := 0;
  LEntry^.SlotCapacity := 0;
  LEntry^.Removing := false;
  LEntry^.Internal := AInternal;
  return LEntry;
end;

// The hook record AEntry freed with its name and its slot list
func DoHookFreeEntry(const AEntry: ptr to PlatformHookEntry);
begin
  free(ptr(AEntry^.Name));
  free(ptr(AEntry^.Slots));
  free(ptr(AEntry));
end;

// A new hook of AName by AReplacement joined and written everywhere (AOriginal: what its
// slots reached); 0 with AEntry set, else C's errno value with nothing installed (every slot
// written put back). The caller holds the table lock
func DoHookAddLocked(const AName: ptr to const char; const AReplacement: ptr;
  const AInternal: bool; var AOriginal: uint64; var AEntry: ptr to PlatformHookEntry): int32;
var
  LCode: int32;
begin
  AEntry := nil;
  AOriginal := DoHookOriginal(AName);
  if AOriginal = 0 then
    return ADAM_PLATFORM_ENOENT;
  end;
  AEntry := DoHookNewEntry(AName, AReplacement, AInternal);
  if AEntry = nil then
    return ADAM_PLATFORM_ENOMEM;
  end;
  if not DoHookJoin(AEntry) then
    DoHookFreeEntry(AEntry);
    AEntry := nil;
    return ADAM_PLATFORM_ENOMEM;
  end;
  LCode := DoHookApplyLocked(AEntry);
  if LCode <> 0 then
    // undone: what cannot go back keeps the replacement
    AEntry^.Removing := true;
    DoHookRestoreLocked(AEntry);
    DoHookLeave(AEntry);
    DoHookFreeEntry(AEntry);
    AEntry := nil;
  end;
  return LCode;
end;

// dlopen and dlclose hooked once (the first install), so objects loaded later get the hooks
// and unloaded ones drop their slots; false leaves a hook to patch only the objects loaded
// now. The caller holds the table lock
func DoHookLoads(): bool;
var
  LOpen: uint64;
  LClose: uint64;
  LOpenEntry: ptr to PlatformHookEntry;
  LCloseEntry: ptr to PlatformHookEntry;
  LOpenHook: PlatformDlopen;
  LCloseHook: PlatformDlclose;
begin
  if GHookLoadsReady then
    return true;
  end;
  LOpenHook := DoHookDlopenHook;
  LCloseHook := DoHookDlcloseHook;
  LOpen := DoHookOriginal(ptr to const char("dlopen"));
  LClose := DoHookOriginal(ptr to const char("dlclose"));
  if (LOpen = 0) or (LClose = 0) then
    return false;
  end;
  // the originals are set before any slot reaches the hooks
  GHookDlopen := PlatformDlopen(ptr(LOpen));
  GHookDlclose := PlatformDlclose(ptr(LClose));
  if DoHookAddLocked(ptr to const char("dlopen"), ptr(LOpenHook), true, LOpen,
    LOpenEntry) <> 0 then
    return false;
  end;
  if DoHookAddLocked(ptr to const char("dlclose"), ptr(LCloseHook), true, LClose,
    LCloseEntry) <> 0 then
    LOpenEntry^.Removing := true;
    DoHookRestoreLocked(LOpenEntry);
    DoHookLeave(LOpenEntry);
    DoHookFreeEntry(LOpenEntry);
    return false;
  end;
  GHookLoadsReady := true;
  return true;
end;

// PlatformHookInstall's work under the run lock: AOriginal and AEntry set when it returns 0
func DoHookInstallLocked(const AName: ptr to const char; const AReplacement: ptr;
  var AOriginal: uint64; var AEntry: ptr to PlatformHookEntry): int32;
var
  LCode: int32;
begin
  pthread_mutex_lock(ptr(addr of GHookTableLock));
  if DoHookNameIndex(AName) >= 0 then
    pthread_mutex_unlock(ptr(addr of GHookTableLock));
    return ADAM_PLATFORM_EEXIST;
  end;
  if DoHookOriginal(AName) = 0 then
    pthread_mutex_unlock(ptr(addr of GHookTableLock));
    return ADAM_PLATFORM_ENOENT;
  end;
  // dlopen / dlclose hooked before the hook joins: an object loaded after it joins is
  // patched by the dlopen hook, never missed
  DoHookLoads();
  LCode := DoHookAddLocked(AName, AReplacement, false, AOriginal, AEntry);
  pthread_mutex_unlock(ptr(addr of GHookTableLock));
  return LCode;
end;

// A run-time hook installed (System.Runtime's InstallHook): the C name AName's GOT slot in
// every loaded object takes AReplacement, and so does every object loaded later through
// dlopen. 0 with AOriginal (what the slots reached) and AState (the hook's record) set; else
// C's errno value of the failure, nothing installed: EINVAL (nil or empty AName, nil
// AReplacement), EEXIST (AState is set, or AName is hooked already), ENOENT (no loaded object
// imports or defines AName), EACCES (a slot could not be written: every slot written is put
// back), ENOMEM. Installs and uninstalls run one at a time.
public func PlatformHookInstall(const AName: ptr to const char; const AReplacement: ptr;
  var AOriginal: ptr; var AState: ptr): int32;
var
  LOriginal: uint64;
  LEntry: ptr to PlatformHookEntry;
  LCode: int32;
begin
  if (AName = nil) or (AReplacement = nil) then
    return ADAM_PLATFORM_EINVAL;
  end;
  if strlen(AName) = 0 then
    return ADAM_PLATFORM_EINVAL;
  end;
  if AState <> nil then
    return ADAM_PLATFORM_EEXIST;
  end;
  if GFaultPage = 0 then
    GFaultPage := ADAM_PLATFORM_PAGE_DEFAULT;
    if sysconf(_SC_PAGESIZE) > 0 then
      GFaultPage := uint64(sysconf(_SC_PAGESIZE));
    end;
  end;
  LOriginal := 0;
  LEntry := nil;
  pthread_mutex_lock(ptr(addr of GHookRunLock));
  LCode := DoHookInstallLocked(AName, AReplacement, LOriginal, LEntry);
  pthread_mutex_unlock(ptr(addr of GHookRunLock));
  if LCode <> 0 then
    return LCode;
  end;
  AOriginal := ptr(LOriginal);
  AState := ptr(LEntry);
  return 0;
end;

// PlatformHookUninstall's work under the run lock
func DoHookUninstallLocked(const AState: ptr): int32;
var
  LEntry: ptr to PlatformHookEntry;
  LCode: int32;
begin
  pthread_mutex_lock(ptr(addr of GHookTableLock));
  if DoHookEntryIndex(uint64(AState)) < 0 then
    pthread_mutex_unlock(ptr(addr of GHookTableLock));
    return ADAM_PLATFORM_EINVAL;
  end;
  LEntry := ptr to PlatformHookEntry(AState);
  if LEntry^.Internal then
    pthread_mutex_unlock(ptr(addr of GHookTableLock));
    return ADAM_PLATFORM_EINVAL;
  end;
  // Removing: an object loaded now is not patched with it while its slots go back
  LEntry^.Removing := true;
  LCode := DoHookRestoreLocked(LEntry);
  if LCode <> 0 then
    // still installed: a later uninstall (or this one again) finishes it
    LEntry^.Removing := false;
    pthread_mutex_unlock(ptr(addr of GHookTableLock));
    return LCode;
  end;
  DoHookLeave(LEntry);
  pthread_mutex_unlock(ptr(addr of GHookTableLock));
  DoHookFreeEntry(LEntry);
  return 0;
end;

// A run-time hook uninstalled (System.Runtime's UninstallHook): every slot it wrote whose
// object is still loaded gets back exactly what it held; nothing else is written. 0 with
// AState nil; else C's errno value: EINVAL (AState is no installed hook), EACCES (a slot
// could not be written back: the hook stays installed, the slots that went back stay back)
public func PlatformHookUninstall(var AState: ptr): int32;
var
  LCode: int32;
begin
  if AState = nil then
    return ADAM_PLATFORM_EINVAL;
  end;
  pthread_mutex_lock(ptr(addr of GHookRunLock));
  LCode := DoHookUninstallLocked(AState);
  pthread_mutex_unlock(ptr(addr of GHookRunLock));
  if LCode = 0 then
    AState := nil;
  end;
  return LCode;
end;

end.
