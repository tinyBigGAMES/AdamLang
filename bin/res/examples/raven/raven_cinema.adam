  Adam™ Programming Language

  Copyright © 2026-present tinyBigGAMES™ LLC
  All Rights Reserved.

  https://adamlang.org

  SPDX-License-Identifier: MPL-2.0

  This Source Code Form is subject to the terms of the
  Mozilla Public License, v. 2.0. If a copy of the MPL
  was not distributed with this file, You can obtain one
  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raven_cinema.adam - a little video player: MPEG-1 clips from the assets
  played by raylib, a Raven transport bar over the picture.

  WHAT IT SHOWS
  - System.Raylib.Ext's video player (pl_mpeg with its MP2 audio): every
    clip is a VideoRes read straight out of bin\assets.zip, the source
    Assets mounted (no second open of the zip, no file extracted), decoded
    once a frame by Update, drawn by Draw.Video through its YCbCr shader,
    heard through a raylib audio stream.
  - A real transport bar (ui\cinema.xml): play / pause, stop, back and
    forward ten seconds, the time and the length, a seek bar you can drag
    (VideoRes.Seek shows the frame at the bar's place at once, even paused),
    loop, volume and mute; the keyboard does the same through Raven
    shortcuts (Space, Left / Right, Home, L, M, N).
  - The program: a Raven list of the clips with each one's length (read
    by opening each clip once at the start); picking one plays it; a clip
    that ends and does not loop hands over to the next.
  - The video's status handler drives the UI: the Play / Pause button's
    text and the status line follow the player whoever changed it (a click,
    a key, the end of a clip).
  - Ambient light: each frame the picture is also drawn into a tiny
    64 x 36 render texture, which is then stretched over the whole window
    with bilinear filtering and a dim tint: a soft glow in the clip's own
    colours around the screen, for the cost of one small draw.
  - The controls fade out while a clip plays and the mouse rests, and come
    back as soon as it moves or a key acts (Rwidget_set_opacity on the
    cards), like a real player's.
  - A DPI-scaled frame window (System.Raylib.Ext's Window, opened through
    Examples.Common):
    everything is drawn in 1280 x 720 base units.
  - Its last frame is saved as raven_cinema.png beside this file when it
    exits (Examples.Common's SaveExampleSnapshot).

  - F11 or Alt+Enter: borderless fullscreen and back, the frame letterboxed
    on the whole monitor (Examples.Common's ExampleFullscreenKeys).
  ADAM FEATURES ON SHOW
  - An object with methods: Cinema opens, closes, toggles and seeks the
    clip showing; its fields keep the clip's VideoRes and its index.
  - Overloads: Clock(seconds) writes a time, Clock(cinema) where the clip
    showing is out of its length ("0:04 / 0:10").
  - match: the status handler picks the button text and the status line
    by the video's status (a `choices` value).
  - Routine values: the status handler is an Adam routine given to the
    player (VideoRes.OnStatus, a closure slot); the list's selection callback is a
    `clink` routine given to Raven; every Raven action name is bound to the
    Adam routine answering it (System.Raven.Ext's UIActions.Bind).
  - FormatStr with std::format specs (`{:02}` pads the seconds).
  - Self-releasing objects: the window, the audio device, the glow's render
    texture and the clips are System.Raylib.Ext objects (each goes with its
    last copy, the device's and the window's last copies first unloading
    what still needs them); the clip, Raven and the zip are released by
    defers, in reverse on every way out.

  BUILD AND RUN (from repo\bin, the folder of adam.exe and assets.zip)
    adam build res\examples\raven\raven_cinema.adam -o output -r
  -r runs the program once built. For linux add -t x86_64-linux-gnu: on
  Windows -r runs the linux build through WSL2 (its display, WSLg), on
  linux natively.
*******************************************************************************/

module exe raven_cinema;

// Adam's icon on the exe and on its window ($P: is adam.exe's folder)
@exeicon "$P:res/assets/icons/adam.ico";

// The examples' shared unit (Examples.Common) lives in res\examples\common
@addmodulepath "$P:res/examples/common";

// System.Math before System.Raylib.C: a bare name two imports export is the last one's (BNF
// sec 1), so raylib's Vector2 / Rectangle are the ones used here
import System.SysUtils, System.Math, System.CustomIO, System.Raylib.C, System.Raylib.Ext,
  System.Raven.C, System.Raven.Ext, System.Raven.Raylib, Examples.Common;

const
  // The controls' layout, an entry of the zip (Examples.Common's OpenAssets made the zip the
  // program's files)
  CONTROLS_XML: string = "res/assets/ui/cinema.xml";
  // This example under res\examples, for its snapshot (Examples.Common's SaveExampleSnapshot)
  SNAPSHOT_NAME: string = "raven/raven_cinema";
  // The program: each clip's title, its entry in the zip and a line about it, in the order
  // they play
  CLIP_COUNT: int32 = 2;
  CLIP_TITLES: array[0..1] of string = ["Intro", "Explainer"];
  CLIP_ENTRIES: array[0..1] of string = ["res/assets/videos/intro.mpg",
    "res/assets/videos/explainer.mpg"];
  CLIP_NOTES: array[0..1] of string = ["Adam, the opening titles",
    "What Adam is, in a minute or two"];
  // The frame's base size (the window opens at this x the monitor's scale)
  BASE_WIDTH: int32 = 1280;
  BASE_HEIGHT: int32 = 720;
  // The share of the base size the screen may take (the rest is the glow around it)
  SCREEN_SHARE: float32 = 0.84f;
  // The glow's render texture: tiny on purpose, so stretching it over the window blurs it
  GLOW_WIDTH: int32 = 64;
  GLOW_HEIGHT: int32 = 36;
  // How bright the glow is (0 .. 1 of the clip's own colours)
  GLOW_STRENGTH: float32 = 0.55f;
  // How far the back and forward buttons jump, in seconds
  JUMP_SECONDS: float64 = 10.0;
  // The seek bar's range (Max in cinema.xml): its value / SEEK_STEPS is the share of the clip
  SEEK_STEPS: float32 = 1000.0f;
  // The volume at start (0 .. 100, the volume slider's Value in cinema.xml)
  START_VOLUME: int32 = 80;
  // Seconds the mouse must rest, while a clip plays, before the controls fade; and how fast
  // they fade in and out (opacity per second)
  IDLE_SECONDS: float32 = 2.5f;
  FADE_SPEED: float32 = 4.0f;

// ---------------------------------------------------------------------------
// Times as text: one name, two overloads
// ---------------------------------------------------------------------------

// A time as `m:ss` (whole seconds, rounded down; below 0 as 0:00)
func Clock(const ASeconds: float64): string;
var
  LWhole: int64;
begin
  LWhole := Max(Trunc(ASeconds), int64(0));
  // std::format's `{:02}`: the seconds always two digits
  return FormatStr("{}:{:02}", LWhole div 60, LWhole mod 60);
end;

// ---------------------------------------------------------------------------
// The player
// ---------------------------------------------------------------------------

type
  // The clip showing: its video, an entry of the mounted assets (VideoRes keeps the entry open
  // while it plays: it reads it as it goes, and closes it with its last copy).
  Cinema = object
    // The clip's index in the program (-1: none open)
    FIndex: int32;
    FVideo: VideoRes;
    // The clip's length in seconds, read once at the open: pl_mpeg finds it by seeking to
    // the clip's end and back, which through the zip means decoding there again
    FLength: float64;

    // Closes the clip: the empty video in its place (every method takes it) lets the clip's
    // last copy go, its entry with it
    method Close();
    begin
      self.FVideo := VideoRes();
      self.FIndex := -1;
      self.FLength := 0.0;
    end;

    // Opens clip AIndex of the program from the mounted assets (the clip open before is closed
    // first)
    method Open(const AIndex: int32): bool;
    begin
      self.Close();
      self.FVideo := VideoRes(CLIP_ENTRIES[AIndex]);
      if not self.FVideo.IsValid() then
        println("raven_cinema: {} is missing or no MPEG-1 video", CLIP_ENTRIES[AIndex]);
        self.Close();
        return false;
      end;
      self.FIndex := AIndex;
      self.FLength := self.FVideo.Duration();
      return true;
    end;

    // Plays a clip that is paused or stopped, pauses one that plays
    method Toggle();
    begin
      if self.FVideo.Playing() then
        self.FVideo.Pause();
      else
        self.FVideo.Play();
      end;
    end;

    // Moves the clip ASeconds from where it is (Seek keeps it inside the clip)
    method Jump(const ASeconds: float64);
    begin
      self.FVideo.Seek(self.FVideo.Time() + ASeconds);
    end;

    // Where the clip is, as a share of its length (0 .. 1)
    method Progress(): float32;
    begin
      if self.FLength <= 0.0 then
        return 0.0f;
      end;
      // System.Math's float64 Clamp, named in full: raylib's raymath has a float32 Clamp, and
      // a bare name two imports export is the last one's (BNF sec 1)
      return float32(System.Math.Clamp(self.FVideo.Time() / self.FLength, 0.0, 1.0));
    end;
  end;

// Where the clip showing is out of its length, `m:ss / m:ss` (Clock's second overload)
func Clock(const ACinema: Cinema): string;
begin
  return FormatStr("{} / {}", Clock(ACinema.FVideo.Time()), Clock(ACinema.FLength));
end;

var
  // The clip showing (the clips are entries of the shared assets, Examples.Common's OpenAssets)
  GCinema: Cinema;
  // The DPI-scaled frame window (its last copy, at the program's end, closes it)
  GWin: Window;
  // Sound: the volume (0 .. 1) and the mute switch, given to every clip as it opens
  GVolume: float32;
  GMuted: bool;
  // The status callback's notes for the loop: a clip played to its end (hand over to the
  // next), and the Stop button stopping it (no hand-over then)
  GEnded: bool;
  GStopping: bool;
  // The user drags the seek bar: the bar is theirs until the mouse button is up
  GScrubbing: bool;
  // The controls' fade: seconds since the user last acted, the cards' opacity now
  GIdle: float32;
  GOpacity: float32;
  // The second the time label shows (it is written only when it changes)
  GShownSecond: int64;
  // The controls and the widgets the program writes
  GControls: Rid;
  GPlayButton: Rid;
  GTimeLabel: Rid;
  GLengthLabel: Rid;
  GSeekBar: Rid;
  GClipList: Rid;
  GClipTitle: Rid;
  GClipNote: Rid;
  GLoopSwitch: Rid;
  GMuteSwitch: Rid;
  GCards: array[0..2] of Rid;

func Find(const AName: string): Rid;
begin
  return Rwidget_find(GControls, AName);
end;

// The user did something: the controls come back and stay a while
func Wake();
begin
  GIdle := 0.0f;
end;

// The clip's volume from the slider's and the mute switch's state
func ApplyVolume();
begin
  if GMuted then
    GCinema.FVideo.Volume(0.0f);
  else
    GCinema.FVideo.Volume(GVolume);
  end;
end;

// The video's status callback: whoever changed the status (a click, a shortcut, the end of
// the clip), the button and the status line say what the player does now
func OnVideoStatus(const AStatus: VideoStatus);
var
  LTitle: string;
begin
  // The clip the status is about (none while the cinema is between clips)
  LTitle := "";
  if GCinema.FIndex >= 0 then
    LTitle := CLIP_TITLES[GCinema.FIndex];
  end;
  match AStatus of
    VideoStatus.VideoPlaying:
      UIWidget.Wrap(GPlayButton).Text("Pause");
      UIWidget.Wrap(GClipNote).Text(FormatStr("Playing {}", LTitle));
    VideoStatus.VideoPaused:
      UIWidget.Wrap(GPlayButton).Text("Play");
      UIWidget.Wrap(GClipNote).Text(FormatStr("{} paused at {}", LTitle, Clock(GCinema)));
    VideoStatus.VideoStopped:
      UIWidget.Wrap(GPlayButton).Text("Play");
      UIWidget.Wrap(GClipNote).Text(FormatStr("{} stopped", LTitle));
      // Not the Stop button: the clip played to its end. The loop hands over to the next
      // clip (never here: this callback runs inside the video's own UpdateVideo, which must
      // not unload it under its feet)
      if not GStopping then
        GEnded := true;
      end;
  end;
  Wake();
end;

// Clip AIndex of the program shown and played: opened, the bar and the labels set up for it,
// selected in the list, the sound and the loop switch applied
func Show(const AIndex: int32);
begin
  if not GCinema.Open(AIndex) then
    return;
  end;
  GCinema.FVideo.OnStatus(OnVideoStatus);
  GCinema.FVideo.Looping(Rcheckbox_is_checked(GLoopSwitch) <> 0);
  ApplyVolume();
  UIWidget.Wrap(GClipTitle).Text(CLIP_TITLES[AIndex]);
  UIWidget.Wrap(GClipNote).Text(CLIP_NOTES[AIndex]);
  UIWidget.Wrap(GLengthLabel).Text(Clock(GCinema.FLength));
  GShownSecond := -1;
  Rslider_set_value(GSeekBar, 0.0f);
  // FIndex is already AIndex: the list's selection callback sees nothing new to open
  Rlist_view_set_selected(GClipList, AIndex);
  GCinema.FVideo.Play();
  Wake();
end;

// The clip after the one showing (after the last: the first again)
func ShowNext();
begin
  Show((GCinema.FIndex + 1) mod CLIP_COUNT);
end;

// ---------------------------------------------------------------------------
// The actions: one routine per name cinema.xml uses
// ---------------------------------------------------------------------------

func DoPlay(const ASender: UIWidget);
begin
  GCinema.Toggle();
  Wake();
end;

func DoStop(const ASender: UIWidget);
begin
  GStopping := true;
  GCinema.FVideo.Stop();
  GStopping := false;
  Wake();
end;

func DoBack(const ASender: UIWidget);
begin
  GCinema.Jump(-JUMP_SECONDS);
  Wake();
end;

func DoForward(const ASender: UIWidget);
begin
  GCinema.Jump(JUMP_SECONDS);
  Wake();
end;

func DoStart(const ASender: UIWidget);
begin
  GCinema.FVideo.Seek(0.0);
  Wake();
end;

func DoNext(const ASender: UIWidget);
begin
  ShowNext();
end;

// The seek bar moved by the user (a drag, a click on its track, its arrow keys): the clip
// goes there at once. While the mouse button is down the bar is the user's: the loop stops
// moving it with the clip until the button is up.
func DoSeek(const ASender: UIWidget);
begin
  GScrubbing := Mouse.Down(Button.Left);
  GCinema.FVideo.Seek(GCinema.FLength * float64(Rslider_get_value(ASender.Id()) / SEEK_STEPS));
  Wake();
end;

func DoLoop(const ASender: UIWidget);
begin
  GCinema.FVideo.Looping(Rcheckbox_is_checked(ASender.Id()) <> 0);
  Wake();
end;

// The L key: the loop switch flipped as a click would (then its own action applies it)
func DoLoopKey(const ASender: UIWidget);
begin
  if Rcheckbox_is_checked(GLoopSwitch) <> 0 then
    Rcheckbox_set_checked(GLoopSwitch, 0);
  else
    Rcheckbox_set_checked(GLoopSwitch, 1);
  end;
  DoLoop(UIWidget.Wrap(GLoopSwitch));
end;

func DoVolume(const ASender: UIWidget);
begin
  GVolume := Rslider_get_value(ASender.Id()) / 100.0f;
  ApplyVolume();
  Wake();
end;

func DoMute(const ASender: UIWidget);
begin
  GMuted := Rcheckbox_is_checked(ASender.Id()) <> 0;
  ApplyVolume();
  Wake();
end;

// The M key: the mute switch flipped as a click would
func DoMuteKey(const ASender: UIWidget);
begin
  if Rcheckbox_is_checked(GMuteSwitch) <> 0 then
    Rcheckbox_set_checked(GMuteSwitch, 0);
  else
    Rcheckbox_set_checked(GMuteSwitch, 1);
  end;
  DoMute(UIWidget.Wrap(GMuteSwitch));
end;

// Every action name cinema.xml fires, each bound to the routine answering it
func BindActions();
begin
  UIActions.Bind("cinema.play", DoPlay);
  UIActions.Bind("cinema.stop", DoStop);
  UIActions.Bind("cinema.back", DoBack);
  UIActions.Bind("cinema.forward", DoForward);
  UIActions.Bind("cinema.start", DoStart);
  UIActions.Bind("cinema.next", DoNext);
  UIActions.Bind("cinema.seek", DoSeek);
  UIActions.Bind("cinema.loop", DoLoop);
  UIActions.Bind("cinema.loop.key", DoLoopKey);
  UIActions.Bind("cinema.volume", DoVolume);
  UIActions.Bind("cinema.mute", DoMute);
  UIActions.Bind("cinema.mute.key", DoMuteKey);
end;

// Raven's list selection callback (a C callback: `clink`): picking a clip plays it
func clink OnClipSelected(list_view: Rid; index: int32; user_data: ptr);
begin
  if (index >= 0) and (index < CLIP_COUNT) and (index <> GCinema.FIndex) then
    Show(index);
  end;
end;

// The program's list: every clip with its length, each read by opening the clip once
func FillProgram();
var
  LI: int32;
  LText: string;
begin
  Rlist_view_clear_items(GClipList);
  for LI := 0 to CLIP_COUNT - 1 do
    if GCinema.Open(LI) then
      LText := FormatStr("{}   {}", CLIP_TITLES[LI], Clock(GCinema.FLength));
    else
      LText := FormatStr("{}   (missing)", CLIP_TITLES[LI]);
    end;
    Rlist_view_add_item(GClipList, LText);
  end;
  GCinema.Close();
end;

// ---------------------------------------------------------------------------
// Each frame
// ---------------------------------------------------------------------------

// The time label and the seek bar following the clip (the bar not while the user drags it)
func UpdateTransport();
var
  LSecond: int64;
begin
  if GScrubbing and not Mouse.Down(Button.Left) then
    GScrubbing := false;
  end;
  if not GScrubbing then
    // Rslider_set_value never fires the bar's action: only the user's changes seek
    Rslider_set_value(GSeekBar, GCinema.Progress() * SEEK_STEPS);
  end;
  LSecond := Trunc(GCinema.FVideo.Time());
  if LSecond <> GShownSecond then
    GShownSecond := LSecond;
    UIWidget.Wrap(GTimeLabel).Text(Clock(GCinema.FVideo.Time()));
  end;
end;

// The cards fade out while a clip plays and the user rests, and back in when they act
func UpdateFade(const ASeconds: float32);
var
  LMouse: Vector2;
  LTarget: float32;
  LI: int32;
begin
  LMouse := Mouse.Delta();
  if (LMouse.x <> 0.0f) or (LMouse.y <> 0.0f) or Mouse.Down(Button.Left) then
    Wake();
  end;
  GIdle := GIdle + ASeconds;
  LTarget := 1.0f;
  if GCinema.FVideo.Playing() and (GIdle > IDLE_SECONDS) then
    LTarget := 0.0f;
  end;
  // A steady step toward the target, never past it
  if GOpacity < LTarget then
    GOpacity := Min(GOpacity + FADE_SPEED * ASeconds, LTarget);
  else
    GOpacity := Max(GOpacity - FADE_SPEED * ASeconds, LTarget);
  end;
  for LI := 0 to 2 do
    Rwidget_set_opacity(GCards[LI], GOpacity);
  end;
end;

// Where the screen goes: the clip's shape, as large as SCREEN_SHARE of the frame allows,
// centred (base units)
func ScreenRect(): Rectangle;
var
  LRoomWidth: float32;
  LRoomHeight: float32;
  LScale: float32;
  LWidth: float32;
  LHeight: float32;
begin
  LRoomWidth := float32(BASE_WIDTH) * SCREEN_SHARE;
  LRoomHeight := float32(BASE_HEIGHT) * SCREEN_SHARE;
  if (GCinema.FVideo.Width() <= 0) or (GCinema.FVideo.Height() <= 0) then
    // No clip: a 16:9 screen
    LWidth := LRoomWidth;
    LHeight := LRoomWidth * 9.0f / 16.0f;
  else
    LScale := Min(LRoomWidth / float32(GCinema.FVideo.Width()),
      LRoomHeight / float32(GCinema.FVideo.Height()));
    LWidth := float32(GCinema.FVideo.Width()) * LScale;
    LHeight := float32(GCinema.FVideo.Height()) * LScale;
  end;
  return Rectangle(x: (float32(BASE_WIDTH) - LWidth) / 2.0f,
    y: (float32(BASE_HEIGHT) - LHeight) / 2.0f, width: LWidth, height: LHeight);
end;

// The whole frame of the clip, in its own pixels (Draw.Video's source)
func VideoSource(): Rectangle;
begin
  return Rectangle(x: 0.0f, y: 0.0f, width: float32(GCinema.FVideo.Width()),
    height: float32(GCinema.FVideo.Height()));
end;

// The glow: the picture squeezed into the tiny render texture (drawn before the frame begins)
func DrawGlowTexture(const AGlow: RenderTextureRes);
begin
  AGlow.Begin();
  GWin.Clear(BLACK);
  Draw.Video(GCinema.FVideo, VideoSource(),
    Rectangle(x: 0.0f, y: 0.0f, width: float32(GLOW_WIDTH), height: float32(GLOW_HEIGHT)),
    Vector2(x: 0.0f, y: 0.0f), 0.0f, WHITE);
  RenderTextureRes.End();
end;

// The room: the glow stretched over the frame, darkened toward the edges, then the screen
func DrawRoom(const AGlow: RenderTextureRes);
var
  LScreen: Rectangle;
  LText: string;
  LWidth: int32;
begin
  // Draw.Texture shows a render texture the right way up (raylib stores its rows bottom first)
  Draw.Texture(AGlow,
    Rectangle(x: 0.0f, y: 0.0f, width: float32(GLOW_WIDTH), height: float32(GLOW_HEIGHT)),
    Rectangle(x: 0.0f, y: 0.0f, width: float32(BASE_WIDTH), height: float32(BASE_HEIGHT)),
    Vector2(x: 0.0f, y: 0.0f), 0.0f, WHITE.Alpha(GLOW_STRENGTH));
  // The room's dark at the top and the foot, so the screen stands out
  Draw.RectGradientV(Rectangle(x: 0.0f, y: 0.0f, width: float32(BASE_WIDTH),
    height: float32(BASE_HEIGHT div 3)), Color(r: 4, g: 6, b: 12, a: 230),
    Color(r: 4, g: 6, b: 12, a: 0));
  Draw.RectGradientV(Rectangle(x: 0.0f, y: float32(BASE_HEIGHT - BASE_HEIGHT div 3),
    width: float32(BASE_WIDTH), height: float32(BASE_HEIGHT div 3)),
    Color(r: 4, g: 6, b: 12, a: 0), Color(r: 4, g: 6, b: 12, a: 230));
  // The screen: a shadow, its black, then the picture
  LScreen := ScreenRect();
  Draw.RectRounded(Rectangle(x: LScreen.x - 6.0f, y: LScreen.y - 6.0f,
    width: LScreen.width + 12.0f, height: LScreen.height + 12.0f), 0.02f, 8,
    Color(r: 0, g: 0, b: 0, a: 140));
  Draw.Rect(LScreen, BLACK);
  Draw.Video(GCinema.FVideo, VideoSource(), LScreen, Vector2(x: 0.0f, y: 0.0f), 0.0f, WHITE);
  // A stopped clip shows no frame (it is back at its start): say how to start it
  if GCinema.FVideo.Status() = VideoStatus.VideoStopped then
    LText := "Press Space to play";
    LWidth := FontRes.Default().Measure(LText, 28);
    Draw.Text(LText, Vector2(x: float32((BASE_WIDTH - LWidth) div 2),
      y: float32(BASE_HEIGHT div 2 - 14)), 28.0f, Color(r: 200, g: 214, b: 235, a: 255));
  end;
end;

func Run(): int32;
var
  // The sound, open before any clip loads (a clip opened with no audio device plays silent):
  // its last copy, as Run ends, unloads every clip still alive and closes the device
  LAudio: AudioDevice;
  LGlow: RenderTextureRes;
  LLast: bool;
begin
  // The shared assets as the program's files: Raven's layouts and themes are entries of
  // bin\assets.zip, and so are the clips (Examples.Common)
  if not OpenAssets() then
    return 1;
  end;
  defer CloseAssets();

  // The DPI-scaled frame window (AV.12): the base size x the monitor's scale
  GWin := OpenExampleWindow(BASE_WIDTH, BASE_HEIGHT, "Adam - Raven cinema");
  if not GWin.Ready() then
    return 1;
  end;
  GWin.Color := Color(r: 4, g: 6, b: 12, a: 255);
  if not LAudio.Ready() then
    println("raven_cinema: no audio device, the clips play silent");
  end;

  // The glow's tiny texture, smoothed when it is stretched (that is the blur)
  LGlow := RenderTextureRes(GLOW_WIDTH, GLOW_HEIGHT);
  LGlow.Texture().SetFilter(Filter.Bilinear);

  // Raven in raylib's window, its errors on the console, the example themes loaded, Aurora in use
  if not StartRaven("raven_cinema") then
    return 1;
  end;
  defer CloseRaven();
  GControls := LoadWindow(CONTROLS_XML);
  if GControls = R_INVALID_ID then
    return 1;
  end;
  GPlayButton := Find("play");
  GTimeLabel := Find("time");
  GLengthLabel := Find("length");
  GSeekBar := Find("seek");
  GClipList := Find("clips");
  GClipTitle := Find("clip_title");
  GClipNote := Find("clip_note");
  GLoopSwitch := Find("loop");
  GMuteSwitch := Find("mute");
  GCards[0] := Find("now_card");
  GCards[1] := Find("program_card");
  GCards[2] := Find("transport_card");
  BindActions();

  // The clip showing is closed before Raven and the window go (defers run in reverse)
  GCinema.FIndex := -1;
  defer GCinema.Close();
  GVolume := float32(START_VOLUME) / 100.0f;
  GMuted := false;
  GOpacity := 1.0f;
  FillProgram();
  // The first clip plays at once; the list's callback only after it, so selecting it here
  // opens nothing twice
  Show(0);
  Rlist_view_set_selection_changed_callback(GClipList, OnClipSelected, nil);

  // The loop runs until the window is closed; that last frame is still drawn, and saved as the
  // example's snapshot (raven_cinema.png beside this file) before it is shown
  LLast := false;
  while not LLast do
    LLast := not GWin.Running();
    // Raven first: the clicks and keys of this frame run their actions
    UpdateRaven(GControls);
    // A clip that played to its end hands over to the next (its loop switch off)
    if GEnded then
      GEnded := false;
      ShowNext();
    end;
    // The clip decodes this frame's picture and sound
    GCinema.FVideo.Update();
    UpdateTransport();
    UpdateFade(Time.Delta());
    DrawGlowTexture(LGlow);
    // F11 / Alt+Enter: borderless fullscreen and back (Examples.Common)
    ExampleFullscreenKeys(GWin);
    GWin.BeginFrame();
    DrawRoom(LGlow);
    // The controls over the picture, in base units
    DrawRaven(GControls);
    // The finished frame, saved before EndFrame shows it (Examples.Common)
    if LLast then
      SaveExampleSnapshot(GWin, SNAPSHOT_NAME);
    end;
    GWin.EndFrame();
  end;
  return 0;
end;

begin
  return Run();
end.
