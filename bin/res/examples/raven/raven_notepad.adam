  Mozilla Public License, v. 2.0. If a copy of the MPL
  was not distributed with this file, You can obtain one
  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raven_notepad.adam - a real text editor in one Adam file: Raven's
  TextEditor in a DPI-scaled raylib frame, with Adam itself as a syntax.

  WHAT IT SHOWS
  - Raven's TextEditor (ui\notepad.xml): syntax colors, line numbers, word
    wrap, zoom, auto-pairs, its own undo / redo, a monospace font from the
    shared assets.
  - Adam as a language of the editor: Rlanguage_register teaches Raven
    Adam's keywords, types, constants, comments and strings, and .adam files
    open colored. C, JSON, XML and Markdown come with Raven.
  - Files: New, Open, Save, Save As with Raven's FileBrowser shown as a
    dialog inside the window (ui\notepad_file.xml, Rdialog_open), the text
    read and written through System.IO (ReadAllText / WriteAllText), the
    file's line ends (CRLF or LF) kept as they were.
  - "Save changes?" (ui\notepad_confirm.xml) before New, Open or Quit throw
    away unsaved text, the window's close button and Esc included; the title
    shows an asterisk while the text is changed.
  - Find / replace: a bar that flies down (Ctrl+F, Ctrl+H), next / previous
    with wrap-around, match case, replace one, replace all as one undo step.
  - Live themes (View > Theme), the status bar (line, column, line ends,
    language).
  - Its last frame is saved as raven_notepad.png beside this file when it
    exits (Examples.Common's SaveExampleSnapshot), the picture a user sees
    while browsing the examples.

  - F11 or Alt+Enter: borderless fullscreen and back, the frame letterboxed
    on the whole monitor (Examples.Common's ExampleFullscreenKeys).
  ADAM FEATURES ON SHOW
  - Objects with static methods and OVERLOADED methods: Document.Untitled()
    makes an empty document; Document.Save() writes it where it came from,
    Document.Save(APath) writes it somewhere new: one name, two forms.
  - choices + match: PendingStep (what to do once "save changes?" is
    answered) and the dialog answers are choices values picked by match.
  - Routine values: every Raven action name is bound to the Adam routine
    answering it (System.Raven.Ext's UIActions.Bind;
    UIActions.BindPrefix for "notepad.lang.<Language>" / "notepad.use.<Theme>");
    the editor's changes and the dialogs' close are routines too
    (UITextEditor.OnChanged, UIWindow.Dialog).
  - Closures: the file browser's Open and Cancel are `func` literals that
    capture the dialog they close (UIFileBrowser.OnAccept / OnCancel).
  - Typed widgets: each widget is kept as what it is (UITextEditor,
    UITextInput, UICheckBox ..: UIWindow.Find<T> checks the kind), worked
    through its own methods, the editor's places as UITextPos / UITextSpan
    records; no handle or C call by hand.
  - Shared code at two levels: examples\common\Examples.Common.adam for what
    the examples share (OpenAssets, OpenExampleWindow, OpenExampleUI,
    SaveExampleSnapshot), the std for
    what any program can use (System.Raven.Ext's UIWidget Text, UIActions,
    ReplaceStr for the line ends).
  - List<string>: the files opened, newest first (File > recent in the
    status), and Map<string, int64>: how often each text was searched.
  - defer: the zip and Raven released right where they open, in reverse;
    the Window (System.Raylib.Ext) closes itself with its last copy.
  - Raw strings R"(...)": the welcome text, written as it shows.
  - FormatStr for every message; @exeicon for the program's icon.

  BUILD AND RUN (from repo\bin, the folder of adam.exe and assets.zip)
    adam build res\examples\raven\raven_notepad.adam -o output -r
  -r runs the program once built. For linux add -t x86_64-linux-gnu: on
  Windows -r runs the linux build through WSL2 (its display, WSLg), on
  linux natively.
*******************************************************************************/

module exe raven_notepad;

// Adam's icon on the exe and on its window ($P: is adam.exe's folder)
@exeicon "$P:res/assets/icons/adam.ico";

// The examples' shared unit (Examples.Common) lives in res\examples\common
@addmodulepath "$P:res/examples/common";

// System.Math before System.Raylib.C: a bare name two imports export is the last one's (BNF
// sec 1), so raylib's Vector2 / Color are the ones used here
import System.SysUtils, System.Math, System.IO, System.Collections, System.CustomIO, System.HookIO,
  System.Raylib.C, System.Raylib.Ext, System.Raven.Ext, System.Raven.Raylib,
  Examples.Common;

const
  // Entries of the zip, by their own names (the zip is the path source, Examples.Common's
  // OpenAssets)
  NOTEPAD_XML: string = "res/assets/ui/notepad.xml";
  FILE_DIALOG_XML: string = "res/assets/ui/notepad_file.xml";
  CONFIRM_DIALOG_XML: string = "res/assets/ui/notepad_confirm.xml";
  // This example under res\examples, for its snapshot (Examples.Common's SaveExampleSnapshot)
  SNAPSHOT_NAME: string = "raven/raven_notepad";
  // The frame's base size (the Window opens at this x the monitor's scale)
  BASE_WIDTH: int32 = 1100;
  BASE_HEIGHT: int32 = 720;
  // Action names that carry their argument after a prefix
  LANGUAGE_PREFIX: string = "notepad.lang.";
  THEME_PREFIX: string = "notepad.use.";
  // The editor's zoom steps and limits
  ZOOM_STEP: float32 = 0.1f;
  ZOOM_MIN: float32 = 0.5f;
  ZOOM_MAX: float32 = 3.0f;
  // The most files the recent list keeps
  MAX_RECENT: int64 = 8;
  // What a new document holds: written here as it shows (a raw string: nothing is escaped)
  WELCOME_TEXT: string = R"(// Welcome to Adam Notepad: Raven's TextEditor, driven by Adam.
//
// Ctrl+O opens a file, Ctrl+S saves, Ctrl+F finds, Ctrl+H replaces.
// .adam files are colored as Adam: the language is registered at start.

module exe hello;

import System.SysUtils;

func Greet(const AName: string): string;
begin
  return FormatStr("Hello, {}!", AName);
end;

begin
  defer println("bye");
  println(Greet("Adam"));
end.
)";

  // Adam for Raven's editor: words separated by spaces (BNF.md's keywords and type names)
  ADAM_KEYWORDS: string = "module exe dll lib unit import initialize finalize begin end var const " +
    "type func forward method public clink cpplink external record object overlay choices " +
    "array of ptr to set packed align if then else while do for downto repeat until match guard " +
    "except finally return leave skip or and xor not in shl shr div mod addr self parent varargs " +
    "test default threadstatic operator virtual override final static property defer yield " +
    "sequence async await parallel lock own ref weak noreturn mutex";
  ADAM_TYPES: string = "bool char wchar string wstring int8 int16 int32 int64 uint8 uint16 " +
    "uint32 uint64 float32 float64 clong culong ptr List Map Set println print FormatStr len";
  ADAM_CONSTANTS: string = "true false nil";

type
  // What waits for the "save changes?" dialog's answer
  PendingStep = choices(Nothing, NewDocument, OpenFile, Quit);

  // How the "save changes?" dialog was answered (its Rdialog_close results)
  ConfirmAnswer = choices(Cancel, Save, Discard);

  // Which file dialog is open
  FileDialogKind = choices(Open, SaveAs);

  // The document being edited: where it lives and how its lines end.
  // The text itself is the editor's: Raven holds it, undo history included.
  Document = object
    FPath: string;
    FCrlf: bool;
    FDirty: bool;

    // A new, empty, unnamed document. A static method: called on the type, Document.Untitled()
    static method Untitled(): Document;
    var
      LDocument: Document;
    begin
      LDocument.FPath := "";
      // A new file takes the host's line ends
      @ifdef TARGET_X86_64_WINDOWS_GNU
      LDocument.FCrlf := true;
      @else
      LDocument.FCrlf := false;
      @endif
      LDocument.FDirty := false;
      return LDocument;
    end;

    // The name shown in the title: the file's name, or "Untitled"
    method DisplayName(): string;
    begin
      if len(self.FPath) = 0 then
        return "Untitled";
      end;
      return ExtractFileName(self.FPath);
    end;

    // Writes AText where the document came from. False with no path yet (Save As first) or when
    // the write failed
    method Save(const AText: string): bool;
    begin
      if len(self.FPath) = 0 then
        return false;
      end;
      return self.Save(self.FPath, AText);
    end;

    // Writes AText to APath, which becomes the document's file: an overload of Save, one name
    // for one job (AD.9). The editor works in LF line ends: a CRLF file gets its CR LF back
    method Save(const APath: string; const AText: string): bool;
    var
      LText: string;
    begin
      LText := AText;
      if self.FCrlf then
        LText := ReplaceStr(AText, "\n", "\r\n");
      end;
      if not WriteAllText(APath, LText) then
        return false;
      end;
      self.FPath := APath;
      self.FDirty := false;
      return true;
    end;
  end;

var
  // The Raven window and the widgets the program reads or writes
  // (each a typed widget: Find<T> checked its kind when it was found)
  GUI: UIWindow;
  GEditor: UITextEditor;
  GStatus: UILabel;
  GPosition: UILabel;
  GLineEnds: UILabel;
  GLanguage: UILabel;
  GFindBar: UIWidget;
  GReplaceRow: UIWidget;
  GFindText: UITextInput;
  GReplaceText: UITextInput;
  GMatchCase: UICheckBox;
  // The document and the program's state
  GDocument: Document;
  GRecent: List<string>;
  GSearches: Map<string, int64>;
  GPending: PendingStep;
  GFileDialog: FileDialogKind;
  GDialogOpen: bool;
  // The path the file browser accepted, read in its closure (the dialog is deleted on close)
  GChosenPath: string;
  // The folder the file browser opens in: the last one used
  GLastDir: string;
  // The filters the file browser offers, in its order
  GFilters: array[0..4] of UIFileFilter;
  // Set when the program is to end at the next frame
  GQuit: bool;
  // The title shown last, so the window's title is only set when it changes
  GShownTitle: string;
  // The DPI-scaled frame window (its last copy, at the program's end, closes it)
  GWin: Window;
  // Setting the editor's text from the program is not a user's change
  GLoading: bool;

// ---------------------------------------------------------------------------
// Text helpers
// ---------------------------------------------------------------------------

// The byte offset in AText of line ALine, column AColumn (both from 0, columns in bytes, as
// Raven's editor counts them)
func OffsetOf(const AText: string; const ALine: int32; const AColumn: int32): int64;
var
  LLine: int32;
  LAt: int64;
begin
  LLine := 0;
  LAt := 0;
  while (LLine < ALine) and (LAt < len(AText)) do
    if AText[LAt] = '\n' then
      LLine := LLine + 1;
    end;
    LAt := LAt + 1;
  end;
  return LAt + int64(AColumn);
end;

// The line and column of byte offset AOffset in AText (the reverse of OffsetOf)
func PlaceOf(const AText: string; const AOffset: int64; var ALine: int32; var AColumn: int32);
var
  LAt: int64;
  LLineStart: int64;
begin
  ALine := 0;
  LLineStart := 0;
  for LAt := 0 to AOffset - 1 do
    if AText[LAt] = '\n' then
      ALine := ALine + 1;
      LLineStart := LAt + 1;
    end;
  end;
  AColumn := int32(AOffset - LLineStart);
end;

// ---------------------------------------------------------------------------
// The window's parts
// ---------------------------------------------------------------------------

func SetStatus(const AText: string);
begin
  GStatus.Text(AText);
end;

// The editor's whole text (System.Raven.Ext's UIWidget.Text reads any widget's text)
func EditorText(): string;
begin
  return GEditor.Text();
end;

// Puts AText in the editor as a fresh document's text (not a change of the user's)
func LoadEditor(const AText: string);
begin
  GLoading := true;
  defer GLoading := false;
  GEditor.Text(AText);
  GEditor.Cursor(UITextPos(Line: 0, Column: 0)).ScrollToLine(0);
end;

// Names the editor's language ("None" for plain text) and shows it in the status bar
func SetLanguage(const AName: string);
begin
  GEditor.Language(AName);
  if AName = "None" then
    GLanguage.Text("Plain text");
  else
    GLanguage.Text(AName);
  end;
end;

// The language Raven knows for APath's extension (Adam's included once registered), else none
func LanguageFor(const APath: string): string;
var
  LName: string;
begin
  LName := UISyntaxLanguage.ForFile(APath);
  if len(LName) = 0 then
    return "None";
  end;
  return LName;
end;

// The window's title: the document's name, an asterisk while it has unsaved changes
func UpdateTitle();
var
  LTitle: string;
begin
  LTitle := FormatStr("{} - Adam Notepad", GDocument.DisplayName());
  if GDocument.FDirty then
    LTitle := "*" + LTitle;
  end;
  if LTitle = GShownTitle then
    return;
  end;
  GShownTitle := LTitle;
  GWin.SetTitle(LTitle);
end;

// The cursor's line and column in the status bar (both from 1, as people count)
func UpdatePosition();
var
  LAt: UITextPos;
begin
  LAt := GEditor.Cursor();
  GPosition.Text(FormatStr("Ln {}, Col {}", LAt.Line + 1, LAt.Column + 1));
end;

func UpdateLineEnds();
begin
  if GDocument.FCrlf then
    GLineEnds.Text("CRLF");
  else
    GLineEnds.Text("LF");
  end;
end;

// Every change of the editor's text (a routine value, set by UITextEditor.OnChanged)
func OnEditorChanged();
begin
  if not GLoading then
    GDocument.FDirty := true;
  end;
end;

// ---------------------------------------------------------------------------
// Documents: new, open, save
// ---------------------------------------------------------------------------

// A path put first in the recent list (once), the list cut to MAX_RECENT
func RememberRecent(const APath: string);
var
  LAt: int64;
begin
  LAt := GRecent.IndexOf(APath);
  if LAt >= 0 then
    GRecent.Delete(LAt);
  end;
  GRecent.Insert(0, APath);
  while GRecent.Count > MAX_RECENT do
    GRecent.RemoveLast();
  end;
end;

func DoNewDocument();
begin
  GDocument := Document.Untitled();
  LoadEditor(WELCOME_TEXT);
  SetLanguage("Adam");
  UpdateLineEnds();
  SetStatus("A new document");
end;

// Opens APath into the editor; its line ends and its language follow the file
func DoOpenPath(const APath: string);
var
  LText: string;
  LCrlf: bool;
begin
  if not ReadAllText(APath, LText) then
    SetStatus(FormatStr("Could not read {}", APath));
    return;
  end;
  GDocument := Document.Untitled();
  GDocument.FPath := APath;
  // The editor works in LF: a CRLF file is shown with LF and remembered as CRLF for saving
  LCrlf := IndexOf("\r\n", LText, 0) >= 0;
  LoadEditor(ReplaceStr(LText, "\r\n", "\n"));
  GDocument.FCrlf := LCrlf;
  GLastDir := ExtractFileDir(APath);
  RememberRecent(APath);
  SetLanguage(LanguageFor(APath));
  UpdateLineEnds();
  SetStatus(FormatStr("Opened {} ({} bytes); {} recent file(s)", APath, len(LText), GRecent.Count));
end;

// The file dialog, declared ahead: RunPending opens it, and its body follows the routine
// answering its close
forward func OpenFileDialog(const AKind: FileDialogKind);

// What waits for an answer, run once the document is saved or its changes thrown away
func RunPending();
var
  LStep: PendingStep;
begin
  LStep := GPending;
  GPending := PendingStep.Nothing;
  match LStep of
    // Nothing waited: nothing to run
    PendingStep.Nothing:
    PendingStep.NewDocument: DoNewDocument();
    PendingStep.OpenFile: OpenFileDialog(FileDialogKind.Open);
    PendingStep.Quit: GQuit := true;
  end;
end;

// The file dialog closed: AResult 1 with a path chosen, else cancelled
func OnFileDialogClosed(const AResult: int32);
begin
  GDialogOpen := false;
  if (AResult <> 1) or (len(GChosenPath) = 0) then
    // A cancelled Save As cancels what waited for it too
    GPending := PendingStep.Nothing;
    SetStatus("Cancelled");
    return;
  end;
  match GFileDialog of
    FileDialogKind.Open: DoOpenPath(GChosenPath);
    FileDialogKind.SaveAs:
      if GDocument.Save(GChosenPath, EditorText()) then
        GLastDir := ExtractFileDir(GChosenPath);
        RememberRecent(GChosenPath);
        SetLanguage(LanguageFor(GChosenPath));
        SetStatus(FormatStr("Saved {}", GChosenPath));
        RunPending();
      else
        GPending := PendingStep.Nothing;
        SetStatus(FormatStr("Could not write {}", GChosenPath));
      end;
  end;
end;

// Shows Raven's file browser as a dialog inside the window, to open or to save as
func OpenFileDialog(const AKind: FileDialogKind);
var
  LContent: UIWidget;
  LBrowser: UIFileBrowser;
begin
  if GDialogOpen then
    return;
  end;
  LContent := UIWidget.FromXML(FILE_DIALOG_XML);
  if not LContent.IsValid() then
    SetStatus(FormatStr("{} did not load", FILE_DIALOG_XML));
    return;
  end;
  LBrowser := LContent.Find<UIFileBrowser>("browser");
  GFileDialog := AKind;
  GChosenPath := "";
  match AKind of
    FileDialogKind.Open:
      LContent.Find<UILabel>("dialog_title").Text("OPEN A FILE");
      LBrowser.Mode(UIBrowserMode.Open);
    FileDialogKind.SaveAs:
      LContent.Find<UILabel>("dialog_title").Text("SAVE AS");
      LBrowser.Mode(UIBrowserMode.Save).FileName(GDocument.DisplayName()).DefaultExtension("adam");
  end;
  LBrowser.Directory(GLastDir);
  LBrowser.Filters(GFilters);
  // The browser's Open / Save and Cancel as closures: each captures LContent (by reference: the
  // closure keeps it alive) to close its own dialog. The path is read here, since the dialog
  // (browser included) is deleted when it closes
  LBrowser.OnAccept(func(const APath: string)
    begin
      GChosenPath := APath;
      UIWindow.CloseDialog(LContent, 1);
    end);
  LBrowser.OnCancel(func()
    begin
      GChosenPath := "";
      UIWindow.CloseDialog(LContent, 0);
    end);
  GDialogOpen := true;
  // Raven owns the content from here: it is deleted when the dialog closes
  GUI.Dialog(LContent, OnFileDialogClosed);
end;

// Saves the document where it lives, or asks where (Save As) when it has no file yet.
// True when it is saved now (false: not saved, or a Save As dialog is open)
func SaveDocument(): bool;
begin
  if len(GDocument.FPath) = 0 then
    OpenFileDialog(FileDialogKind.SaveAs);
    return false;
  end;
  if not GDocument.Save(EditorText()) then
    SetStatus(FormatStr("Could not write {}", GDocument.FPath));
    return false;
  end;
  SetStatus(FormatStr("Saved {}", GDocument.FPath));
  return true;
end;

// The "save changes?" dialog closed: its result is a ConfirmAnswer
func OnConfirmClosed(const AResult: int32);
var
  LAnswer: ConfirmAnswer;
begin
  GDialogOpen := false;
  LAnswer := ConfirmAnswer.Cancel;
  if AResult = 1 then
    LAnswer := ConfirmAnswer.Save;
  end;
  if AResult = 2 then
    LAnswer := ConfirmAnswer.Discard;
  end;
  match LAnswer of
    ConfirmAnswer.Cancel:
      GPending := PendingStep.Nothing;
      SetStatus("Cancelled");
    ConfirmAnswer.Discard:
      GDocument.FDirty := false;
      RunPending();
    ConfirmAnswer.Save:
      // Saved now: go on; a Save As dialog opened instead goes on when it is answered
      if SaveDocument() then
        RunPending();
      end;
  end;
end;

// Runs AStep now when nothing is unsaved, else asks first ("save changes?")
func AfterSaving(const AStep: PendingStep);
var
  LContent: UIWidget;
begin
  if GDialogOpen then
    return;
  end;
  GPending := AStep;
  if not GDocument.FDirty then
    RunPending();
    return;
  end;
  LContent := UIWidget.FromXML(CONFIRM_DIALOG_XML);
  if not LContent.IsValid() then
    SetStatus(FormatStr("{} did not load", CONFIRM_DIALOG_XML));
    return;
  end;
  LContent.Find<UILabel>("confirm_text").Text(FormatStr("{} has unsaved changes. Save them first?", GDocument.DisplayName()));
  GDialogOpen := true;
  GUI.Dialog(LContent, OnConfirmClosed);
end;

// ---------------------------------------------------------------------------
// Find and replace
// ---------------------------------------------------------------------------

func FindTerm(): string;
begin
  return GFindText.Text();
end;

// AText to compare with: lower case when the search ignores case
func Folded(const AText: string): string;
begin
  if GMatchCase.Checked() then
    return AText;
  end;
  return LowerCase(AText);
end;

// Selects ACount bytes of AText at AOffset in the editor and shows them
func SelectFound(const AText: string; const AOffset: int64; const ACount: int64);
var
  LFromLine: int32;
  LFromColumn: int32;
  LToLine: int32;
  LToColumn: int32;
begin
  PlaceOf(AText, AOffset, LFromLine, LFromColumn);
  PlaceOf(AText, AOffset + ACount, LToLine, LToColumn);
  GEditor.Select(UITextSpan(First: UITextPos(Line: LFromLine, Column: LFromColumn),
    Last: UITextPos(Line: LToLine, Column: LToColumn))).ScrollToLine(LFromLine);
end;

// Finds the term after (AForward) or before the cursor, wrapping round the text's ends
func FindStep(const AForward: bool);
var
  LTerm: string;
  LText: string;
  LHaystack: string;
  LNeedle: string;
  LSpan: UITextSpan;
  LStart: int64;
  LAt: int64;
  LLast: int64;
  LCount: int64;
begin
  LTerm := FindTerm();
  if len(LTerm) = 0 then
    SetStatus("Type the text to find first");
    return;
  end;
  // How often each text was searched: a Map read and written by key
  LCount := 0;
  GSearches.TryGet(LTerm, LCount);
  GSearches[LTerm] := LCount + 1;
  LText := EditorText();
  LHaystack := Folded(LText);
  LNeedle := Folded(LTerm);
  // The selection's ends (the cursor's place twice when nothing is selected)
  if GEditor.HasSelection() then
    LSpan := GEditor.Selection();
  else
    LSpan.First := GEditor.Cursor();
    LSpan.Last := LSpan.First;
  end;
  if AForward then
    // After the selection; from the top again when nothing follows it
    LStart := OffsetOf(LText, LSpan.Last.Line, LSpan.Last.Column);
    LAt := IndexOf(LNeedle, LHaystack, LStart);
    if LAt < 0 then
      LAt := IndexOf(LNeedle, LHaystack, 0);
    end;
  else
    // The last one starting before the selection; from the end again when there is none
    LStart := OffsetOf(LText, LSpan.First.Line, LSpan.First.Column);
    LLast := -1;
    LAt := IndexOf(LNeedle, LHaystack, 0);
    while (LAt >= 0) and (LAt < LStart) do
      LLast := LAt;
      LAt := IndexOf(LNeedle, LHaystack, LAt + 1);
    end;
    if LLast < 0 then
      // None before: the last one in the whole text
      while LAt >= 0 do
        LLast := LAt;
        LAt := IndexOf(LNeedle, LHaystack, LAt + 1);
      end;
    end;
    LAt := LLast;
  end;
  if LAt < 0 then
    SetStatus(FormatStr("'{}' is not in the text", LTerm));
    return;
  end;
  SelectFound(LText, LAt, len(LTerm));
  SetStatus(FormatStr("Found '{}' (searched {} time(s))", LTerm, LCount + 1));
end;

// Replaces the selection when it is the term, then finds the next one
func ReplaceOne();
var
  LTerm: string;
  LReplacement: string;
begin
  LTerm := FindTerm();
  if len(LTerm) = 0 then
    SetStatus("Type the text to find first");
    return;
  end;
  if Folded(GEditor.SelectedText()) = Folded(LTerm) then
    // Typing over a selection replaces it: one undo step
    LReplacement := GReplaceText.Text();
    GEditor.Insert(LReplacement);
  end;
  FindStep(true);
end;

// Replaces every match at once: the whole text selected and typed over, so one undo takes the
// whole replace back
func ReplaceAll();
var
  LTerm: string;
  LReplacement: string;
  LText: string;
  LHaystack: string;
  LNeedle: string;
  LResult: string;
  LFrom: int64;
  LAt: int64;
  LCount: int64;
begin
  LTerm := FindTerm();
  if len(LTerm) = 0 then
    SetStatus("Type the text to find first");
    return;
  end;
  LReplacement := GReplaceText.Text();
  LText := EditorText();
  LHaystack := Folded(LText);
  LNeedle := Folded(LTerm);
  LResult := "";
  LFrom := 0;
  LCount := 0;
  LAt := IndexOf(LNeedle, LHaystack, 0);
  while LAt >= 0 do
    LResult := LResult + Substring(LText, LFrom, LAt - LFrom) + LReplacement;
    LFrom := LAt + len(LTerm);
    LCount := LCount + 1;
    LAt := IndexOf(LNeedle, LHaystack, LFrom);
  end;
  if LCount = 0 then
    SetStatus(FormatStr("'{}' is not in the text", LTerm));
    return;
  end;
  LResult := LResult + Substring(LText, LFrom, len(LText) - LFrom);
  GEditor.SelectAll().Insert(LResult);
  SetStatus(FormatStr("Replaced {} time(s): Undo takes it all back", LCount));
end;

// Shows the find bar, with the replace row when AReplace, the cursor in the find field
func ShowFindBar(const AReplace: bool);
var
  LSelected: string;
begin
  GFindBar.Show();
  if AReplace then
    GReplaceRow.Show();
  else
    GReplaceRow.Collapse();
  end;
  // A one-line selection becomes the term to find
  LSelected := GEditor.SelectedText();
  if (len(LSelected) > 0) and (IndexOf("\n", LSelected, 0) < 0) then
    GFindText.Text(LSelected);
  end;
  GFindText.Focus();
  GFindText.SelectAll();
end;

// ---------------------------------------------------------------------------
// The actions
// ---------------------------------------------------------------------------

func DoNew(const ASender: UIWidget);
begin
  AfterSaving(PendingStep.NewDocument);
end;

func DoOpen(const ASender: UIWidget);
begin
  AfterSaving(PendingStep.OpenFile);
end;

func DoSave(const ASender: UIWidget);
begin
  SaveDocument();
end;

func DoSaveAs(const ASender: UIWidget);
begin
  OpenFileDialog(FileDialogKind.SaveAs);
end;

func DoQuit(const ASender: UIWidget);
begin
  AfterSaving(PendingStep.Quit);
end;

func DoUndo(const ASender: UIWidget);
begin
  GEditor.Undo();
end;

func DoRedo(const ASender: UIWidget);
begin
  GEditor.Redo();
end;

func DoSelectAll(const ASender: UIWidget);
begin
  GEditor.SelectAll();
end;

func DoFind(const ASender: UIWidget);
begin
  ShowFindBar(false);
end;

func DoReplace(const ASender: UIWidget);
begin
  ShowFindBar(true);
end;

func DoFindNext(const ASender: UIWidget);
begin
  FindStep(true);
end;

func DoFindPrevious(const ASender: UIWidget);
begin
  FindStep(false);
end;

func DoFindClose(const ASender: UIWidget);
begin
  GFindBar.Collapse();
  GEditor.Focus();
end;

func DoReplaceOne(const ASender: UIWidget);
begin
  ReplaceOne();
end;

func DoReplaceAll(const ASender: UIWidget);
begin
  ReplaceAll();
end;

// The checkable View items: their check mark is the setting
func DoWrap(const ASender: UIWidget);
begin
  GEditor.WordWrap(ASender.As<UIMenuItem>().Checked());
end;

func DoNumbers(const ASender: UIWidget);
begin
  GEditor.LineNumbers(ASender.As<UIMenuItem>().Checked());
end;

// Zooms by AStep, held between ZOOM_MIN and ZOOM_MAX (0: back to 1)
func ZoomBy(const AStep: float32);
var
  LZoom: float32;
begin
  LZoom := 1.0f;
  if AStep <> 0.0f then
    LZoom := Clamp(GEditor.Zoom() + AStep, ZOOM_MIN, ZOOM_MAX);
  end;
  GEditor.Zoom(LZoom);
  SetStatus(FormatStr("Zoom {}%", Floor(LZoom * 100.0f + 0.5f)));
end;

func DoZoomIn(const ASender: UIWidget);
begin
  ZoomBy(ZOOM_STEP);
end;

func DoZoomOut(const ASender: UIWidget);
begin
  ZoomBy(-ZOOM_STEP);
end;

func DoZoomReset(const ASender: UIWidget);
begin
  ZoomBy(0.0f);
end;

func DoConfirmSave(const ASender: UIWidget);
begin
  UIWindow.CloseDialog(ASender, 1);
end;

func DoConfirmDiscard(const ASender: UIWidget);
begin
  UIWindow.CloseDialog(ASender, 2);
end;

func DoConfirmCancel(const ASender: UIWidget);
begin
  UIWindow.CloseDialog(ASender, 0);
end;

// "notepad.lang.<Language>" (View > Language): the language's name is the argument
func DoUseLanguage(const ASender: UIWidget; const ALanguage: string);
begin
  SetLanguage(ALanguage);
end;

// "notepad.use.<Theme>" (View > Theme): the theme's name is the argument
func DoUseTheme(const ASender: UIWidget; const ATheme: string);
begin
  if UITheme.Use(ATheme) then
    SetStatus(FormatStr("Theme {} in use", ATheme));
  end;
end;

// Every action name the layouts fire, each bound to the routine answering it (Examples.Common)
func BindActions();
begin
  UIActions.Bind("notepad.new", DoNew);
  UIActions.Bind("notepad.open", DoOpen);
  UIActions.Bind("notepad.save", DoSave);
  UIActions.Bind("notepad.save_as", DoSaveAs);
  UIActions.Bind("notepad.quit", DoQuit);
  UIActions.Bind("notepad.undo", DoUndo);
  UIActions.Bind("notepad.redo", DoRedo);
  UIActions.Bind("notepad.select_all", DoSelectAll);
  UIActions.Bind("notepad.find", DoFind);
  UIActions.Bind("notepad.replace", DoReplace);
  UIActions.Bind("notepad.find_next", DoFindNext);
  UIActions.Bind("notepad.find_previous", DoFindPrevious);
  UIActions.Bind("notepad.find_close", DoFindClose);
  UIActions.Bind("notepad.replace_one", DoReplaceOne);
  UIActions.Bind("notepad.replace_all", DoReplaceAll);
  UIActions.Bind("notepad.wrap", DoWrap);
  UIActions.Bind("notepad.numbers", DoNumbers);
  UIActions.Bind("notepad.zoom_in", DoZoomIn);
  UIActions.Bind("notepad.zoom_out", DoZoomOut);
  UIActions.Bind("notepad.zoom_reset", DoZoomReset);
  UIActions.Bind("notepad.confirm.save", DoConfirmSave);
  UIActions.Bind("notepad.confirm.discard", DoConfirmDiscard);
  UIActions.Bind("notepad.confirm.cancel", DoConfirmCancel);
  UIActions.BindPrefix(LANGUAGE_PREFIX, DoUseLanguage);
  UIActions.BindPrefix(THEME_PREFIX, DoUseTheme);
end;

// Teaches Raven's editor Adam: its keywords, types, constants, comments and strings, for files
// ending in .adam (UISyntaxLanguage.Register: Raven copies the description's texts)
func RegisterAdam();
var
  LAdam: UILanguageDef;
begin
  LAdam.Name := "Adam";
  LAdam.Extensions := "adam";
  LAdam.Keywords := ADAM_KEYWORDS;
  LAdam.Types := ADAM_TYPES;
  LAdam.Constants := ADAM_CONSTANTS;
  LAdam.LineComment := "//";
  LAdam.BlockCommentStart := "/*";
  LAdam.BlockCommentEnd := "*/";
  LAdam.StringQuotes := "\"'";
  LAdam.MultilineStrings := "R\"(...)\"";
  // Adam's directives (@exeicon, @ifdef ..) start with @
  LAdam.Annotation := "@";
  LAdam.Flags := [UILanguageFlag.CharLiterals];
  if not UISyntaxLanguage.Register(LAdam) then
    println("raven_notepad: Raven did not take the Adam language");
  end;
end;

// The file browser's filters, in the order it offers them
func MakeFilters();
begin
  GFilters[0].Name := "Adam source";
  GFilters[0].Patterns := "*.adam";
  GFilters[1].Name := "Text";
  GFilters[1].Patterns := "*.txt;*.md";
  GFilters[2].Name := "Data";
  GFilters[2].Patterns := "*.json;*.xml;*.toml";
  GFilters[3].Name := "C";
  GFilters[3].Patterns := "*.c;*.h";
  GFilters[4].Name := "All files";
  GFilters[4].Patterns := "*";
end;

// ---------------------------------------------------------------------------
// The program
// ---------------------------------------------------------------------------

func Run(): int32;
var
  LHost: RaylibHost;
begin
  // The shared assets as the program's files: raylib's and Raven's own file opens read the zip
  // by entry name, while the documents go through System.IO, which reads the real disk
  if not OpenAssets() then
    return 1;
  end;
  defer CloseAssets();

  // The DPI-scaled frame window (AV.12): the base size x the monitor's scale
  GWin := OpenExampleWindow(BASE_WIDTH, BASE_HEIGHT, "Adam Notepad");
  if not GWin.Ready() then
    return 1;
  end;
  // Esc belongs to the editor (it closes the find bar), not to raylib's quit
  GWin.SetExitKey(Key.Null);

  // Raven in raylib's window, its errors on the console, the example themes loaded, Aurora in use
  LHost := OpenExampleUI(GWin, "raven_notepad");
  if not LHost.IsValid() then
    return 1;
  end;
  defer LHost.Close();

  // Adam before the window: the editor's Language="Adam" names it
  RegisterAdam();
  MakeFilters();

  GUI := UIWindow.FromXML(NOTEPAD_XML);
  if not GUI.IsValid() then
    return 1;
  end;
  // Each widget by its XML name, as what it is (Find<T> checks the kind)
  GEditor := GUI.Find<UITextEditor>("editor");
  GStatus := GUI.Find<UILabel>("status");
  GPosition := GUI.Find<UILabel>("position");
  GLineEnds := GUI.Find<UILabel>("line_ends");
  GLanguage := GUI.Find<UILabel>("language");
  GFindBar := GUI.Find<UIWidget>("findbar");
  GReplaceRow := GUI.Find<UIWidget>("replace_row");
  GFindText := GUI.Find<UITextInput>("find_text");
  GReplaceText := GUI.Find<UITextInput>("replace_text");
  GMatchCase := GUI.Find<UICheckBox>("match_case");
  // Fluent: each setter returns the editor, so the calls chain
  GEditor.OnChanged(OnEditorChanged).AutoPairs(true);
  BindActions();

  GLastDir := ExeDir();
  GPending := PendingStep.Nothing;
  DoNewDocument();
  SetStatus("Ready: Ctrl+O opens, Ctrl+S saves, Ctrl+F finds");
  GEditor.Focus();

  while not GQuit do
    // The window's close button (or the OS asking) goes through "save changes?" like Quit
    if not GWin.Running() then
      AfterSaving(PendingStep.Quit);
    end;
    LHost.Update(GUI);
    UpdateTitle();
    UpdatePosition();
    // F11 / Alt+Enter: borderless fullscreen and back (Examples.Common)
    ExampleFullscreenKeys(GWin);
    GWin.BeginFrame();
    LHost.Draw(GUI);
    // The frame Quit was answered in is the last: it is saved as the example's snapshot
    // before EndFrame shows it (Examples.Common)
    if GQuit then
      SaveExampleSnapshot(GWin, SNAPSHOT_NAME);
    end;
    GWin.EndFrame();
  end;
  return 0;
end;

begin
  return Run();
end.
