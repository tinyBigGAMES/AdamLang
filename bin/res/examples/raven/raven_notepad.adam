  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raven_notepad.adam - a real text editor in one Adam file: Raven's
  TextEditor in a DPI-scaled raylib frame, with Adam itself as a syntax.

  WHAT IT SHOWS
  - Raven's TextEditor (ui\notepad.xml): syntax colors, line numbers, word
    wrap, zoom, auto-pairs, its own undo / redo, a monospace font from the
    shared assets.
  - Adam as a language of the editor: Rlanguage_register teaches Raven
    Adam's keywords, types, constants, comments and strings, and .adam files
    open colored. C, JSON, XML and Markdown come with Raven.
  - Files: New, Open, Save, Save As with Raven's FileBrowser shown as a
    dialog inside the window (ui\notepad_file.xml, Rdialog_open), the text
    read and written through System.IO (ReadAllText / WriteAllText), the
    file's line ends (CRLF or LF) kept as they were.
  - "Save changes?" (ui\notepad_confirm.xml) before New, Open or Quit throw
    away unsaved text, the window's close button and Esc included; the title
    shows an asterisk while the text is changed.
  - Find / replace: a bar that flies down (Ctrl+F, Ctrl+H), next / previous
    with wrap-around, match case, replace one, replace all as one undo step.
  - Live themes (View > Theme), the status bar (line, column, line ends,
    language).

  ADAM FEATURES ON SHOW
  - Objects with static methods and OVERLOADED methods: Document.Untitled()
    makes an empty document; Document.Save() writes it where it came from,
    Document.Save(APath) writes it somewhere new: one name, two forms.
  - choices + match: PendingStep (what to do once "save changes?" is
    answered) and the dialog answers are choices values picked by match.
  - Map<string, ActionFn>: every Raven action name answered from one table.
  - List<string>: the files opened, newest first (File > recent in the
    status), and Map<string, int64>: how often each text was searched.
  - defer: each resource released right where it is opened, in reverse.
  - Raw strings R"(...)": the welcome text, written as it shows.
  - FormatStr for every message; @exeicon for the program's icon.

  BUILD AND RUN (from repo\bin, the folder of adam.exe and assets.zip)
    adam build res\examples\raven\raven_notepad.adam -o output -r
  -r runs the program once built. For linux add -t x86_64-linux-gnu: on
  Windows -r runs the linux build through WSL2 (its display, WSLg), on
  linux natively.
*******************************************************************************/

module exe raven_notepad;

// Adam's icon on the exe and on its window ($P: is adam.exe's folder)
@exeicon "$P:res/assets/icons/adam.ico";

// System.Math before System.Raylib.C: a bare name two imports export is the last one's (BNF
// sec 1), so raylib's Vector2 / Color are the ones used here
import System.SysUtils, System.Math, System.IO, System.Collections, System.CustomIO, System.HookIO,
  System.Raylib.C, System.Raylib.Ext, System.Raven.C, System.Raven.Ext, System.Raven.Raylib;

const
  // bin\assets.zip beside adam, seen from output\bin\<triple>\<mode>\ ($P: = the exe's folder)
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  ASSETS_PASSWORD: string = "Adam";
  // Entries of the zip, by their own names (the zip is the path source)
  NOTEPAD_XML: string = "res/assets/ui/notepad.xml";
  FILE_DIALOG_XML: string = "res/assets/ui/notepad_file.xml";
  CONFIRM_DIALOG_XML: string = "res/assets/ui/notepad_confirm.xml";
  THEME_FILES: array[0..2] of string = ["res/assets/ui/theme_aurora.xml",
    "res/assets/ui/theme_ember.xml", "res/assets/ui/theme_paper.xml"];
  // The frame's base size (InitFrameWindow: the window opens at this x the monitor's scale)
  BASE_WIDTH: int32 = 1100;
  BASE_HEIGHT: int32 = 720;
  // Action names that carry their argument after a prefix
  LANGUAGE_PREFIX: string = "notepad.lang.";
  THEME_PREFIX: string = "notepad.use.";
  // The editor's zoom steps and limits
  ZOOM_STEP: float32 = 0.1f;
  ZOOM_MIN: float32 = 0.5f;
  ZOOM_MAX: float32 = 3.0f;
  // The most files the recent list keeps
  MAX_RECENT: int64 = 8;
  // What a new document holds: written here as it shows (a raw string: nothing is escaped)
  WELCOME_TEXT: string = R"(// Welcome to Adam Notepad: Raven's TextEditor, driven by Adam.
//
// Ctrl+O opens a file, Ctrl+S saves, Ctrl+F finds, Ctrl+H replaces.
// .adam files are colored as Adam: the language is registered at start.

module exe hello;

import System.SysUtils;

routine Greet(const AName: string): string;
begin
  return FormatStr("Hello, {}!", AName);
end;

begin
  defer println("bye");
  println(Greet("Adam"));
end.
)";

  // Adam for Raven's editor: words separated by spaces (BNF.md's keywords and type names)
  ADAM_KEYWORDS: string = "module exe dll lib unit import initialize finalize begin end var const " +
    "type routine forward method public clink cpplink external record object overlay choices " +
    "array of ptr to set packed align if then else while do for downto repeat until match guard " +
    "except finally return leave skip or and xor not in shl shr div mod addr self parent varargs " +
    "test default threadstatic operator virtual override final static property defer yield " +
    "sequence async await parallel lock own ref weak noreturn mutex";
  ADAM_TYPES: string = "bool char wchar string wstring int8 int16 int32 int64 uint8 uint16 " +
    "uint32 uint64 float32 float64 clong culong ptr List Map Set println print FormatStr len";
  ADAM_CONSTANTS: string = "true false nil";

// ---------------------------------------------------------------------------
// Line ends: the editor works in LF; a CRLF file is written back as CRLF
// (declared before the types: Document.Save uses ToCrlf, and a name is visible
// only after its declaration)
// ---------------------------------------------------------------------------

// AText with every CR LF made LF (the editor's line ends), and whether it had any CR LF
routine FromCrlf(const AText: string; var AHadCrlf: bool): string;
var
  LResult: string;
  LAt: int64;
  LFrom: int64;
begin
  LResult := "";
  AHadCrlf := false;
  LFrom := 0;
  LAt := IndexOf("\r\n", AText, 0);
  while LAt >= 0 do
    AHadCrlf := true;
    // Everything up to the CR, then the LF alone
    LResult := LResult + Substring(AText, LFrom, LAt - LFrom) + "\n";
    LFrom := LAt + 2;
    LAt := IndexOf("\r\n", AText, LFrom);
  end;
  return LResult + Substring(AText, LFrom, len(AText) - LFrom);
end;

// AText with every LF made CR LF (for writing back a CRLF file)
routine ToCrlf(const AText: string): string;
var
  LResult: string;
  LAt: int64;
  LFrom: int64;
begin
  LResult := "";
  LFrom := 0;
  LAt := IndexOf("\n", AText, 0);
  while LAt >= 0 do
    LResult := LResult + Substring(AText, LFrom, LAt - LFrom) + "\r\n";
    LFrom := LAt + 1;
    LAt := IndexOf("\n", AText, LFrom);
  end;
  return LResult + Substring(AText, LFrom, len(AText) - LFrom);
end;

type
  // The routine answering one Raven action; ASender is the widget that fired it
  ActionFn = routine(const ASender: Rid);

  // What waits for the "save changes?" dialog's answer
  PendingStep = choices(Nothing, NewDocument, OpenFile, Quit);

  // How the "save changes?" dialog was answered (its Rdialog_close results)
  ConfirmAnswer = choices(Cancel, Save, Discard);

  // Which file dialog is open
  FileDialogKind = choices(Open, SaveAs);

  // The document being edited: where it lives and how its lines end.
  // The text itself is the editor's: Raven holds it, undo history included.
  Document = object
    FPath: string;
    FCrlf: bool;
    FDirty: bool;

    // A new, empty, unnamed document. A static method: called on the type, Document.Untitled()
    static method Untitled(): Document;
    var
      LDocument: Document;
    begin
      LDocument.FPath := "";
      // A new file takes the host's line ends
      @ifdef TARGET_X86_64_WINDOWS_GNU
      LDocument.FCrlf := true;
      @else
      LDocument.FCrlf := false;
      @endif
      LDocument.FDirty := false;
      return LDocument;
    end;

    // The name shown in the title: the file's name, or "Untitled"
    method DisplayName(): string;
    begin
      if len(self.FPath) = 0 then
        return "Untitled";
      end;
      return ExtractFileName(self.FPath);
    end;

    // Writes AText where the document came from. False with no path yet (Save As first) or when
    // the write failed
    method Save(const AText: string): bool;
    begin
      if len(self.FPath) = 0 then
        return false;
      end;
      return self.Save(self.FPath, AText);
    end;

    // Writes AText to APath, which becomes the document's file: an overload of Save, one name
    // for one job (AD.9). The editor's LF line ends become CRLF again for a CRLF file
    method Save(const APath: string; const AText: string): bool;
    var
      LText: string;
    begin
      LText := AText;
      if self.FCrlf then
        LText := ToCrlf(AText);
      end;
      if not WriteAllText(APath, LText) then
        return false;
      end;
      self.FPath := APath;
      self.FDirty := false;
      return true;
    end;
  end;

var
  // The Raven window and the widgets the program reads or writes
  GUi: Rid;
  GEditor: Rid;
  GStatus: Rid;
  GPosition: Rid;
  GLineEnds: Rid;
  GLanguage: Rid;
  GFindBar: Rid;
  GReplaceRow: Rid;
  GFindText: Rid;
  GReplaceText: Rid;
  GMatchCase: Rid;
  // The document and the program's state
  GDocument: Document;
  GActions: Map<string, ActionFn>;
  GRecent: List<string>;
  GSearches: Map<string, int64>;
  GPending: PendingStep;
  GFileDialog: FileDialogKind;
  GDialogOpen: bool;
  // The path the file browser accepted, read in its callback (the dialog is deleted on close)
  GChosenPath: string;
  // The folder the file browser opens in: the last one used
  GLastDir: string;
  // The filters the file browser offers (a typed const has no address, so they are a variable)
  GFilters: array[0..4] of RFileFilter;
  // Adam's language description: kept alive for Raven, which reads it when registering
  GAdamLanguage: RLanguageDesc;
  // Set when the program is to end at the next frame
  GQuit: bool;
  // The title shown last, so the window's title is only set when it changes
  GShownTitle: string;
  // Setting the editor's text from the program is not a user's change
  GLoading: bool;

// ---------------------------------------------------------------------------
// Text helpers
// ---------------------------------------------------------------------------

// The byte offset in AText of line ALine, column AColumn (both from 0, columns in bytes, as
// Raven's editor counts them)
routine OffsetOf(const AText: string; const ALine: int32; const AColumn: int32): int64;
var
  LLine: int32;
  LAt: int64;
begin
  LLine := 0;
  LAt := 0;
  while (LLine < ALine) and (LAt < len(AText)) do
    if AText[LAt] = '\n' then
      LLine := LLine + 1;
    end;
    LAt := LAt + 1;
  end;
  return LAt + int64(AColumn);
end;

// The line and column of byte offset AOffset in AText (the reverse of OffsetOf)
routine PlaceOf(const AText: string; const AOffset: int64; var ALine: int32; var AColumn: int32);
var
  LAt: int64;
  LLineStart: int64;
begin
  ALine := 0;
  LLineStart := 0;
  for LAt := 0 to AOffset - 1 do
    if AText[LAt] = '\n' then
      ALine := ALine + 1;
      LLineStart := LAt + 1;
    end;
  end;
  AColumn := int32(AOffset - LLineStart);
end;

// A Raven call's text: AText as a NUL-ended C copy the caller frees
routine CText(const AText: string): ptr to char;
begin
  return StringToC(AText);
end;

// ---------------------------------------------------------------------------
// The window's parts
// ---------------------------------------------------------------------------

routine Find(const AScope: Rid; const AName: string): Rid;
var
  LName: ptr to char;
  LWidget: Rid;
begin
  LName := CText(AName);
  LWidget := Rwidget_find(AScope, LName);
  freemem(LName);
  return LWidget;
end;

routine SetLabel(const ALabel: Rid; const AText: string);
var
  LText: ptr to char;
begin
  LText := CText(AText);
  Rlabel_set_text(ALabel, LText);
  freemem(LText);
end;

routine SetStatus(const AText: string);
begin
  SetLabel(GStatus, AText);
end;

routine EditorText(): string;
begin
  return StringFromC(Rtext_editor_get_text(GEditor));
end;

// Puts AText in the editor as a fresh document's text (not a change of the user's)
routine LoadEditor(const AText: string);
var
  LText: ptr to char;
begin
  GLoading := true;
  defer GLoading := false;
  LText := CText(AText);
  Rtext_editor_set_text(GEditor, LText);
  freemem(LText);
  Rtext_editor_set_cursor(GEditor, 0, 0);
  Rtext_editor_scroll_to_line(GEditor, 0);
end;

// Names the editor's language ("None" for plain text) and shows it in the status bar
routine SetLanguage(const AName: string);
var
  LName: ptr to char;
begin
  LName := CText(AName);
  Rtext_editor_set_language(GEditor, LName);
  freemem(LName);
  if AName = "None" then
    SetLabel(GLanguage, "Plain text");
  else
    SetLabel(GLanguage, AName);
  end;
end;

// The language Raven knows for APath's extension (Adam's included once registered), else none
routine LanguageFor(const APath: string): string;
var
  LPath: ptr to char;
  LName: ptr to const char;
begin
  LPath := CText(APath);
  LName := Rlanguage_for_file(LPath);
  freemem(LPath);
  if LName = nil then
    return "None";
  end;
  return StringFromC(LName);
end;

// The window's title: the document's name, an asterisk while it has unsaved changes
routine UpdateTitle();
var
  LTitle: string;
  LText: ptr to char;
begin
  LTitle := FormatStr("{} - Adam Notepad", GDocument.DisplayName());
  if GDocument.FDirty then
    LTitle := "*" + LTitle;
  end;
  if LTitle = GShownTitle then
    return;
  end;
  GShownTitle := LTitle;
  LText := CText(LTitle);
  SetWindowTitle(LText);
  freemem(LText);
end;

// The cursor's line and column in the status bar (both from 1, as people count)
routine UpdatePosition();
var
  LLine: int32;
  LColumn: int32;
begin
  LLine := 0;
  LColumn := 0;
  Rtext_editor_get_cursor(GEditor, addr of LLine, addr of LColumn);
  SetLabel(GPosition, FormatStr("Ln {}, Col {}", LLine + 1, LColumn + 1));
end;

routine UpdateLineEnds();
begin
  if GDocument.FCrlf then
    SetLabel(GLineEnds, "CRLF");
  else
    SetLabel(GLineEnds, "LF");
  end;
end;

// Raven calls this on every change of the editor's text
routine clink OnEditorChanged(AEditor: Rid; AUserData: ptr);
begin
  if not GLoading then
    GDocument.FDirty := true;
  end;
end;

// ---------------------------------------------------------------------------
// Documents: new, open, save
// ---------------------------------------------------------------------------

// A path put first in the recent list (once), the list cut to MAX_RECENT
routine RememberRecent(const APath: string);
var
  LAt: int64;
begin
  LAt := GRecent.IndexOf(APath);
  if LAt >= 0 then
    GRecent.Delete(LAt);
  end;
  GRecent.Insert(0, APath);
  while GRecent.Count > MAX_RECENT do
    GRecent.RemoveLast();
  end;
end;

routine DoNewDocument();
begin
  GDocument := Document.Untitled();
  LoadEditor(WELCOME_TEXT);
  SetLanguage("Adam");
  UpdateLineEnds();
  SetStatus("A new document");
end;

// Opens APath into the editor; its line ends and its language follow the file
routine DoOpenPath(const APath: string);
var
  LText: string;
  LCrlf: bool;
begin
  if not ReadAllText(APath, LText) then
    SetStatus(FormatStr("Could not read {}", APath));
    return;
  end;
  GDocument := Document.Untitled();
  GDocument.FPath := APath;
  LoadEditor(FromCrlf(LText, LCrlf));
  GDocument.FCrlf := LCrlf;
  GLastDir := ExtractFileDir(APath);
  RememberRecent(APath);
  SetLanguage(LanguageFor(APath));
  UpdateLineEnds();
  SetStatus(FormatStr("Opened {} ({} bytes); {} recent file(s)", APath, len(LText), GRecent.Count));
end;

// The file dialog, declared ahead: RunPending opens it, and its body follows the callbacks
// it hands to Raven
forward routine OpenFileDialog(const AKind: FileDialogKind);

// What waits for an answer, run once the document is saved or its changes thrown away
routine RunPending();
var
  LStep: PendingStep;
begin
  LStep := GPending;
  GPending := PendingStep.Nothing;
  match LStep of
    // Nothing waited: nothing to run
    PendingStep.Nothing:
    PendingStep.NewDocument: DoNewDocument();
    PendingStep.OpenFile: OpenFileDialog(FileDialogKind.Open);
    PendingStep.Quit: GQuit := true;
  end;
end;

// Raven calls this when the file browser's Open / Save button is pressed: the path is read here,
// since the dialog (browser included) is deleted when it closes
routine clink OnBrowserAccepted(ABrowser: Rid; APath: ptr to const char; AUserData: ptr);
begin
  GChosenPath := StringFromC(APath);
  Rdialog_close(ABrowser, 1);
end;

routine clink OnBrowserCancelled(ABrowser: Rid; APath: ptr to const char; AUserData: ptr);
begin
  GChosenPath := "";
  Rdialog_close(ABrowser, 0);
end;

// The file dialog closed: AResult 1 with a path chosen, else cancelled
routine clink OnFileDialogClosed(AContent: Rid; AResult: int32; AUserData: ptr);
begin
  GDialogOpen := false;
  if (AResult <> 1) or (len(GChosenPath) = 0) then
    // A cancelled Save As cancels what waited for it too
    GPending := PendingStep.Nothing;
    SetStatus("Cancelled");
    return;
  end;
  match GFileDialog of
    FileDialogKind.Open: DoOpenPath(GChosenPath);
    FileDialogKind.SaveAs:
      if GDocument.Save(GChosenPath, EditorText()) then
        GLastDir := ExtractFileDir(GChosenPath);
        RememberRecent(GChosenPath);
        SetLanguage(LanguageFor(GChosenPath));
        SetStatus(FormatStr("Saved {}", GChosenPath));
        RunPending();
      else
        GPending := PendingStep.Nothing;
        SetStatus(FormatStr("Could not write {}", GChosenPath));
      end;
  end;
end;

// Shows Raven's file browser as a dialog inside the window, to open or to save as
routine OpenFileDialog(const AKind: FileDialogKind);
var
  LContent: Rid;
  LBrowser: Rid;
  LText: ptr to char;
begin
  if GDialogOpen then
    return;
  end;
  LContent := Rwidget_create_from_xml_file(FILE_DIALOG_XML);
  if LContent = R_INVALID_ID then
    SetStatus(FormatStr("{} did not load", FILE_DIALOG_XML));
    return;
  end;
  LBrowser := Find(LContent, "browser");
  GFileDialog := AKind;
  GChosenPath := "";
  match AKind of
    FileDialogKind.Open:
      SetLabel(Find(LContent, "dialog_title"), "OPEN A FILE");
      Rfile_browser_set_mode(LBrowser, R_FILE_BROWSER_OPEN);
    FileDialogKind.SaveAs:
      SetLabel(Find(LContent, "dialog_title"), "SAVE AS");
      Rfile_browser_set_mode(LBrowser, R_FILE_BROWSER_SAVE);
      LText := CText(GDocument.DisplayName());
      Rfile_browser_set_file_name(LBrowser, LText);
      freemem(LText);
      Rfile_browser_set_default_extension(LBrowser, "adam");
  end;
  LText := CText(GLastDir);
  Rfile_browser_set_directory(LBrowser, LText);
  freemem(LText);
  Rfile_browser_set_filters(LBrowser, addr of GFilters[0], 5);
  Rfile_browser_set_accepted_callback(LBrowser, OnBrowserAccepted, nil);
  Rfile_browser_set_cancelled_callback(LBrowser, OnBrowserCancelled, nil);
  GDialogOpen := true;
  // Raven owns the content from here: it is deleted when the dialog closes
  Rdialog_open(GUi, LContent, OnFileDialogClosed, nil);
end;

// Saves the document where it lives, or asks where (Save As) when it has no file yet.
// True when it is saved now (false: not saved, or a Save As dialog is open)
routine SaveDocument(): bool;
begin
  if len(GDocument.FPath) = 0 then
    OpenFileDialog(FileDialogKind.SaveAs);
    return false;
  end;
  if not GDocument.Save(EditorText()) then
    SetStatus(FormatStr("Could not write {}", GDocument.FPath));
    return false;
  end;
  SetStatus(FormatStr("Saved {}", GDocument.FPath));
  return true;
end;

// The "save changes?" dialog closed: its result is a ConfirmAnswer
routine clink OnConfirmClosed(AContent: Rid; AResult: int32; AUserData: ptr);
var
  LAnswer: ConfirmAnswer;
begin
  GDialogOpen := false;
  LAnswer := ConfirmAnswer.Cancel;
  if AResult = 1 then
    LAnswer := ConfirmAnswer.Save;
  end;
  if AResult = 2 then
    LAnswer := ConfirmAnswer.Discard;
  end;
  match LAnswer of
    ConfirmAnswer.Cancel:
      GPending := PendingStep.Nothing;
      SetStatus("Cancelled");
    ConfirmAnswer.Discard:
      GDocument.FDirty := false;
      RunPending();
    ConfirmAnswer.Save:
      // Saved now: go on; a Save As dialog opened instead goes on when it is answered
      if SaveDocument() then
        RunPending();
      end;
  end;
end;

// Runs AStep now when nothing is unsaved, else asks first ("save changes?")
routine AfterSaving(const AStep: PendingStep);
var
  LContent: Rid;
begin
  if GDialogOpen then
    return;
  end;
  GPending := AStep;
  if not GDocument.FDirty then
    RunPending();
    return;
  end;
  LContent := Rwidget_create_from_xml_file(CONFIRM_DIALOG_XML);
  if LContent = R_INVALID_ID then
    SetStatus(FormatStr("{} did not load", CONFIRM_DIALOG_XML));
    return;
  end;
  SetLabel(Find(LContent, "confirm_text"),
    FormatStr("{} has unsaved changes. Save them first?", GDocument.DisplayName()));
  GDialogOpen := true;
  Rdialog_open(GUi, LContent, OnConfirmClosed, nil);
end;

// ---------------------------------------------------------------------------
// Find and replace
// ---------------------------------------------------------------------------

routine FindTerm(): string;
begin
  return StringFromC(Rtext_input_get_text(GFindText));
end;

// AText to compare with: lower case when the search ignores case
routine Folded(const AText: string): string;
begin
  if Rcheckbox_is_checked(GMatchCase) <> 0 then
    return AText;
  end;
  return LowerCase(AText);
end;

// Selects ACount bytes of AText at AOffset in the editor and shows them
routine SelectFound(const AText: string; const AOffset: int64; const ACount: int64);
var
  LFromLine: int32;
  LFromColumn: int32;
  LToLine: int32;
  LToColumn: int32;
begin
  PlaceOf(AText, AOffset, LFromLine, LFromColumn);
  PlaceOf(AText, AOffset + ACount, LToLine, LToColumn);
  Rtext_editor_select(GEditor, LFromLine, LFromColumn, LToLine, LToColumn);
  Rtext_editor_scroll_to_line(GEditor, LFromLine);
end;

// Finds the term after (AForward) or before the cursor, wrapping round the text's ends
routine FindStep(const AForward: bool);
var
  LTerm: string;
  LText: string;
  LHaystack: string;
  LNeedle: string;
  LFromLine: int32;
  LFromColumn: int32;
  LToLine: int32;
  LToColumn: int32;
  LStart: int64;
  LAt: int64;
  LLast: int64;
  LCount: int64;
begin
  LTerm := FindTerm();
  if len(LTerm) = 0 then
    SetStatus("Type the text to find first");
    return;
  end;
  // How often each text was searched: a Map read and written by key
  LCount := 0;
  GSearches.TryGet(LTerm, LCount);
  GSearches[LTerm] := LCount + 1;
  LText := EditorText();
  LHaystack := Folded(LText);
  LNeedle := Folded(LTerm);
  // The selection's ends (the cursor's place twice when nothing is selected)
  LFromLine := 0;
  LFromColumn := 0;
  LToLine := 0;
  LToColumn := 0;
  if Rtext_editor_get_selection(GEditor, addr of LFromLine, addr of LFromColumn,
    addr of LToLine, addr of LToColumn) = 0 then
    Rtext_editor_get_cursor(GEditor, addr of LFromLine, addr of LFromColumn);
    LToLine := LFromLine;
    LToColumn := LFromColumn;
  end;
  if AForward then
    // After the selection; from the top again when nothing follows it
    LStart := OffsetOf(LText, LToLine, LToColumn);
    LAt := IndexOf(LNeedle, LHaystack, LStart);
    if LAt < 0 then
      LAt := IndexOf(LNeedle, LHaystack, 0);
    end;
  else
    // The last one starting before the selection; from the end again when there is none
    LStart := OffsetOf(LText, LFromLine, LFromColumn);
    LLast := -1;
    LAt := IndexOf(LNeedle, LHaystack, 0);
    while (LAt >= 0) and (LAt < LStart) do
      LLast := LAt;
      LAt := IndexOf(LNeedle, LHaystack, LAt + 1);
    end;
    if LLast < 0 then
      // None before: the last one in the whole text
      while LAt >= 0 do
        LLast := LAt;
        LAt := IndexOf(LNeedle, LHaystack, LAt + 1);
      end;
    end;
    LAt := LLast;
  end;
  if LAt < 0 then
    SetStatus(FormatStr("'{}' is not in the text", LTerm));
    return;
  end;
  SelectFound(LText, LAt, len(LTerm));
  SetStatus(FormatStr("Found '{}' (searched {} time(s))", LTerm, LCount + 1));
end;

// Replaces the selection when it is the term, then finds the next one
routine ReplaceOne();
var
  LTerm: string;
  LReplacement: ptr to char;
begin
  LTerm := FindTerm();
  if len(LTerm) = 0 then
    SetStatus("Type the text to find first");
    return;
  end;
  if Folded(StringFromC(Rtext_editor_get_selected_text(GEditor))) = Folded(LTerm) then
    // Typing over a selection replaces it: one undo step
    LReplacement := CText(StringFromC(Rtext_input_get_text(GReplaceText)));
    Rtext_editor_insert_text(GEditor, LReplacement);
    freemem(LReplacement);
  end;
  FindStep(true);
end;

// Replaces every match at once: the whole text selected and typed over, so one undo takes the
// whole replace back
routine ReplaceAll();
var
  LTerm: string;
  LReplacement: string;
  LText: string;
  LHaystack: string;
  LNeedle: string;
  LResult: string;
  LFrom: int64;
  LAt: int64;
  LCount: int64;
  LNew: ptr to char;
begin
  LTerm := FindTerm();
  if len(LTerm) = 0 then
    SetStatus("Type the text to find first");
    return;
  end;
  LReplacement := StringFromC(Rtext_input_get_text(GReplaceText));
  LText := EditorText();
  LHaystack := Folded(LText);
  LNeedle := Folded(LTerm);
  LResult := "";
  LFrom := 0;
  LCount := 0;
  LAt := IndexOf(LNeedle, LHaystack, 0);
  while LAt >= 0 do
    LResult := LResult + Substring(LText, LFrom, LAt - LFrom) + LReplacement;
    LFrom := LAt + len(LTerm);
    LCount := LCount + 1;
    LAt := IndexOf(LNeedle, LHaystack, LFrom);
  end;
  if LCount = 0 then
    SetStatus(FormatStr("'{}' is not in the text", LTerm));
    return;
  end;
  LResult := LResult + Substring(LText, LFrom, len(LText) - LFrom);
  Rtext_editor_select_all(GEditor);
  LNew := CText(LResult);
  Rtext_editor_insert_text(GEditor, LNew);
  freemem(LNew);
  SetStatus(FormatStr("Replaced {} time(s): Undo takes it all back", LCount));
end;

// Shows the find bar, with the replace row when AReplace, the cursor in the find field
routine ShowFindBar(const AReplace: bool);
var
  LSelected: string;
  LText: ptr to char;
begin
  Rwidget_set_visibility(GFindBar, R_VISIBLE);
  if AReplace then
    Rwidget_set_visibility(GReplaceRow, R_VISIBLE);
  else
    Rwidget_set_visibility(GReplaceRow, R_COLLAPSED);
  end;
  // A one-line selection becomes the term to find
  LSelected := StringFromC(Rtext_editor_get_selected_text(GEditor));
  if (len(LSelected) > 0) and (IndexOf("\n", LSelected, 0) < 0) then
    LText := CText(LSelected);
    Rtext_input_set_text(GFindText, LText);
    freemem(LText);
  end;
  Rwidget_focus(GFindText);
  Rtext_input_select_all(GFindText);
end;

// ---------------------------------------------------------------------------
// The actions
// ---------------------------------------------------------------------------

routine DoNew(const ASender: Rid);
begin
  AfterSaving(PendingStep.NewDocument);
end;

routine DoOpen(const ASender: Rid);
begin
  AfterSaving(PendingStep.OpenFile);
end;

routine DoSave(const ASender: Rid);
begin
  SaveDocument();
end;

routine DoSaveAs(const ASender: Rid);
begin
  OpenFileDialog(FileDialogKind.SaveAs);
end;

routine DoQuit(const ASender: Rid);
begin
  AfterSaving(PendingStep.Quit);
end;

routine DoUndo(const ASender: Rid);
begin
  Rtext_editor_undo(GEditor);
end;

routine DoRedo(const ASender: Rid);
begin
  Rtext_editor_redo(GEditor);
end;

routine DoSelectAll(const ASender: Rid);
begin
  Rtext_editor_select_all(GEditor);
end;

routine DoFind(const ASender: Rid);
begin
  ShowFindBar(false);
end;

routine DoReplace(const ASender: Rid);
begin
  ShowFindBar(true);
end;

routine DoFindNext(const ASender: Rid);
begin
  FindStep(true);
end;

routine DoFindPrevious(const ASender: Rid);
begin
  FindStep(false);
end;

routine DoFindClose(const ASender: Rid);
begin
  Rwidget_set_visibility(GFindBar, R_COLLAPSED);
  Rwidget_focus(GEditor);
end;

routine DoReplaceOne(const ASender: Rid);
begin
  ReplaceOne();
end;

routine DoReplaceAll(const ASender: Rid);
begin
  ReplaceAll();
end;

// The checkable View items: their check mark is the setting
routine DoWrap(const ASender: Rid);
begin
  Rtext_editor_set_word_wrap(GEditor, Rmenu_item_is_checked(ASender));
end;

routine DoNumbers(const ASender: Rid);
begin
  Rtext_editor_set_line_numbers(GEditor, Rmenu_item_is_checked(ASender));
end;

// Zooms by AStep, held between ZOOM_MIN and ZOOM_MAX (0: back to 1)
routine ZoomBy(const AStep: float32);
var
  LZoom: float32;
begin
  LZoom := 1.0f;
  if AStep <> 0.0f then
    LZoom := Clamp(Rtext_editor_get_zoom(GEditor) + AStep, ZOOM_MIN, ZOOM_MAX);
  end;
  Rtext_editor_set_zoom(GEditor, LZoom);
  SetStatus(FormatStr("Zoom {}%", Floor(LZoom * 100.0f + 0.5f)));
end;

routine DoZoomIn(const ASender: Rid);
begin
  ZoomBy(ZOOM_STEP);
end;

routine DoZoomOut(const ASender: Rid);
begin
  ZoomBy(-ZOOM_STEP);
end;

routine DoZoomReset(const ASender: Rid);
begin
  ZoomBy(0.0f);
end;

routine DoConfirmSave(const ASender: Rid);
begin
  Rdialog_close(ASender, 1);
end;

routine DoConfirmDiscard(const ASender: Rid);
begin
  Rdialog_close(ASender, 2);
end;

routine DoConfirmCancel(const ASender: Rid);
begin
  Rdialog_close(ASender, 0);
end;

// Raven's one handler for every action: the table first, then the names carrying an argument
routine clink OnAction(ASender: Rid; AAction: ptr to const char; AUserData: ptr);
var
  LName: string;
  LHandler: ActionFn;
  LArgument: ptr to char;
begin
  LName := StringFromC(AAction);
  if GActions.TryGet(LName, LHandler) then
    LHandler(ASender);
    return;
  end;
  if IndexOf(LANGUAGE_PREFIX, LName, 0) = 0 then
    SetLanguage(Substring(LName, len(LANGUAGE_PREFIX), len(LName)));
    return;
  end;
  if IndexOf(THEME_PREFIX, LName, 0) = 0 then
    LArgument := CText(Substring(LName, len(THEME_PREFIX), len(LName)));
    Rtheme_use(LArgument);
    freemem(LArgument);
    return;
  end;
  SetStatus(FormatStr("No handler for the action '{}'", LName));
end;

routine clink OnRavenError(ACode: RError; ASeverity: RSeverity; ADetail: ptr to const char);
begin
  println("[Raven] {} ({}): {}", StringFromC(Rerror_to_string(ACode)),
    StringFromC(Rseverity_to_string(ASeverity)), StringFromC(ADetail));
end;

routine BindActions();
begin
  GActions["notepad.new"] := DoNew;
  GActions["notepad.open"] := DoOpen;
  GActions["notepad.save"] := DoSave;
  GActions["notepad.save_as"] := DoSaveAs;
  GActions["notepad.quit"] := DoQuit;
  GActions["notepad.undo"] := DoUndo;
  GActions["notepad.redo"] := DoRedo;
  GActions["notepad.select_all"] := DoSelectAll;
  GActions["notepad.find"] := DoFind;
  GActions["notepad.replace"] := DoReplace;
  GActions["notepad.find_next"] := DoFindNext;
  GActions["notepad.find_previous"] := DoFindPrevious;
  GActions["notepad.find_close"] := DoFindClose;
  GActions["notepad.replace_one"] := DoReplaceOne;
  GActions["notepad.replace_all"] := DoReplaceAll;
  GActions["notepad.wrap"] := DoWrap;
  GActions["notepad.numbers"] := DoNumbers;
  GActions["notepad.zoom_in"] := DoZoomIn;
  GActions["notepad.zoom_out"] := DoZoomOut;
  GActions["notepad.zoom_reset"] := DoZoomReset;
  GActions["notepad.confirm.save"] := DoConfirmSave;
  GActions["notepad.confirm.discard"] := DoConfirmDiscard;
  GActions["notepad.confirm.cancel"] := DoConfirmCancel;
  Raction_set_default_handler(OnAction, nil);
end;

// Teaches Raven's editor Adam: its keywords, types, constants, comments and strings, for files
// ending in .adam. Raven reads the description when it registers it
routine RegisterAdam();
begin
  GAdamLanguage.name := "Adam";
  GAdamLanguage.extensions := "adam";
  GAdamLanguage.keywords := ADAM_KEYWORDS;
  GAdamLanguage.types := ADAM_TYPES;
  GAdamLanguage.constants := ADAM_CONSTANTS;
  GAdamLanguage.line_comment := "//";
  GAdamLanguage.block_comment_start := "/*";
  GAdamLanguage.block_comment_end := "*/";
  GAdamLanguage.string_quotes := "\"'";
  GAdamLanguage.multiline_strings := "R\"(...)\"";
  // Adam's directives (@exeicon, @ifdef ..) start with @
  GAdamLanguage.annotation := "@";
  GAdamLanguage.flags := Ruint(R_LANGUAGE_CHAR_LITERALS);
  Rlanguage_register(addr of GAdamLanguage);
end;

// The file browser's filters, in the order it offers them
routine MakeFilters();
begin
  GFilters[0].name := "Adam source";
  GFilters[0].patterns := "*.adam";
  GFilters[1].name := "Text";
  GFilters[1].patterns := "*.txt;*.md";
  GFilters[2].name := "Data";
  GFilters[2].patterns := "*.json;*.xml;*.toml";
  GFilters[3].name := "C";
  GFilters[3].patterns := "*.c;*.h";
  GFilters[4].name := "All files";
  GFilters[4].patterns := "*";
end;

// ---------------------------------------------------------------------------
// The program
// ---------------------------------------------------------------------------

routine Run(): int32;
var
  LZip: IOSource;
  LPath: ptr to char;
  LI: int32;
begin
  // The shared assets: raylib's and Raven's own file opens read the zip by entry name, while
  // the documents go through System.IO, which reads the real disk
  LZip := CreateZipIOSource(ASSETS_ZIP, ASSETS_PASSWORD);
  defer IOSourceClose(LZip);
  if not SetRaylibIOSource(LZip) then
    println("raven_notepad: cannot use {} as the file source", ASSETS_ZIP);
    return 1;
  end;
  defer SetRaylibIOSource(nil);

  SetTraceLogLevel(LOG_WARNING);
  SetConfigFlags(uint32(FLAG_VSYNC_HINT) | uint32(FLAG_MSAA_4X_HINT));
  // The DPI-scaled frame window (AV.12): the base size x the monitor's scale
  InitFrameWindow(BASE_WIDTH, BASE_HEIGHT, "Adam Notepad");
  defer if IsWindowReady() then CloseWindow(); end;
  if not IsWindowReady() then
    println("raven_notepad: the window could not open (no display?)");
    return 1;
  end;
  // Esc belongs to the editor (it closes the find bar), not to raylib's quit
  SetExitKey(KEY_NULL);

  Rerror_set_callback(OnRavenError);
  if not InitRaven("raven_notepad") then
    println("raven_notepad: Raven did not start");
    return 1;
  end;
  defer CloseRaven();

  for LI := 0 to 2 do
    LPath := CText(THEME_FILES[LI]);
    Rtheme_load(LPath);
    freemem(LPath);
  end;
  Rtheme_use("Aurora");
  // Adam before the window: the editor's Language="Adam" names it
  RegisterAdam();
  MakeFilters();

  GUi := Rwindow_create_from_xml_file(NOTEPAD_XML);
  if GUi = R_INVALID_ID then
    println("raven_notepad: {} did not load", NOTEPAD_XML);
    return 1;
  end;
  GEditor := Find(GUi, "editor");
  GStatus := Find(GUi, "status");
  GPosition := Find(GUi, "position");
  GLineEnds := Find(GUi, "line_ends");
  GLanguage := Find(GUi, "language");
  GFindBar := Find(GUi, "findbar");
  GReplaceRow := Find(GUi, "replace_row");
  GFindText := Find(GUi, "find_text");
  GReplaceText := Find(GUi, "replace_text");
  GMatchCase := Find(GUi, "match_case");
  Rtext_editor_set_changed_callback(GEditor, OnEditorChanged, nil);
  Rtext_editor_set_auto_pairs(GEditor, R_TRUE);
  BindActions();

  GLastDir := ExeDir();
  GPending := PendingStep.Nothing;
  DoNewDocument();
  SetStatus("Ready: Ctrl+O opens, Ctrl+S saves, Ctrl+F finds");
  Rwidget_focus(GEditor);

  while not GQuit do
    // The window's close button (or the OS asking) goes through "save changes?" like Quit
    if WindowShouldClose() then
      AfterSaving(PendingStep.Quit);
    end;
    UpdateRaven(GUi);
    UpdateTitle();
    UpdatePosition();
    BeginDrawing();
    BeginFrame();
    DrawRaven(GUi);
    EndFrame();
    EndDrawing();
  end;
  return 0;
end;

begin
  return Run();
end.
