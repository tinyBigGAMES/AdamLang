/*******************************************************************************
  Adam™ Programming Language

  Copyright © 2026-present tinyBigGAMES™ LLC
  All Rights Reserved.

  https://adamlang.org

  SPDX-License-Identifier: MPL-2.0

  This Source Code Form is subject to the terms of the
  Mozilla Public License, v. 2.0. If a copy of the MPL
  was not distributed with this file, You can obtain one
  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raven_frontend.adam - a game's whole front end: a title screen, save slots,
  settings with key rebinding, a short flight to play and a pause menu, every
  screen change a fade driven by a generator.

  WHAT IT SHOWS
  - A raylib frame window (System.Raylib.Ext's Window, AV.12): a base size of
    1280 x 720 at the monitor's scale, letterboxed when resized. raylib draws
    the scene behind every screen in base units: a nebula and a starfield in
    parallax that races while you fly.
  - One Raven window over it (System.Raven.Raylib's RaylibHost), built from
    ui\frontend.xml: a Switcher holding the six screens. Its repeated parts are
    Raven components declared in ui\frontend_widgets.xml (<Widget>: MenuButton,
    SettingRow, KeyRow, SlotCard) and stamped out with <Repeat>; each part is
    found by the name its parameters built (UIWidget.Find<T>, typed: a slider
    is a UISlider, a switch a UICheckBox).
  - Screen changes under a fade: a generator (`sequence of FadeStep`) yields
    one step per frame, the veil darkening, the one step at full dark that
    switches the screen (and the music), then the veil lifting. The main loop
    pulls one step a frame (`pull`), and the music follows the veil.
  - Settings: master / music / effects volume (raylib's sounds through
    System.Math's PerceivedVolume, so 50 sounds half as loud), mute,
    fullscreen (also F11 / Alt+Enter), an FPS readout, the UI theme switched
    live, the star density. Key rebinding: Rebind, then the next key pressed
    becomes the control's (Esc cancels, a key bound twice swaps).
  - Save slots: three pilots, each with a record (best score, flights, time
    flown); a flight is saved to its slot as it ends.
  - Settings and slots persist in raven_frontend.json beside the exe
    (System.JSON.Ext built with Add / BeginObject / BeginArray and read by
    path; the file goes through System.IO to the disk, never into the
    assets zip the C runtime's opens read).
  - The flight: the ship flies on the bound keys, rocks to dodge, sparks to
    collect, a boost that drains and refills. Esc pauses.
  - Music and effects from the zip (audio\music, audio\sfx); every other file
    too (the XML window and components, the themes, the font).
  - Its last frame is saved as raven_frontend.png beside this file when it
    exits (Examples.Common's SaveExampleSnapshot).

  ADAM FEATURES ON SHOW
  - Generators: Ramp yields a run of fade steps, Transition chains two of
    them around the switch step with `yield from`; the loop resumes the
    current one each frame with `pull(S, X)`, which reports when it ended.
  - nameof: a key's name on the keycaps and in the save file comes from the
    Key choices value itself (`nameof(LKey)`), no table of names to keep.
  - choices: the screens and the controls are choices; their values index
    the Switcher's children and the bindings (int32(Screen.Flight)), and
    match picks what Esc does on each screen.
  - Routine values: every Raven action is a name bound to the routine
    answering it (UIActions.Bind); one prefix routine answers every slot's
    and every control's buttons (UIActions.BindPrefix carries which).
  - Self-releasing objects and defer: the window, the music and the sounds
    release themselves with their last copy; the zip and Raven by a defer
    written where they open, so the clean-up runs in reverse on every way
    out of Run.
  - Records, static arrays and typed constants: the rocks, sparks and stars
    live in fixed arrays of records; the default bindings are a typed
    constant array of Key.
  - FormatStr for every text; `return` from the main block sets the exit
    code; @exeicon for the exe's and the window's icon.

  CONTROLS
    W / S / A / D or the keys bound in Settings: fly; Left Shift: boost;
    Esc: back / pause; F11 or Alt+Enter: fullscreen.

  BUILD AND RUN (from repo\bin, the folder of adam.exe and assets.zip)
    adam build res\examples\raven\raven_frontend.adam -o output -r
  -r runs the program once built. For linux add -t x86_64-linux-gnu: on
  Windows -r runs the linux build through WSL2 (its display, WSLg), on
  linux natively. With no display at all the example says so and exits.
*******************************************************************************/

module exe raven_frontend;

// Adam's icon: the exe file's and the window's (title bar, taskbar); on linux the window's
@exeicon "$P:res/assets/icons/adam.ico";

// The examples' shared unit (Examples.Common) lives in res\examples\common
@addmodulepath "$P:res/examples/common";

// System.Math before System.Raylib.C: a bare name two imports export is the last one's
// (BNF sec 1), so raylib's Vector2 / Color are the ones used here
import System.SysUtils, System.Math, System.IO, System.JSON.C, System.JSON.Ext,
  System.Raylib.C, System.Raylib.Ext, System.Raven.C, System.Raven.Ext, System.Raven.Raylib,
  Examples.Common;

const
  // Entries of the zip, by their own names (the zip is the path source)
  FRONTEND_XML: string = "res/assets/ui/frontend.xml";
  MENU_MUSIC: string = "res/assets/audio/music/song01.ogg";
  FLIGHT_MUSIC: string = "res/assets/audio/music/song02.ogg";
  SPARK_SOUND: string = "res/assets/audio/sfx/coin_pickup.ogg";
  CRASH_SOUND: string = "res/assets/audio/sfx/explo_rock.ogg";
  BIND_SOUND: string = "res/assets/audio/sfx/digthis.ogg";
  BEST_SOUND: string = "res/assets/audio/sfx/victory_jingle.ogg";
  // The settings and the slots, beside the exe on the disk ($P: is the exe's folder)
  SAVE_FILE: string = "$P:raven_frontend.json";
  // This example under res\examples, for its snapshot
  SNAPSHOT_NAME: string = "raven/raven_frontend";
  // The frame's base size: everything is drawn in these units
  BASE_WIDTH: int32 = 1280;
  BASE_HEIGHT: int32 = 720;
  // How long each half of a screen change takes (dark, then light again), in seconds
  FADE_SECONDS: float32 = 0.28f;
  // The save slots, the most stars, rocks and sparks the scene holds
  SLOT_COUNT: int32 = 3;
  MAX_STARS: int32 = 400;
  MAX_ROCKS: int32 = 28;
  MAX_SPARKS: int32 = 6;
  // The ship: its radius for collisions, its thrust and its top speed, in base units
  SHIP_RADIUS: float32 = 16.0f;
  SHIP_THRUST: float32 = 1900.0f;
  SHIP_TOP_SPEED: float32 = 420.0f;
  // How fast the world streams past, and how much faster it gets each second of a flight
  WORLD_SPEED: float32 = 280.0f;
  WORLD_SPEEDUP: float32 = 5.0f;
  // A spark's worth, and a score per second at the base speed
  SPARK_POINTS: int32 = 250;
  SCORE_RATE: float64 = 12.0;
  // A best score that fills a slot's stage bar
  STAGE_FULL: int32 = 6000;
  // The controls' action suffixes (frontend.rebind.<act>, key.<act> in frontend.xml), in the
  // order of the Control choices
  CONTROL_ACTS: array[0..4] of string = ["up", "down", "left", "right", "boost"];
  // What each control does, for the status lines
  CONTROL_TEXTS: array[0..4] of string = ["Thrust up", "Thrust down", "Brake", "Accelerate",
    "Boost"];
  // The keys a new player gets
  CONTROL_DEFAULTS: array[0..4] of Key = [Key.W, Key.S, Key.A, Key.D, Key.LeftShift];
  // Every key a control may take (a key not here is refused, so the save file only ever holds
  // these names): letters, digits, arrows, and the keys games use
  BINDABLE_KEYS: array[0..51] of Key = [Key.A, Key.B, Key.C, Key.D, Key.E, Key.F, Key.G,
    Key.H, Key.I, Key.J, Key.K, Key.L, Key.M, Key.N, Key.O, Key.P, Key.Q, Key.R, Key.S, Key.T,
    Key.U, Key.V, Key.W, Key.X, Key.Y, Key.Z, Key.Zero, Key.One, Key.Two, Key.Three, Key.Four,
    Key.Five, Key.Six, Key.Seven, Key.Eight, Key.Nine, Key.Up, Key.Down, Key.Left, Key.Right,
    Key.Space, Key.Enter, Key.Tab, Key.LeftShift, Key.RightShift, Key.LeftControl,
    Key.RightControl, Key.LeftAlt, Key.RightAlt, Key.Kp8, Key.Kp2, Key.Kp0];
  // A new pilot's name, picked at random
  PILOT_NAMES: array[0..5] of string = ["Vega", "Orion", "Lyra", "Nova", "Rigel", "Ceres"];

type
  // The screens, in the order of frontend.xml's Switcher children: int32(Screen.X) is the
  // Switcher's index of X
  Screen = choices(Title, Slots, Settings, Flight, Pause, Over);

  // The ship's controls, in the order of the Controls tab's rows
  Control = choices(Up, Down, Left, Right, Boost);

  // One frame of a screen change: how dark the veil is, and whether this is the step at full
  // dark that shows the next screen
  FadeStep = record
    Alpha: float32;
    Switch: bool;
  end;

  // A save slot: a pilot and its record
  SaveSlot = record
    Used: bool;
    Pilot: string;
    Best: int32;
    Flights: int32;
    Seconds: float64;
  end;

  // A star of the background: where it is and how near (0.15 far .. 1 near: its speed,
  // size and brightness)
  Star = record
    Pos: Vector2;
    Depth: float32;
  end;

  // A rock to dodge, or a spark to collect (Radius 0: not in play)
  Body = record
    Pos: Vector2;
    Vel: Vector2;
    Radius: float32;
    Spin: float32;
  end;

var
  // The DPI-scaled frame window (its last copy, at the program's end, closes it)
  GWin: Window;
  // The Raven window and the widgets the program reads or writes
  GUI: UIWindow;
  GScreens: UISwitcher;
  GToast: UIToast;
  // The screen showing, the one a running change goes to, and where Settings goes back to
  GScreen: Screen;
  GPending: Screen;
  GSettingsFrom: Screen;
  // The screen change running (a generator, resumed once a frame) and the veil it drew last
  GChange: sequence of FadeStep;
  GChanging: bool;
  GVeil: float32;
  // The settings
  GMaster: float32;
  GMusicLevel: float32;
  GEffects: float32;
  GMuted: bool;
  GShowFPS: bool;
  GTheme: int32;
  GStarCount: int32;
  GKeys: array[0..4] of Key;
  // The control waiting for its new key (-1: none)
  GCapture: int32;
  // True while the program itself writes the settings' widgets (their OnChanged then is ours)
  GSyncing: bool;
  // The pilots, the slot flying now and the one Continue flies
  GSlots: array[0..2] of SaveSlot;
  GSlot: int32;
  GLastSlot: int32;
  // Sound (valid only with an audio device): the music playing and the effects
  GAudio: AudioDevice;
  GMenuMusic: MusicRes;
  GFlightMusic: MusicRes;
  GFlightMusicOn: bool;
  GSparkSound: SoundRes;
  GCrashSound: SoundRes;
  GBindSound: SoundRes;
  GBestSound: SoundRes;
  // The scene
  GStars: array[0..399] of Star;
  GTime: float32;
  // The flight
  GShip: Vector2;
  GShipVel: Vector2;
  GBoost: float32;
  GBoosting: bool;
  GWorldSpeed: float32;
  GScore: float64;
  GFlightTime: float64;
  GRocks: array[0..27] of Body;
  GSparks: array[0..5] of Body;
  GRockClock: float32;
  GSparkClock: float32;
  GShownScore: int32;
  // Set by Quit: the loop ends at the next frame
  GQuit: bool;

// ---------------------------------------------------------------------------
// Screen changes: a generator yields the veil's steps
// ---------------------------------------------------------------------------

// The veil going from AFrom to ATo darkness over ASeconds, one step a frame: a generator, so
// each pull runs it on to its next `yield` and the frame's own delta time moves it on
func Ramp(const AFrom: float32; const ATo: float32; const ASeconds: float32): sequence of FadeStep;
var
  LT: float32;
  LStep: FadeStep;
begin
  LT := 0.0f;
  LStep.Switch := false;
  while LT < ASeconds do
    LT := LT + Time.Delta();
    LStep.Alpha := AFrom + (ATo - AFrom) * Min(LT / ASeconds, 1.0f);
    yield LStep;
  end;
end;

// A whole screen change: dark, the one switch step, light again. `yield from` hands each of
// Ramp's steps on as this generator's own
func Transition(): sequence of FadeStep;
var
  LSwitch: FadeStep;
begin
  yield from Ramp(0.0f, 1.0f, FADE_SECONDS);
  LSwitch.Alpha := 1.0f;
  LSwitch.Switch := true;
  yield LSwitch;
  yield from Ramp(1.0f, 0.0f, FADE_SECONDS);
end;

// Starts a change to ATo (none while one runs: a double click cannot stack them)
func GoTo(const ATo: Screen);
begin
  if GChanging then
    return;
  end;
  GPending := ATo;
  GChange := Transition();
  GChanging := true;
end;

// ---------------------------------------------------------------------------
// Sound
// ---------------------------------------------------------------------------

// The music's level now: the settings, then the veil (the music dips with the screen)
func MusicVolume(): float32;
begin
  if GMuted then
    return 0.0f;
  end;
  return GMaster * GMusicLevel * (1.0f - 0.85f * GVeil);
end;

// Plays an effect at the effects' level (each SoundRes.Volume goes through PerceivedVolume)
func PlayEffect(var ASound: SoundRes);
begin
  if (not GAudio.Ready()) or GMuted then
    return;
  end;
  ASound.Volume(GMaster * GEffects).Play();
end;

// The music of AScreen: the flight's while flying, paused or just crashed, else the menus'
func UseMusicOf(const AScreen: Screen);
var
  LFlight: bool;
begin
  if not GAudio.Ready() then
    return;
  end;
  LFlight := (AScreen = Screen.Flight) or (AScreen = Screen.Pause) or (AScreen = Screen.Over);
  if LFlight = GFlightMusicOn then
    return;
  end;
  GFlightMusicOn := LFlight;
  if LFlight then
    GMenuMusic.Stop();
    GFlightMusic.Seek(0.0f).Play();
  else
    GFlightMusic.Stop();
    GMenuMusic.Play();
  end;
end;

// Feeds the music playing and sets its level for this frame
func UpdateMusic();
begin
  if not GAudio.Ready() then
    return;
  end;
  if GFlightMusicOn then
    GFlightMusic.Volume(MusicVolume()).Update();
  else
    GMenuMusic.Volume(MusicVolume()).Update();
  end;
end;

// ---------------------------------------------------------------------------
// Saving: the settings and the slots in one JSON file on the disk
// ---------------------------------------------------------------------------

// The bindable key named AName (its nameof); false when no bindable key has that name
func KeyNamed(const AName: string; var AKey: Key): bool;
var
  LI: int32;
begin
  for LI := 0 to 51 do
    if nameof(BINDABLE_KEYS[LI]) = AName then
      AKey := BINDABLE_KEYS[LI];
      return true;
    end;
  end;
  return false;
end;

// Whether AKey may be bound
func Bindable(const AKey: Key): bool;
var
  LI: int32;
begin
  for LI := 0 to 51 do
    if BINDABLE_KEYS[LI] = AKey then
      return true;
    end;
  end;
  return false;
end;

// The settings a first start has
func DefaultSettings();
var
  LI: int32;
begin
  GMaster := 0.8f;
  GMusicLevel := 0.7f;
  GEffects := 0.9f;
  GMuted := false;
  GShowFPS := false;
  GTheme := 0;
  GStarCount := 220;
  for LI := 0 to 4 do
    GKeys[LI] := CONTROL_DEFAULTS[LI];
  end;
end;

// Writes the settings and the slots to SAVE_FILE. The JSON is built with Add (a key and its
// value into the open object), BeginObject / BeginArray (a nested container the next calls go
// into) and EndObject / EndArray; each returns the JSON, so the calls chain
func SaveAll();
var
  LJ: JSON;
  LI: int32;
begin
  LJ.BeginObject("audio").Add("master", float64(GMaster)).Add("music", float64(GMusicLevel))
    .Add("effects", float64(GEffects)).Add("mute", GMuted).EndObject();
  LJ.BeginObject("display").Add("fps", GShowFPS).Add("theme", GTheme)
    .Add("stars", GStarCount).EndObject();
  // The keys by name (nameof of each Key value): readable in the file, and kept right when
  // raylib's key numbers are not what a reader expects
  LJ.BeginArray("keys");
  for LI := 0 to 4 do
    LJ.Add(nameof(GKeys[LI]));
  end;
  LJ.EndArray();
  LJ.Add("last_slot", GLastSlot);
  LJ.BeginArray("slots");
  for LI := 0 to SLOT_COUNT - 1 do
    LJ.BeginObject().Add("used", GSlots[LI].Used).Add("pilot", GSlots[LI].Pilot)
      .Add("best", GSlots[LI].Best).Add("flights", GSlots[LI].Flights)
      .Add("seconds", GSlots[LI].Seconds).EndObject();
  end;
  LJ.EndArray();
  // System.IO writes to the disk (the assets zip only answers the C runtime's opens)
  if not WriteAllText(ResolvePath(SAVE_FILE), LJ.ToPrettyString()) then
    println("raven_frontend: {} could not be written", SAVE_FILE);
  end;
end;

// Reads SAVE_FILE when there is one; every value it lacks keeps its default
func LoadAll();
var
  LText: string;
  LJ: JSON;
  LI: int32;
  LKey: Key;
  LPath: string;
begin
  DefaultSettings();
  GLastSlot := -1;
  LPath := ResolvePath(SAVE_FILE);
  if not FileExists(LPath) then
    return;
  end;
  if not ReadAllText(LPath, LText) then
    return;
  end;
  if not JSON.TryFromString(LText, LJ) then
    println("raven_frontend: {} is not JSON, starting fresh", SAVE_FILE);
    return;
  end;
  // A path names a value: keys joined by '.', an item as [N]
  GMaster := Clamp(LJ.Get("audio.master").AsSingle(GMaster), 0.0f, 1.0f);
  GMusicLevel := Clamp(LJ.Get("audio.music").AsSingle(GMusicLevel), 0.0f, 1.0f);
  GEffects := Clamp(LJ.Get("audio.effects").AsSingle(GEffects), 0.0f, 1.0f);
  GMuted := LJ.Get("audio.mute").AsBoolean(GMuted);
  GShowFPS := LJ.Get("display.fps").AsBoolean(GShowFPS);
  GTheme := System.Math.Clamp(LJ.Get("display.theme").AsInt32(GTheme), 0, 2);
  GStarCount := System.Math.Clamp(LJ.Get("display.stars").AsInt32(GStarCount), 50, MAX_STARS);
  for LI := 0 to 4 do
    if KeyNamed(LJ.Get(FormatStr("keys[{}]", LI)).AsString(""), LKey) then
      GKeys[LI] := LKey;
    end;
  end;
  GLastSlot := System.Math.Clamp(LJ.Get("last_slot").AsInt32(-1), -1, SLOT_COUNT - 1);
  for LI := 0 to SLOT_COUNT - 1 do
    GSlots[LI].Used := LJ.Get(FormatStr("slots[{}].used", LI)).AsBoolean(false);
    GSlots[LI].Pilot := LJ.Get(FormatStr("slots[{}].pilot", LI)).AsString("");
    GSlots[LI].Best := LJ.Get(FormatStr("slots[{}].best", LI)).AsInt32(0);
    GSlots[LI].Flights := LJ.Get(FormatStr("slots[{}].flights", LI)).AsInt32(0);
    GSlots[LI].Seconds := LJ.Get(FormatStr("slots[{}].seconds", LI)).AsDouble(0.0);
  end;
  if (GLastSlot >= 0) and (not GSlots[GLastSlot].Used) then
    GLastSlot := -1;
  end;
end;

// ---------------------------------------------------------------------------
// The screens' texts
// ---------------------------------------------------------------------------

// ASeconds as m:ss
func Clock(const ASeconds: float64): string;
var
  LWhole: int64;
begin
  LWhole := Trunc(ASeconds);
  return FormatStr("{}:{}{}", LWhole div 60, (LWhole mod 60) div 10, LWhole mod 10);
end;

// The title screen's Continue (only with a pilot to continue) and its last-pilot line
func RefreshTitle();
var
  LText: string;
begin
  GUI.Find<UIButton>("title.continue").Enabled(GLastSlot >= 0);
  LText := "";
  if GLastSlot >= 0 then
    LText := FormatStr("Last pilot: {}, best {}", GSlots[GLastSlot].Pilot, GSlots[GLastSlot].Best);
  end;
  GUI.Find<UILabel>("title.last").Text(LText);
end;

// Every slot card's texts, stage bar and buttons
func RefreshSlots();
var
  LI: int32;
  LSlot: SaveSlot;
  LName: string;
begin
  for LI := 0 to SLOT_COUNT - 1 do
    LSlot := GSlots[LI];
    // The parts' names were built from the SlotCard's Slot parameter: slot.<i>.title ..
    LName := FormatStr("slot.{}.", LI);
    if LSlot.Used then
      GUI.Find<UILabel>(LName + "title").Text(LSlot.Pilot);
      GUI.Find<UILabel>(LName + "info").Text(FormatStr("Best {}  -  {} flights  -  {} flown",
        LSlot.Best, LSlot.Flights, Clock(LSlot.Seconds)));
      GUI.Find<UIProgressBar>(LName + "stage").Value(Min(float32(LSlot.Best) / float32(STAGE_FULL), 1.0f));
      GUI.Find<UIButton>(LName + "fly").Text("Fly");
    else
      GUI.Find<UILabel>(LName + "title").Text("Empty");
      GUI.Find<UILabel>(LName + "info").Text("A new pilot starts here.");
      GUI.Find<UIProgressBar>(LName + "stage").Value(0.0f);
      GUI.Find<UIButton>(LName + "fly").Text("New pilot");
    end;
    GUI.Find<UIButton>(LName + "erase").Enabled(LSlot.Used);
  end;
end;

// Every keycap shows its control's key; the one waiting for a key says so
func RefreshKeys();
var
  LI: int32;
begin
  for LI := 0 to 4 do
    if LI = GCapture then
      GUI.Find<UILabel>(FormatStr("key.{}", CONTROL_ACTS[LI])).Text("press a key");
    else
      GUI.Find<UILabel>(FormatStr("key.{}", CONTROL_ACTS[LI])).Text(nameof(GKeys[LI]));
    end;
  end;
end;

// One volume slider's value label
func ShowLevel(const AName: string; const ALevel: float32);
begin
  GUI.Find<UILabel>(AName + ".value").Text(FormatStr("{}", Round(ALevel * 100.0f)));
end;

// Writes the settings into their widgets (their OnChanged then changes nothing: GSyncing)
func RefreshSettings();
begin
  GSyncing := true;
  GUI.Find<UISlider>("audio.master").Value(GMaster * 100.0f);
  GUI.Find<UISlider>("audio.music").Value(GMusicLevel * 100.0f);
  GUI.Find<UISlider>("audio.effects").Value(GEffects * 100.0f);
  ShowLevel("audio.master", GMaster);
  ShowLevel("audio.music", GMusicLevel);
  ShowLevel("audio.effects", GEffects);
  GUI.Find<UICheckBox>("audio.mute").Checked(GMuted);
  GUI.Find<UICheckBox>("display.fullscreen").Checked(GWin.Borderless());
  GUI.Find<UICheckBox>("display.fps").Checked(GShowFPS);
  GUI.Find<UIComboBox>("display.theme").Selected(GTheme);
  GUI.Find<UISlider>("display.stars").Value(float32(GStarCount));
  GUI.Find<UILabel>("display.stars.value").Text(FormatStr("{}", GStarCount));
  GSyncing := false;
  RefreshKeys();
end;

// The HUD's key hint: the bound keys by name
func RefreshHudKeys();
begin
  GUI.Find<UILabel>("hud.keys").Text(FormatStr("{} {} {} {} fly  -  {} boost  -  Esc pause",
    nameof(GKeys[int32(Control.Up)]), nameof(GKeys[int32(Control.Left)]),
    nameof(GKeys[int32(Control.Down)]), nameof(GKeys[int32(Control.Right)]),
    nameof(GKeys[int32(Control.Boost)])));
end;

// ---------------------------------------------------------------------------
// The scene: stars, rocks, sparks and the ship
// ---------------------------------------------------------------------------

// A star at a random place and depth; AFromRight puts it just off the right edge
func NewStar(const AFromRight: bool): Star;
var
  LStar: Star;
begin
  LStar.Depth := 0.15f + float32(Random.Value(0, 85)) / 100.0f;
  LStar.Pos.y := float32(Random.Value(0, BASE_HEIGHT));
  if AFromRight then
    LStar.Pos.x := float32(BASE_WIDTH + Random.Value(0, 40));
  else
    LStar.Pos.x := float32(Random.Value(0, BASE_WIDTH));
  end;
  return LStar;
end;

// The stars stream left, the near ones faster; ASpeed is the world's speed
func MoveStars(const ADelta: float32; const ASpeed: float32);
var
  LI: int32;
begin
  for LI := 0 to GStarCount - 1 do
    GStars[LI].Pos.x := GStars[LI].Pos.x - ASpeed * GStars[LI].Depth * ADelta;
    if GStars[LI].Pos.x < -8.0f then
      GStars[LI] := NewStar(true);
    end;
  end;
end;

// The nebula and the stars; AStreak (0 .. 1) stretches the stars into streaks (the boost)
func DrawScene(const AStreak: float32);
var
  LI: int32;
  LStar: Star;
  LLength: float32;
  LGlow: Vector2;
begin
  Draw.RectGradientV(Rectangle(x: 0.0f, y: 0.0f, width: float32(BASE_WIDTH), height: float32(BASE_HEIGHT)),
    Color(r: 6, g: 9, b: 24, a: 255), Color(r: 24, g: 10, b: 38, a: 255));
  // Two slow clouds of colour drifting on their own circles
  LGlow := Vector2(x: 900.0f + 120.0f * Sin(GTime * 0.07f), y: 260.0f + 60.0f * Cos(GTime * 0.05f));
  Draw.CircleGradient(LGlow, 520.0f, Color(r: 56, g: 189, b: 248, a: 40), Color(r: 56, g: 189, b: 248, a: 0));
  LGlow := Vector2(x: 300.0f + 90.0f * Cos(GTime * 0.06f), y: 520.0f + 70.0f * Sin(GTime * 0.04f));
  Draw.CircleGradient(LGlow, 460.0f, Color(r: 245, g: 184, b: 61, a: 26), Color(r: 245, g: 184, b: 61, a: 0));
  for LI := 0 to GStarCount - 1 do
    LStar := GStars[LI];
    if AStreak > 0.01f then
      LLength := 2.0f + 46.0f * AStreak * LStar.Depth;
      Draw.Line(LStar.Pos, Vector2(x: LStar.Pos.x + LLength, y: LStar.Pos.y), 1.0f + LStar.Depth,
        Color(r: 226, g: 236, b: 248, a: 255).Alpha(0.25f + 0.65f * LStar.Depth));
    else
      Draw.Circle(LStar.Pos, 0.6f + 1.6f * LStar.Depth,
        Color(r: 226, g: 236, b: 248, a: 255).Alpha(0.25f + 0.65f * LStar.Depth));
    end;
  end;
end;

// A new flight: the ship at the left, the sky empty, the boost full
func StartFlight();
var
  LI: int32;
begin
  GShip := Vector2(x: 220.0f, y: float32(BASE_HEIGHT) / 2.0f);
  GShipVel := Vector2(x: 0.0f, y: 0.0f);
  GBoost := 1.0f;
  GBoosting := false;
  GScore := 0.0;
  GFlightTime := 0.0;
  GRockClock := 0.0f;
  GSparkClock := 2.0f;
  GShownScore := -1;
  for LI := 0 to MAX_ROCKS - 1 do
    GRocks[LI].Radius := 0.0f;
  end;
  for LI := 0 to MAX_SPARKS - 1 do
    GSparks[LI].Radius := 0.0f;
  end;
  GUI.Find<UILabel>("hud.pilot").Text(FormatStr("PILOT {}", UpperCase(GSlots[GSlot].Pilot)));
  GUI.Find<UILabel>("hud.best").Text(FormatStr("best {}", GSlots[GSlot].Best));
  RefreshHudKeys();
end;

// A free place in ABodies (-1: all in play)
func FreeBody(const ABodies: array of Body): int32;
var
  LI: int32;
begin
  for LI := 0 to int32(len(ABodies)) - 1 do
    if ABodies[LI].Radius <= 0.0f then
      return LI;
    end;
  end;
  return -1;
end;

// Records the flight in its slot and shows the result (ACrashed: the ship hit a rock)
func EndFlight(const ACrashed: bool);
var
  LScore: int32;
  LBest: bool;
begin
  LScore := int32(Trunc(GScore));
  LBest := LScore > GSlots[GSlot].Best;
  GSlots[GSlot].Flights := GSlots[GSlot].Flights + 1;
  GSlots[GSlot].Seconds := GSlots[GSlot].Seconds + GFlightTime;
  if LBest then
    GSlots[GSlot].Best := LScore;
  end;
  GLastSlot := GSlot;
  SaveAll();
  GUI.Find<UILabel>("over.score").Text(FormatStr("{}", LScore));
  if LBest then
    GUI.Find<UILabel>("over.info").Text(FormatStr("A new best for {}! {} flown.",
      GSlots[GSlot].Pilot, Clock(GFlightTime)));
    PlayEffect(GBestSound);
    GToast.Show(FormatStr("New best: {}", LScore), UIToastKind.Success, 3.0);
  else
    GUI.Find<UILabel>("over.info").Text(FormatStr("{}'s best is {}. {} flown.",
      GSlots[GSlot].Pilot, GSlots[GSlot].Best, Clock(GFlightTime)));
  end;
  if ACrashed then
    PlayEffect(GCrashSound);
  end;
  GoTo(Screen.Over);
end;

// One step of the flight: the ship on the bound keys, the rocks and sparks, the score
func MoveFlight(const ADelta: float32);
var
  LPush: Vector2;
  LI: int32;
  LFree: int32;
  LTop: float32;
begin
  // The thrust from the bound keys (Keyboard.Down: held this frame)
  LPush := Vector2(x: 0.0f, y: 0.0f);
  if Keyboard.Down(GKeys[int32(Control.Up)]) then
    LPush.y := LPush.y - 1.0f;
  end;
  if Keyboard.Down(GKeys[int32(Control.Down)]) then
    LPush.y := LPush.y + 1.0f;
  end;
  if Keyboard.Down(GKeys[int32(Control.Left)]) then
    LPush.x := LPush.x - 1.0f;
  end;
  if Keyboard.Down(GKeys[int32(Control.Right)]) then
    LPush.x := LPush.x + 1.0f;
  end;
  // The boost drains while held, refills slowly while not
  GBoosting := Keyboard.Down(GKeys[int32(Control.Boost)]) and (GBoost > 0.0f);
  if GBoosting then
    GBoost := Max(GBoost - 0.45f * ADelta, 0.0f);
  else
    GBoost := Min(GBoost + 0.12f * ADelta, 1.0f);
  end;
  LTop := SHIP_TOP_SPEED;
  if GBoosting then
    LTop := SHIP_TOP_SPEED * 1.6f;
  end;
  // Thrust, then drag, then the top speed
  GShipVel := GShipVel + LPush * (SHIP_THRUST * ADelta);
  GShipVel := GShipVel * (1.0f - Min(3.5f * ADelta, 1.0f));
  if GShipVel.Length() > LTop then
    GShipVel := GShipVel.Normalize() * LTop;
  end;
  GShip := GShip + GShipVel * ADelta;
  GShip.x := Clamp(GShip.x, 40.0f, float32(BASE_WIDTH) - 200.0f);
  GShip.y := Clamp(GShip.y, 40.0f, float32(BASE_HEIGHT) - 40.0f);

  // The world streams faster as the flight goes on, faster still on the boost
  GWorldSpeed := WORLD_SPEED + WORLD_SPEEDUP * float32(GFlightTime);
  if GBoosting then
    GWorldSpeed := GWorldSpeed * 1.8f;
  end;
  GFlightTime := GFlightTime + float64(ADelta);
  GScore := GScore + SCORE_RATE * float64(ADelta) * float64(GWorldSpeed / WORLD_SPEED);

  // A rock now and then, more often as the flight goes on
  GRockClock := GRockClock - ADelta;
  if GRockClock <= 0.0f then
    GRockClock := Max(0.9f - 0.012f * float32(GFlightTime), 0.22f);
    LFree := FreeBody(GRocks);
    if LFree >= 0 then
      GRocks[LFree].Radius := float32(Random.Value(14, 44));
      GRocks[LFree].Pos := Vector2(x: float32(BASE_WIDTH) + 60.0f, y: float32(Random.Value(30, BASE_HEIGHT - 30)));
      GRocks[LFree].Vel := Vector2(x: -float32(Random.Value(0, 120)), y: float32(Random.Value(-60, 60)));
      GRocks[LFree].Spin := float32(Random.Value(-90, 90));
    end;
  end;
  // A spark every few seconds
  GSparkClock := GSparkClock - ADelta;
  if GSparkClock <= 0.0f then
    GSparkClock := float32(Random.Value(20, 40)) / 10.0f;
    LFree := FreeBody(GSparks);
    if LFree >= 0 then
      GSparks[LFree].Radius := 12.0f;
      GSparks[LFree].Pos := Vector2(x: float32(BASE_WIDTH) + 30.0f, y: float32(Random.Value(60, BASE_HEIGHT - 60)));
      GSparks[LFree].Vel := Vector2(x: 0.0f, y: 0.0f);
    end;
  end;

  // Rocks: move, leave, or end the flight
  for LI := 0 to MAX_ROCKS - 1 do
    if GRocks[LI].Radius > 0.0f then
      GRocks[LI].Pos := GRocks[LI].Pos + (GRocks[LI].Vel + Vector2(x: -GWorldSpeed, y: 0.0f)) * ADelta;
      if GRocks[LI].Pos.x < -80.0f then
        GRocks[LI].Radius := 0.0f;
      else
        // A little forgiving: the rock's edge must reach well inside the ship
        if GRocks[LI].Pos.Distance(GShip) < GRocks[LI].Radius + SHIP_RADIUS * 0.7f then
          EndFlight(true);
          return;
        end;
      end;
    end;
  end;
  // Sparks: move, leave, or be collected
  for LI := 0 to MAX_SPARKS - 1 do
    if GSparks[LI].Radius > 0.0f then
      GSparks[LI].Pos.x := GSparks[LI].Pos.x - GWorldSpeed * ADelta;
      if GSparks[LI].Pos.x < -40.0f then
        GSparks[LI].Radius := 0.0f;
      else
        if GSparks[LI].Pos.Distance(GShip) < GSparks[LI].Radius + SHIP_RADIUS + 6.0f then
          GSparks[LI].Radius := 0.0f;
          GScore := GScore + float64(SPARK_POINTS);
          GBoost := Min(GBoost + 0.25f, 1.0f);
          PlayEffect(GSparkSound);
        end;
      end;
    end;
  end;
end;

// The rocks, the sparks and the ship
func DrawFlight();
var
  LI: int32;
  LFlame: float32;
  LNose: Vector2;
begin
  for LI := 0 to MAX_SPARKS - 1 do
    if GSparks[LI].Radius > 0.0f then
      Draw.CircleGradient(GSparks[LI].Pos, GSparks[LI].Radius * (2.2f + 0.3f * Sin(GTime * 9.0f)),
        Color(r: 245, g: 184, b: 61, a: 200), Color(r: 245, g: 184, b: 61, a: 0));
      Draw.Circle(GSparks[LI].Pos, GSparks[LI].Radius * 0.45f, Color(r: 255, g: 240, b: 200, a: 255));
    end;
  end;
  for LI := 0 to MAX_ROCKS - 1 do
    if GRocks[LI].Radius > 0.0f then
      Draw.Poly(GRocks[LI].Pos, 7, GRocks[LI].Radius, GRocks[LI].Spin * GTime,
        Color(r: 74, g: 66, b: 86, a: 255));
      Draw.PolyLines(GRocks[LI].Pos, 7, GRocks[LI].Radius, GRocks[LI].Spin * GTime, 2.0f,
        Color(r: 140, g: 128, b: 160, a: 255));
    end;
  end;
  // The engine's flame flickers, longer on the boost
  LFlame := 14.0f + 6.0f * Sin(GTime * 40.0f);
  if GBoosting then
    LFlame := LFlame * 2.4f;
  end;
  Draw.Triangle(Vector2(x: GShip.x - 14.0f, y: GShip.y - 7.0f),
    Vector2(x: GShip.x - 14.0f - LFlame, y: GShip.y),
    Vector2(x: GShip.x - 14.0f, y: GShip.y + 7.0f), Color(r: 245, g: 184, b: 61, a: 230));
  // The hull: a wedge pointing right (raylib's triangles run counter-clockwise)
  LNose := Vector2(x: GShip.x + 22.0f, y: GShip.y);
  Draw.Triangle(LNose, Vector2(x: GShip.x - 16.0f, y: GShip.y - 15.0f),
    Vector2(x: GShip.x - 16.0f, y: GShip.y + 15.0f), Color(r: 56, g: 189, b: 248, a: 255));
  Draw.Triangle(LNose, Vector2(x: GShip.x - 6.0f, y: GShip.y - 5.0f),
    Vector2(x: GShip.x - 6.0f, y: GShip.y + 5.0f), Color(r: 226, g: 236, b: 248, a: 255));
end;

// The HUD's numbers (the score label only when the whole number changed)
func UpdateHud();
var
  LScore: int32;
begin
  LScore := int32(Trunc(GScore));
  if LScore <> GShownScore then
    GShownScore := LScore;
    GUI.Find<UILabel>("hud.score").Text(FormatStr("{}", LScore));
  end;
  GUI.Find<UIProgressBar>("hud.boost").Value(GBoost);
  if GShowFPS then
    GUI.Find<UILabel>("hud.fps").Text(FormatStr("{} fps", Time.FPS()));
  else
    GUI.Find<UILabel>("hud.fps").Text("");
  end;
end;

// ---------------------------------------------------------------------------
// Showing a screen (the change's switch step)
// ---------------------------------------------------------------------------

func ShowScreen(const AScreen: Screen);
begin
  // A flight starts fresh unless it comes back from the pause screen
  if (AScreen = Screen.Flight) and (GScreen <> Screen.Pause) then
    StartFlight();
  end;
  if AScreen = Screen.Title then
    RefreshTitle();
  end;
  if AScreen = Screen.Slots then
    RefreshSlots();
  end;
  if AScreen = Screen.Settings then
    RefreshSettings();
  end;
  if AScreen = Screen.Pause then
    GUI.Find<UILabel>("pause.info").Text(FormatStr("{} - {} points - {} flown",
      GSlots[GSlot].Pilot, int32(Trunc(GScore)), Clock(GFlightTime)));
  end;
  GScreen := AScreen;
  // The Switcher's children are in the Screen choices' order
  GScreens.Index(int32(AScreen));
  UseMusicOf(AScreen);
end;

// Runs the change one step (one frame); its last step ends it
func StepChange();
var
  LStep: FadeStep;
begin
  if not GChanging then
    return;
  end;
  // pull: the generator's next step into LStep, false once it has ended
  if pull(GChange, LStep) then
    GVeil := LStep.Alpha;
    if LStep.Switch then
      ShowScreen(GPending);
    end;
  else
    GVeil := 0.0f;
    GChanging := false;
  end;
end;

// ---------------------------------------------------------------------------
// The actions frontend.xml fires
// ---------------------------------------------------------------------------

// Starts flying slot ASlot, making a new pilot there when it is empty
func FlySlot(const ASlot: int32);
begin
  if (ASlot < 0) or (ASlot >= SLOT_COUNT) then
    return;
  end;
  if not GSlots[ASlot].Used then
    GSlots[ASlot].Used := true;
    GSlots[ASlot].Pilot := PILOT_NAMES[Random.Value(0, 5)];
    GSlots[ASlot].Best := 0;
    GSlots[ASlot].Flights := 0;
    GSlots[ASlot].Seconds := 0.0;
    GToast.Show(FormatStr("Welcome aboard, {}", GSlots[ASlot].Pilot), UIToastKind.Info, 2.5);
  end;
  GSlot := ASlot;
  GLastSlot := ASlot;
  SaveAll();
  GoTo(Screen.Flight);
end;

// Esc and every Back button: what "back" means on each screen
func GoBack();
begin
  match GScreen of
    Screen.Slots:
      GoTo(Screen.Title);
    Screen.Settings:
      GoTo(GSettingsFrom);
    Screen.Flight:
      GoTo(Screen.Pause);
    Screen.Pause:
      GoTo(Screen.Flight);
    Screen.Over:
      GoTo(Screen.Slots);
  else
    // the title screen has nothing behind it
  end;
end;

func DoQuit(const ASender: UIWidget);
begin
  GQuit := true;
end;

func DoBack(const ASender: UIWidget);
begin
  GoBack();
end;

func DoTitleFly(const ASender: UIWidget);
begin
  GoTo(Screen.Slots);
end;

func DoTitleContinue(const ASender: UIWidget);
begin
  FlySlot(GLastSlot);
end;

func DoTitleSettings(const ASender: UIWidget);
begin
  GSettingsFrom := Screen.Title;
  GoTo(Screen.Settings);
end;

// frontend.slot.fly.<i>: AArgument is what follows the prefix, the slot's number
func DoSlotFly(const ASender: UIWidget; const AArgument: string);
begin
  FlySlot(int32(StrToIntDef(AArgument, -1)));
end;

// frontend.slot.erase.<i>
func DoSlotErase(const ASender: UIWidget; const AArgument: string);
var
  LSlot: int32;
  LEmpty: SaveSlot;
begin
  LSlot := int32(StrToIntDef(AArgument, -1));
  if (LSlot < 0) or (LSlot >= SLOT_COUNT) or (not GSlots[LSlot].Used) then
    return;
  end;
  GToast.Show(FormatStr("{} erased", GSlots[LSlot].Pilot), UIToastKind.Warning, 2.5);
  GSlots[LSlot] := LEmpty;
  if GLastSlot = LSlot then
    GLastSlot := -1;
  end;
  SaveAll();
  RefreshSlots();
end;

func DoPauseResume(const ASender: UIWidget);
begin
  GoTo(Screen.Flight);
end;

func DoPauseSettings(const ASender: UIWidget);
begin
  GSettingsFrom := Screen.Pause;
  GoTo(Screen.Settings);
end;

func DoPauseEnd(const ASender: UIWidget);
begin
  EndFlight(false);
end;

func DoOverAgain(const ASender: UIWidget);
begin
  GoTo(Screen.Flight);
end;

func DoOverSlots(const ASender: UIWidget);
begin
  GoTo(Screen.Slots);
end;

func DoOverTitle(const ASender: UIWidget);
begin
  GoTo(Screen.Title);
end;

// Any audio widget: every level read back, shown and saved
func DoAudio(const ASender: UIWidget);
begin
  if GSyncing then
    return;
  end;
  GMaster := GUI.Find<UISlider>("audio.master").Value() / 100.0f;
  GMusicLevel := GUI.Find<UISlider>("audio.music").Value() / 100.0f;
  GEffects := GUI.Find<UISlider>("audio.effects").Value() / 100.0f;
  GMuted := GUI.Find<UICheckBox>("audio.mute").Checked();
  ShowLevel("audio.master", GMaster);
  ShowLevel("audio.music", GMusicLevel);
  ShowLevel("audio.effects", GEffects);
  SaveAll();
end;

func DoFullscreen(const ASender: UIWidget);
begin
  if GSyncing then
    return;
  end;
  if ASender.As<UICheckBox>().Checked() <> GWin.Borderless() then
    GWin.ToggleBorderless();
  end;
end;

// The FPS switch and the star density
func DoDisplay(const ASender: UIWidget);
var
  LI: int32;
  LCount: int32;
begin
  if GSyncing then
    return;
  end;
  GShowFPS := GUI.Find<UICheckBox>("display.fps").Checked();
  LCount := System.Math.Clamp(int32(Round(GUI.Find<UISlider>("display.stars").Value())), 50, MAX_STARS);
  // The stars a higher density adds are made where they will be seen
  for LI := GStarCount to LCount - 1 do
    GStars[LI] := NewStar(false);
  end;
  GStarCount := LCount;
  GUI.Find<UILabel>("display.stars.value").Text(FormatStr("{}", GStarCount));
  SaveAll();
end;

// The theme combo: the whole UI restyled in the next frame
func DoTheme(const ASender: UIWidget);
begin
  if GSyncing then
    return;
  end;
  GTheme := System.Math.Clamp(ASender.As<UIComboBox>().Selected(), 0, 2);
  UITheme.Use(EXAMPLE_THEME_NAMES[GTheme]);
  SaveAll();
end;

// Defaults: the first start's settings back (the slots are kept)
func DoDefaults(const ASender: UIWidget);
begin
  DefaultSettings();
  UITheme.Use(EXAMPLE_THEME_NAMES[GTheme]);
  GCapture := -1;
  RefreshSettings();
  SaveAll();
  GToast.Show("Settings back to their defaults", UIToastKind.Info, 2.0);
end;

// frontend.rebind.<act>: the control waits for the next key pressed
func DoRebind(const ASender: UIWidget; const AArgument: string);
var
  LI: int32;
begin
  for LI := 0 to 4 do
    if CONTROL_ACTS[LI] = AArgument then
      GCapture := LI;
      GUI.Find<UILabel>("keys.status").Text(FormatStr("Press the key for {} (Esc cancels)", CONTROL_TEXTS[LI]));
      RefreshKeys();
    end;
  end;
end;

// Every action name frontend.xml fires, each bound to the routine answering it
func BindActions();
begin
  UIActions.Bind("frontend.quit", DoQuit);
  UIActions.Bind("frontend.back", DoBack);
  UIActions.Bind("frontend.title.fly", DoTitleFly);
  UIActions.Bind("frontend.title.continue", DoTitleContinue);
  UIActions.Bind("frontend.title.settings", DoTitleSettings);
  UIActions.Bind("frontend.pause.resume", DoPauseResume);
  UIActions.Bind("frontend.pause.settings", DoPauseSettings);
  UIActions.Bind("frontend.pause.end", DoPauseEnd);
  UIActions.Bind("frontend.over.again", DoOverAgain);
  UIActions.Bind("frontend.over.slots", DoOverSlots);
  UIActions.Bind("frontend.over.title", DoOverTitle);
  UIActions.Bind("frontend.audio", DoAudio);
  UIActions.Bind("frontend.fullscreen", DoFullscreen);
  UIActions.Bind("frontend.display", DoDisplay);
  UIActions.Bind("frontend.theme", DoTheme);
  UIActions.Bind("frontend.defaults", DoDefaults);
  // One routine for each family of buttons: the prefix routine gets the rest of the name
  UIActions.BindPrefix("frontend.slot.fly.", DoSlotFly);
  UIActions.BindPrefix("frontend.slot.erase.", DoSlotErase);
  UIActions.BindPrefix("frontend.rebind.", DoRebind);
end;

// ---------------------------------------------------------------------------
// Keys the program reads itself
// ---------------------------------------------------------------------------

// A control waiting for its key takes the next one pressed (raylib's key queue,
// Keyboard.Next); a key another control has is swapped over to it
func CaptureKey();
var
  LKey: Key;
  LI: int32;
begin
  LKey := Keyboard.Next();
  while (LKey <> Key.Null) and (GCapture >= 0) do
    if LKey = Key.Escape then
      GUI.Find<UILabel>("keys.status").Text("Rebinding cancelled");
      GCapture := -1;
    else
      if Bindable(LKey) then
        for LI := 0 to 4 do
          if (LI <> GCapture) and (GKeys[LI] = LKey) then
            GKeys[LI] := GKeys[GCapture];
          end;
        end;
        GKeys[GCapture] := LKey;
        GUI.Find<UILabel>("keys.status").Text(FormatStr("{} is now {}", CONTROL_TEXTS[GCapture], nameof(LKey)));
        GCapture := -1;
        PlayEffect(GBindSound);
        SaveAll();
      else
        GUI.Find<UILabel>("keys.status").Text(FormatStr("{} cannot be bound; try another key", nameof(LKey)));
      end;
    end;
    LKey := Keyboard.Next();
  end;
  RefreshKeys();
end;

// ---------------------------------------------------------------------------
// The program
// ---------------------------------------------------------------------------

// The widgets the program keeps, and every Rebind button out of the keyboard's focus (a
// focused button would take Space or Enter for itself while a control waits for its key)
func SetUpUI();
var
  LI: int32;
begin
  GScreens := GUI.Find<UISwitcher>("screens");
  GToast := GUI.Find<UIToast>("toast");
  for LI := 0 to 4 do
    GUI.Find<UIButton>(FormatStr("key.{}.rebind", CONTROL_ACTS[LI])).Focusable(false);
  end;
end;

func Run(): int32;
var
  LHost: RaylibHost;
  LLast: bool;
  LDelta: float32;
  LWasBorderless: bool;
  LI: int32;
begin
  // The shared assets as the program's files: Raven, raylib and libxml2 open entries of
  // bin\assets.zip by their plain names (Examples.Common)
  if not OpenAssets() then
    return 1;
  end;
  defer CloseAssets();

  LoadAll();

  // The DPI-scaled frame window (AV.12); Esc is the program's own (back / pause), never
  // raylib's close key
  GWin := OpenExampleWindow(BASE_WIDTH, BASE_HEIGHT, "Adam - Raven front end");
  if not GWin.Ready() then
    return 1;
  end;
  GWin.SetExitKey(Key.Null);

  // Sound is a bonus: with no audio device the front end runs silent
  if GAudio.Ready() then
    GMenuMusic := MusicRes(MENU_MUSIC).Looping(true);
    GFlightMusic := MusicRes(FLIGHT_MUSIC).Looping(true);
    GSparkSound := SoundRes(SPARK_SOUND);
    GCrashSound := SoundRes(CRASH_SOUND);
    GBindSound := SoundRes(BIND_SOUND);
    GBestSound := SoundRes(BEST_SOUND);
    GMenuMusic.Volume(MusicVolume()).Play();
  end;

  // Raven in raylib's window, the example themes loaded, then the saved one in use
  LHost := OpenExampleUI(GWin, "raven_frontend");
  if not LHost.IsValid() then
    return 1;
  end;
  defer LHost.Close();
  UITheme.Use(EXAMPLE_THEME_NAMES[GTheme]);
  GUI := UIWindow.FromXML(FRONTEND_XML);
  if not GUI.IsValid() then
    return 1;
  end;
  SetUpUI();
  BindActions();

  for LI := 0 to MAX_STARS - 1 do
    GStars[LI] := NewStar(false);
  end;
  GCapture := -1;
  GSlot := 0;
  GScreen := Screen.Title;
  GSettingsFrom := Screen.Title;
  ShowScreen(Screen.Title);

  // The loop runs until the window is closed or Quit; that last frame is still drawn, and
  // saved as the example's snapshot (raven_frontend.png beside this file) before it shows
  LLast := false;
  while not LLast do
    LLast := (not GWin.Running()) or GQuit;
    LDelta := Time.Delta();
    GTime := GTime + LDelta;

    // A control waiting for its key reads the key queue before anything else does
    if GCapture >= 0 then
      CaptureKey();
    else
      if Keyboard.Pressed(Key.Escape) then
        GoBack();
      end;
    end;
    // Leaving Settings drops a rebind waiting there
    if (GScreen <> Screen.Settings) and (GCapture >= 0) then
      GCapture := -1;
    end;

    StepChange();
    UpdateMusic();
    LHost.Update(GUI);

    // The world moves only while flying and no change runs (the veil holds it still)
    if (GScreen = Screen.Flight) and (not GChanging) then
      MoveFlight(LDelta);
      MoveStars(LDelta, GWorldSpeed);
    else
      MoveStars(LDelta, 40.0f);
    end;
    if GScreen = Screen.Flight then
      UpdateHud();
    end;

    // F11 / Alt+Enter: borderless fullscreen and back (Examples.Common); the Settings switch
    // follows it
    LWasBorderless := GWin.Borderless();
    ExampleFullscreenKeys(GWin);
    if GWin.Borderless() <> LWasBorderless then
      GSyncing := true;
      GUI.Find<UICheckBox>("display.fullscreen").Checked(GWin.Borderless());
      GSyncing := false;
    end;

    GWin.BeginFrame();
    if GScreen = Screen.Flight then
      DrawScene(Min(Max(GWorldSpeed / WORLD_SPEED - 1.0f, 0.0f), 1.0f));
    else
      DrawScene(0.0f);
    end;
    if (GScreen = Screen.Flight) or (GScreen = Screen.Pause) or (GScreen = Screen.Over) then
      DrawFlight();
    end;
    // The screen's widgets over the scene, then the veil over everything
    LHost.Draw(GUI);
    if GVeil > 0.0f then
      Draw.Rect(Rectangle(x: 0.0f, y: 0.0f, width: float32(BASE_WIDTH), height: float32(BASE_HEIGHT)),
        Color(r: 3, g: 5, b: 14, a: 255).Alpha(GVeil));
    end;
    if LLast then
      SaveExampleSnapshot(GWin, SNAPSHOT_NAME);
    end;
    GWin.EndFrame();
  end;
  SaveAll();
  return 0;
end;

begin
  return Run();
end.
