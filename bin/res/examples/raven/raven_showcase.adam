  This Source Code Form is subject to the terms of the
  Mozilla Public License, v. 2.0. If a copy of the MPL
  was not distributed with this file, You can obtain one
  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raven_showcase.adam - every kind of Raven widget in one window, laid over a
  live raylib scene, the whole UI switching theme while it runs.

  WHAT IT SHOWS
  - A raylib frame window (System.Raylib.Ext's InitFrameWindow): a base size
    of 1180 x 760 opened at the monitor's scale (DPI / 96), so it is the
    same size to the eye on every monitor, follows a DPI change when it
    moves to another monitor, and keeps its aspect (letterboxed) when
    resized. In it raylib draws an animated scene in base units: glowing
    orbs drifting on their orbits, a grid, Adam's logo turning.
  - Raven inside the frame: its window is the frame's base size, laid out
    in base units, scaled and letterboxed with the frame, its text
    rasterized at the real pixel density (sharp at any DPI).
  - One Raven window over it (System.Raven.Raylib): built from an XML file,
    ui\showcase.xml, with a menu bar, a tab view, buttons in every style,
    check boxes, a switch, radio buttons, a slider driving a progress bar, a
    spin box, text inputs, a list, a tree, expanders, an image, a color
    picker, a Markdown label, a timeline and a node graph.
  - Three themes (ui\theme_aurora.xml, theme_ember.xml, theme_paper.xml)
    loaded at start and switched LIVE from the combo box, the Theme menu or
    Ctrl+T: Raven restyles every widget in the next frame.
  - The UI drives the scene: the grid and animation toggles, the speed
    radios, the glow slider, the orb count, the tint color and the Gold
    button all change what raylib draws behind the panels.
  - Every file comes from bin\assets.zip: the XML window, the themes, the
    font and images it names, and raylib's texture. Nothing is read loose.
  - Its last frame is saved as raven_showcase.png beside this file when it
    exits (Examples.Common's SaveExampleSnapshot), the picture a user sees
    while browsing the examples.

  ADAM FEATURES ON SHOW
  - defer: every resource is released by a defer written right where it is
    opened, so the clean-up order is the reverse of the opening order, on
    every way out of Run (the early return when the window cannot open too).
  - Routine values: Raven reports every action by name, and each name is
    bound to the Adam routine answering it (Examples.Common's BindAction,
    a Map<string, ActionFn> of routine values; BindActionPrefix for the
    "showcase.use.<Theme>" names that carry their theme).
  - Shared code at two levels: examples\common\Examples.Common.adam for
    what the examples share (OpenAssets, OpenExampleWindow, StartRaven,
    BindAction), the std for what any program can use (FindWidget,
    SetWidgetText, ColorFromHex).
  - Objects with static methods and methods: Orb.Make builds an orb, Orb's
    methods move and draw it; List<Orb> holds them.
  - match: the speed radios and the tab index pick their values by match.
  - FormatStr: every status line is formatted text (Adam's format intrinsic,
    the types of its arguments taken from the AST at the call).
  - `return` from the main block sets the program's exit code.
  - @exeicon: the program's icon, on the exe and on its window.

  BUILD AND RUN (from repo\bin, the folder of adam.exe and assets.zip)
    adam build res\examples\raven\raven_showcase.adam -o output -r
  -r runs the program once built. For linux add -t x86_64-linux-gnu: on
  Windows -r runs the linux build through WSL2 (its display, WSLg), on
  linux natively. With no display at all the example says so and exits.
  assets.zip is found as $P:../../../../assets.zip: four folders up from the
  exe (output\bin\<triple>\<mode>\), which is repo\bin.
*******************************************************************************/

module exe raven_showcase;

// Adam's icon: on win64 the exe file's icon and, through System.Raylib.Ext, the raylib window's
// (title bar, taskbar, Alt+Tab); on linux the window's (an ELF file has none). $P: is the folder
// adam.exe is in, so the path is the same for every build
@exeicon "$P:res/assets/icons/adam.ico";

// The examples' shared unit (Examples.Common) lives in res\examples\common
@addmodulepath "$P:res/examples/common";

// System.Math before System.Raylib.C: a bare name two imports export is the
// last one's (BNF sec 1), so raylib's Vector2 / Color are the ones used here
import System.SysUtils, System.Math, System.Collections, System.CustomIO, System.HookIO,
  System.Raylib.C, System.Raylib.Ext, System.Raven.C, System.Raven.Ext, System.Raven.Raylib,
  Examples.Common;

const
  // Entries of the zip, by their own names (the zip is the path source)
  SHOWCASE_XML: string = "res/assets/ui/showcase.xml";
  LOGO_PNG: string = "res/assets/images/adam.png";
  // This example under res\examples, for its snapshot (Examples.Common's SaveExampleSnapshot)
  SNAPSHOT_NAME: string = "raven/raven_showcase";
  // The Theme menu's items, in the same order (their Name in showcase.xml)
  THEME_MENU_ITEMS: array[0..2] of string = ["menu_aurora", "menu_ember", "menu_paper"];
  // The tab titles of showcase.xml's TabView, for the status line
  TAB_TITLES: array[0..3] of string = ["Controls", "Lists", "Media", "Tools"];
  // The action prefix of the Theme menu's items: "showcase.use.<Theme>"
  USE_THEME_PREFIX: string = "showcase.use.";
  // The frame's base size: everything is drawn in these units, the window opening at this size
  // x the monitor's scale (DPI / 96); Raven's window is this size too
  BASE_WIDTH: int32 = 1180;
  BASE_HEIGHT: int32 = 760;
  // The grid's cell, in pixels
  GRID_CELL: int32 = 48;
  // The most orbs the spin box allows (showcase.xml's SpinBox Max)
  MAX_ORBS: int32 = 48;
  // How long the Gold button's burst lasts, in seconds
  BURST_SECONDS: float64 = 1.2;

type
  // One glowing orb of the scene: it circles a centre on an ellipse.
  // An object: its data and the methods working on it travel together.
  Orb = object
    FCentre: Vector2;
    FRadiusX: float32;
    FRadiusY: float32;
    FPhase: float32;
    FSpin: float32;
    FSize: float32;

    // A new orb, number AIndex of ACount, spread evenly round the screen.
    // A static method: called on the type (Orb.Make), it needs no orb.
    static method Make(const AIndex: int32; const ACount: int32): Orb;
    var
      LOrb: Orb;
      LT: float32;
    begin
      // LT runs 0 .. 1 over the orbs, so each gets its own place and pace
      LT := float32(AIndex) / float32(ACount);
      LOrb.FCentre := Vector2(x: 0.15f + 0.7f * LT, y: 0.5f + 0.25f * Sin(LT * 11.0f));
      LOrb.FRadiusX := 0.08f + 0.12f * Cos(LT * 7.0f) * Cos(LT * 7.0f);
      LOrb.FRadiusY := 0.05f + 0.1f * Sin(LT * 5.0f) * Sin(LT * 5.0f);
      LOrb.FPhase := LT * 6.2831853f;
      LOrb.FSpin := 0.6f + 0.8f * LT;
      if AIndex mod 2 = 1 then
        // Every other orb turns the other way round its centre
        LOrb.FSpin := -LOrb.FSpin;
      end;
      LOrb.FSize := 40.0f + 90.0f * Sin(LT * 3.1415926f);
      return LOrb;
    end;

    // Where the orb is at the scene time ATime, in pixels of a AWidth x AHeight screen
    method At(const ATime: float32; const AWidth: int32; const AHeight: int32): Vector2;
    var
      LAngle: float32;
    begin
      LAngle := self.FPhase + self.FSpin * ATime;
      return Vector2(x: (self.FCentre.x + self.FRadiusX * Cos(LAngle)) * float32(AWidth),
        y: (self.FCentre.y + self.FRadiusY * Sin(LAngle)) * float32(AHeight));
    end;

    // Draws the orb: a soft gradient disc in ATint, AGlow (0 .. 1) its brightness
    method Draw(const ATime: float32; const AWidth: int32; const AHeight: int32;
      const ATint: Color; const AGlow: float32);
    var
      LWhere: Vector2;
    begin
      LWhere := self.At(ATime, AWidth, AHeight);
      DrawCircleGradient(LWhere, self.FSize, ColorAlpha(ATint, 0.15f + 0.6f * AGlow),
        ColorAlpha(ATint, 0.0f));
    end;
  end;

var
  // The Raven window (the UI layer) and the widgets the actions read or write
  GUi: Rid;
  GStatus: Rid;
  // The scene's settings, written by the UI
  GOrbs: List<Orb>;
  GShowGrid: bool;
  GAnimate: bool;
  GSpeed: float32;
  GGlow: float32;
  GTint: Color;
  // The scene's own clock: it stops while the animation is off
  GSceneTime: float64;
  // When the Gold button last fired (GetTime), or a negative time for none yet
  GBurstStart: float64;
  // The theme in use (index into EXAMPLE_THEME_NAMES) and whether a switch is being applied
  GTheme: int32;
  GApplyingTheme: bool;
  // Clicks on the Ping buttons
  GPings: int32;
  // Set by the quit action: the loop ends at the next frame
  GQuit: bool;

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

// Writes AText to the status line at the window's foot
routine SetStatus(const AText: string);
begin
  SetWidgetText(GStatus, AText);
end;

// The widget of the UI window named AName (R_INVALID_ID when it has none)
routine Find(const AName: string): Rid;
begin
  return FindWidget(GUi, AName);
end;

// Builds ACount orbs in place of the ones the scene has
routine MakeOrbs(const ACount: int32);
var
  LI: int32;
begin
  GOrbs.Clear();
  for LI := 0 to ACount - 1 do
    GOrbs.Add(Orb.Make(LI, ACount));
  end;
end;

// ---------------------------------------------------------------------------
// Themes
// ---------------------------------------------------------------------------

// Makes theme AIndex the application's theme and keeps every theme control in step with it:
// the combo box, the Theme menu's check marks and the status line
routine SwitchTheme(const AIndex: int32);
var
  LI: int32;
  LItem: Rid;
begin
  if (AIndex < 0) or (AIndex > 2) then
    return;
  end;
  // Setting the combo box below fires showcase.theme again: this flag makes that a no-op
  GApplyingTheme := true;
  defer GApplyingTheme := false;
  UseTheme(EXAMPLE_THEME_NAMES[AIndex]);
  GTheme := AIndex;
  Rcombo_box_set_selected(Find("theme"), AIndex);
  for LI := 0 to 2 do
    LItem := Find(THEME_MENU_ITEMS[LI]);
    if LI = AIndex then
      Rmenu_item_set_checked(LItem, R_TRUE);
    else
      Rmenu_item_set_checked(LItem, R_FALSE);
    end;
  end;
  SetStatus(FormatStr("Theme {} in use: every widget restyled live", EXAMPLE_THEME_NAMES[AIndex]));
end;

// ---------------------------------------------------------------------------
// The actions: one routine per name showcase.xml uses
// ---------------------------------------------------------------------------

routine DoQuit(const ASender: Rid);
begin
  GQuit := true;
end;

routine DoAbout(const ASender: Rid);
begin
  SetStatus("raven_showcase: Raven widgets over raylib, written in Adam - every file from assets.zip");
end;

// The combo box changed: its selection is the theme
routine DoTheme(const ASender: Rid);
begin
  if GApplyingTheme then
    return;
  end;
  SwitchTheme(Rcombo_box_get_selected(ASender));
end;

routine DoNextTheme(const ASender: Rid);
begin
  SwitchTheme((GTheme + 1) mod 3);
end;

routine DoTab(const ASender: Rid);
var
  LIndex: int32;
begin
  LIndex := Rtab_view_get_active(ASender);
  if (LIndex >= 0) and (LIndex <= 3) then
    SetStatus(FormatStr("Tab {} of 4: {}", LIndex + 1, TAB_TITLES[LIndex]));
  end;
end;

routine DoPing(const ASender: Rid);
begin
  GPings := GPings + 1;
  SetStatus(FormatStr("Ping #{} from the button '{}'", GPings, StringFromC(Rwidget_get_name(ASender))));
end;

// The Gold button: a burst ring grows from the screen's centre in the raylib scene
routine DoBurst(const ASender: Rid);
begin
  GBurstStart := GetTime();
  SetStatus("Burst! raylib draws it, Raven stays on top");
end;

routine DoGrid(const ASender: Rid);
begin
  GShowGrid := Rcheckbox_is_checked(ASender) <> 0;
  SetStatus(FormatStr("Grid shown: {}", GShowGrid));
end;

routine DoAnimate(const ASender: Rid);
begin
  GAnimate := Rcheckbox_is_checked(ASender) <> 0;
  SetStatus(FormatStr("Animation running: {}", GAnimate));
end;

// The speed radios: the checked one names the speed; radios of one parent are exclusive, so
// a click fires this for the one turned off too, and the one turned on decides
routine DoSpeed(const ASender: Rid);
var
  LName: string;
begin
  if Rcheckbox_is_checked(ASender) = 0 then
    return;
  end;
  LName := StringFromC(Rwidget_get_name(ASender));
  // (a widget's name: Rwidget_get_name's C text copied into an Adam string)
  if LName = "speed_slow" then
    GSpeed := 0.4f;
  else
    if LName = "speed_fast" then
      GSpeed := 2.5f;
    else
      GSpeed := 1.0f;
    end;
  end;
  SetStatus(FormatStr("Scene speed x{}", GSpeed));
end;

// The glow slider: 0 .. 100 drives the orbs' brightness and the progress bar beneath it
routine DoGlow(const ASender: Rid);
begin
  GGlow := Rslider_get_value(ASender) / 100.0f;
  Rprogress_bar_set_value(Find("glow_bar"), GGlow);
  SetStatus(FormatStr("Glow {}%", Floor(GGlow * 100.0f + 0.5f)));
end;

routine DoOrbs(const ASender: Rid);
var
  LCount: int32;
begin
  LCount := int32(Rspin_box_get_value(ASender));
  if LCount < 1 then
    LCount := 1;
  end;
  if LCount > MAX_ORBS then
    LCount := MAX_ORBS;
  end;
  MakeOrbs(LCount);
  SetStatus(FormatStr("{} orbs in the scene", LCount));
end;

routine DoGreet(const ASender: Rid);
var
  LName: string;
begin
  LName := Trim(WidgetText(Find("name")));
  if len(LName) = 0 then
    SetStatus("Type a name first, then press Enter or Greet");
    return;
  end;
  SetStatus(FormatStr("Hello, {}! Adam and Raven say hi", LName));
end;

routine DoFeature(const ASender: Rid);
var
  LIndex: int32;
begin
  LIndex := Rlist_view_get_selected(ASender);
  if LIndex < 0 then
    return;
  end;
  SetStatus(FormatStr("Adam feature: {}", StringFromC(Rlist_view_get_item_text(ASender, LIndex))));
end;

routine DoTree(const ASender: Rid);
var
  LItem: Rid;
begin
  LItem := Rtree_view_get_selected_item(ASender);
  if LItem = R_INVALID_ID then
    return;
  end;
  SetStatus(FormatStr("Tree: {}", StringFromC(Rtree_item_get_text(LItem))));
end;

routine DoTint(const ASender: Rid);
var
  LHex: string;
begin
  LHex := StringFromC(Rcolor_picker_get_hex(ASender));
  GTint := ColorFromHex(LHex, WHITE);
  SetStatus(FormatStr("Orbs tinted {}", LHex));
end;

routine DoTime(const ASender: Rid);
begin
  SetStatus(FormatStr("Timeline at {} s", float64(Floor(Rtimeline_get_time(ASender) * 100.0 + 0.5)) / 100.0));
end;

// Back to how the showcase started: settings, controls and theme
routine DoReset(const ASender: Rid);
begin
  GShowGrid := true;
  GAnimate := true;
  GSpeed := 1.0f;
  GGlow := 0.6f;
  GTint := ColorFromHex("#38BDF8", WHITE);
  GPings := 0;
  MakeOrbs(12);
  Rcheckbox_set_checked(Find("grid"), R_TRUE);
  Rcheckbox_set_checked(Find("animate"), R_TRUE);
  Rcheckbox_set_checked(Find("speed_normal"), R_TRUE);
  Rslider_set_value(Find("glow"), 60.0f);
  Rprogress_bar_set_value(Find("glow_bar"), 0.6f);
  Rspin_box_set_value(Find("orbs"), 12.0);
  Rcolor_picker_set_hex(Find("tint"), "#38BDF8");
  SwitchTheme(0);
  SetStatus("Everything back to the start");
end;

// The Theme menu's items fire "showcase.use.<Theme>": the theme's name is the argument
routine DoUseTheme(const ASender: Rid; const ATheme: string);
var
  LI: int32;
begin
  for LI := 0 to 2 do
    if EXAMPLE_THEME_NAMES[LI] = ATheme then
      SwitchTheme(LI);
    end;
  end;
end;

// Every action name showcase.xml fires, each bound to the routine answering it
routine BindActions();
begin
  BindAction("showcase.quit", DoQuit);
  BindAction("showcase.about", DoAbout);
  BindAction("showcase.theme", DoTheme);
  BindAction("showcase.next_theme", DoNextTheme);
  BindAction("showcase.tab", DoTab);
  BindAction("showcase.ping", DoPing);
  BindAction("showcase.burst", DoBurst);
  BindAction("showcase.grid", DoGrid);
  BindAction("showcase.animate", DoAnimate);
  BindAction("showcase.speed", DoSpeed);
  BindAction("showcase.glow", DoGlow);
  BindAction("showcase.orbs", DoOrbs);
  BindAction("showcase.greet", DoGreet);
  BindAction("showcase.feature", DoFeature);
  BindAction("showcase.tree", DoTree);
  BindAction("showcase.tint", DoTint);
  BindAction("showcase.time", DoTime);
  BindAction("showcase.reset", DoReset);
  BindActionPrefix(USE_THEME_PREFIX, DoUseTheme);
end;

// ---------------------------------------------------------------------------
// The raylib scene, drawn behind the Raven window every frame, in the frame's base units
// ---------------------------------------------------------------------------

routine DrawScene(const ALogo: Texture2D);
var
  LWidth: int32;
  LHeight: int32;
  LTime: float32;
  LI: int64;
  LX: int32;
  LY: int32;
  LAge: float64;
  LLogoSize: float32;
  LCentre: Vector2;
begin
  // Base units: the frame scales them to the window (GetFrameWidth / GetFrameHeight = the base size)
  LWidth := GetFrameWidth();
  LHeight := GetFrameHeight();
  LTime := float32(GSceneTime);
  // A deep vertical gradient: the night the orbs float in
  DrawRectangleGradientV(0, 0, LWidth, LHeight, Color(r: 6, g: 10, b: 24, a: 255),
    Color(r: 18, g: 10, b: 36, a: 255));
  if GShowGrid then
    for LX := 0 to LWidth div GRID_CELL do
      DrawLineV(Vector2(x: float32(LX * GRID_CELL), y: 0.0f),
        Vector2(x: float32(LX * GRID_CELL), y: float32(LHeight)), Color(r: 255, g: 255, b: 255, a: 10));
    end;
    for LY := 0 to LHeight div GRID_CELL do
      DrawLineV(Vector2(x: 0.0f, y: float32(LY * GRID_CELL)),
        Vector2(x: float32(LWidth), y: float32(LY * GRID_CELL)), Color(r: 255, g: 255, b: 255, a: 10));
    end;
  end;
  for LI := 0 to GOrbs.Count - 1 do
    GOrbs[LI].Draw(LTime, LWidth, LHeight, GTint, GGlow);
  end;
  // Adam's logo, slowly turning in the lower right corner (its pivot is its centre)
  LLogoSize := 220.0f;
  DrawTexturePro(ALogo, Rectangle(x: 0.0f, y: 0.0f, width: float32(ALogo.width), height: float32(ALogo.height)),
    Rectangle(x: float32(LWidth) - 150.0f, y: float32(LHeight) - 150.0f, width: LLogoSize, height: LLogoSize),
    Vector2(x: LLogoSize / 2.0f, y: LLogoSize / 2.0f), LTime * 8.0f, ColorAlpha(WHITE, 0.35f));
  // The Gold button's burst: a ring growing and fading from the centre
  LAge := GetTime() - GBurstStart;
  if (GBurstStart >= 0.0) and (LAge < BURST_SECONDS) then
    LCentre := Vector2(x: float32(LWidth) / 2.0f, y: float32(LHeight) / 2.0f);
    DrawRing(LCentre, float32(LAge) * 520.0f, float32(LAge) * 520.0f + 14.0f, 0.0f, 360.0f, 96,
      ColorAlpha(Color(r: 245, g: 184, b: 61, a: 255), float32(1.0 - LAge / BURST_SECONDS)));
  end;
end;

// ---------------------------------------------------------------------------
// The program
// ---------------------------------------------------------------------------

// Opens everything, runs the loop, and lets the defers release it all in reverse order.
// Returns the program's exit code.
routine Run(): int32;
var
  LAssets: IOSource;
  LLogo: Texture2D;
  LPath: ptr to char;
  LLast: bool;
begin
  // The shared assets as the program's files: every plain file name raylib or Raven opens is
  // an entry of bin\assets.zip (Examples.Common)
  LAssets := OpenAssets();
  if LAssets = nil then
    return 1;
  end;
  defer CloseAssets(LAssets);

  // The DPI-scaled frame window (AV.12): BASE_WIDTH x BASE_HEIGHT x the monitor's scale
  if not OpenExampleWindow(BASE_WIDTH, BASE_HEIGHT, "Adam - Raven showcase") then
    return 1;
  end;
  defer CloseExampleWindow();

  // Raven in raylib's window, the example themes loaded, Aurora in use
  if not StartRaven("raven_showcase") then
    return 1;
  end;
  defer CloseRaven();

  // The UI layer, built from the XML window (its image and font named relative to it)
  GUi := LoadWindow(SHOWCASE_XML);
  if GUi = R_INVALID_ID then
    return 1;
  end;
  GStatus := Find("status");
  BindActions();

  // raylib's own texture, through the same zip
  LPath := StringToC(LOGO_PNG);
  LLogo := LoadTexture(LPath);
  freemem(LPath);
  defer UnloadTexture(LLogo);
  SetTextureFilter(LLogo, TEXTURE_FILTER_BILINEAR);

  // The starting state, the same as the Reset button's
  GBurstStart := -1.0;
  DoReset(R_INVALID_ID);
  SetStatus("Ready: try the theme picker (Ctrl+T), the toggles and the sliders");

  // The loop runs until the window is closed or Quit is chosen; that last frame is still drawn,
  // and saved as the example's snapshot (raven_showcase.png beside this file) before it is shown
  LLast := false;
  while not LLast do
    LLast := WindowShouldClose() or GQuit;
    // Raven first: it takes this frame's input and lays out what changed
    UpdateRaven(GUi);
    if GAnimate then
      GSceneTime := GSceneTime + float64(GetFrameTime()) * float64(GSpeed);
    end;
    BeginDrawing();
    // BeginFrame clears the window to the bar colour and holds drawing to the letterbox, in
    // base units; the scene and Raven both draw there, Raven last so it is on top
    BeginFrame();
    DrawScene(LLogo);
    DrawRaven(GUi);
    EndFrame();
    // The back buffer holds the finished frame until EndDrawing shows it (Examples.Common)
    if LLast then
      SaveExampleSnapshot(SNAPSHOT_NAME);
    end;
    EndDrawing();
  end;
  return 0;
end;

begin
  return Run();
end.
