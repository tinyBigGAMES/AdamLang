-------------------------------------------------------------------------------
  Examples.Common.adam - what Adam's examples share and an application of
  your own would write its own way: where the shared assets are and how they
  are opened, the example window and Raven started with the example themes,
  the fullscreen keys every example shares (F11 / Alt+Enter), and the
  snapshot each
  example saves of its last frame beside its own .adam file
  (SaveExampleSnapshot: the picture a user browsing the examples sees).

  An example reaches this unit with
    @addmodulepath "$P:res/examples/common";
    import Examples.Common;
  ($P: is the folder adam.exe is in, so the path is the same in the repo and
  in an unzipped release). Everything every Adam program could use lives in
  the std instead (System.Raven.Ext's UIWidget / UIErrors.Report / UIActions / UITheme.Use,
  System.Raylib.Ext's Window / Assets /
  Color.Hex, System.SysUtils' ReplaceStr / NormalizePath).

  Each example still releases what it opens itself, so the order of the
  clean-up stays visible in the example: the assets and Raven by defers,
  the window by its Window value (its last copy closes it, every GPU
  resource still alive unloaded first):
    if not OpenAssets() then return 1; end;      defer CloseAssets();
    LWin := OpenExampleWindow(1280, 720, "...");  (LWin.Ready() false: no display)
    LHost := OpenExampleUI(LWin, "...");        defer LHost.Close();
*******************************************************************************/

module unit Examples.Common;

import System.SysUtils, System.IO, System.Raylib.C, System.Raylib.Ext,
  System.Raven.C, System.Raven.Ext, System.Raven.Raylib;

public const
  /// `bin\assets.zip` beside adam, as an example's exe in `output\bin\<triple>\<mode>` sees it
  /// (`$P:` is the exe's folder at run time)
  EXAMPLE_ASSETS_ZIP: string = "$P:../../../../assets.zip";
  /// The shared assets' password
  EXAMPLE_ASSETS_PASSWORD: string = "Adam";
  /// `res\examples\` (the examples' own folder), as an example's exe in
  /// `output\bin\<triple>\<mode>` sees it: where SaveExampleSnapshot writes
  EXAMPLE_FOLDER: string = "$P:../../../../res/examples/";
  /// The example themes, in the order the examples offer them: Adam's own `Aurora` first
  EXAMPLE_THEME_NAMES: array[0..2] of string = ["Aurora", "Ember", "Paper"];
  /// The theme files of `EXAMPLE_THEME_NAMES`, entries of the assets
  EXAMPLE_THEME_FILES: array[0..2] of string = ["res/assets/ui/theme_aurora.xml",
    "res/assets/ui/theme_ember.xml", "res/assets/ui/theme_paper.xml"];

/// Mounts the shared assets (`bin\assets.zip`) as the program's files (`Assets.Mount`):
/// raylib's loads, Raven's and libxml2's opens and every C runtime open by a plain path read
/// entries of the zip by their own names. A program's own files still go through System.IO
/// to the disk.
/// @returns `true` when the zip is mounted; `false` with the reason printed
/// @example `if not OpenAssets() then return 1; end; defer CloseAssets();`
public func OpenAssets(): bool;
begin
  if not Assets.Mount(EXAMPLE_ASSETS_ZIP, EXAMPLE_ASSETS_PASSWORD) then
    println("cannot use {} as the program's files", EXAMPLE_ASSETS_ZIP);
    return false;
  end;
  return true;
end;

/// Gives the program's files back to the disk and closes the zip `OpenAssets` mounted
/// (`Assets.Unmount`; nothing when none is mounted)
public func CloseAssets();
begin
  Assets.Unmount();
end;

/// Opens the example window: System.Raylib.Ext's DPI-scaled frame window (AV.12) of a
/// `ABaseWidth` x `ABaseHeight` base size, with vsync and 4x MSAA, raylib's own log cut to its
/// warnings. Draw in base units between the window's `BeginFrame` and `EndFrame`; its last copy
/// closes it (a failed open has nothing to close, AV.9).
/// @param ABaseWidth the base width
/// @param ABaseHeight the base height
/// @param ATitle the window's title
/// @returns the window; `Ready()` false, the reason printed, when it could not open (no
///   display ...)
/// @example `LWin := OpenExampleWindow(1280, 720, "Adam - demo"); if not LWin.Ready() then return 1; end;`
public func OpenExampleWindow(const ABaseWidth: int32; const ABaseHeight: int32;
  const ATitle: string): Window;
var
  LWin: Window;
begin
  Log.Level(LogLevel.Warning);
  LWin := Window.Config().Size(ABaseWidth, ABaseHeight).Title(ATitle).Flags([WindowFlag.VSyncHint,
    WindowFlag.Msaa4xHint]).Open();
  if not LWin.Ready() then
    println("the window could not open (no display?)");
  end;
  return LWin;
end;

/// Toggles the example window's fullscreen on F11 or Alt+Enter (the keys every example shares):
/// borderless fullscreen (`Window.ToggleBorderless`), the window covering its monitor at the
/// desktop's own mode, the frame letterboxed in it as in the window; no display mode switch.
/// Call it once a frame, before the window's `BeginFrame`.
/// @param AWindow the example's window
/// @example `while not LLast do LLast := not LWin.Running(); ExampleFullscreenKeys(LWin); ... end;`
public func ExampleFullscreenKeys(var AWindow: Window);
var
  LAlt: bool;
  LEnter: bool;
begin
  LAlt := Keyboard.Down(Key.LeftAlt) or Keyboard.Down(Key.RightAlt);
  LEnter := Keyboard.Pressed(Key.Enter) or Keyboard.Pressed(Key.KpEnter);
  if Keyboard.Pressed(Key.F11) or (LAlt and LEnter) then
    AWindow.ToggleBorderless();
  end;
end;

/// Starts Raven in the example window (System.Raven.Raylib's `RaylibHost`) with its errors on
/// the console (`UIErrors.Report`), loads the example themes and makes `Aurora` the theme.
/// @param AWindow the example's window (open)
/// @param AAppName the application's name for Raven
/// @returns the host (`IsValid()` false, the reason printed, when Raven did not start); its
///   last copy, or `Close`, ends Raven before the window goes
/// @example `LHost := OpenExampleUI(LWin, "raven_showcase"); if not LHost.IsValid() then return 1; end; defer LHost.Close();`
public func OpenExampleUI(const AWindow: Window; const AAppName: string): RaylibHost;
var
  LHost: RaylibHost;
  LI: int32;
begin
  UIErrors.Report();
  LHost := RaylibHost(AWindow, AAppName);
  if not LHost.IsValid() then
    println("Raven did not start");
    return LHost;
  end;
  for LI := 0 to 2 do
    UITheme.Load(EXAMPLE_THEME_FILES[LI]);
  end;
  UITheme.Use(EXAMPLE_THEME_NAMES[0]);
  return LHost;
end;

/// Saves what `AWindow` shows as `<AExample>.png` beside the example's own `.adam` file under
/// `res\examples` (`"raven/raven_showcase"` -> `res\examples\raven\raven_showcase.png`), so a
/// user browsing the examples sees what each one is about.
///
/// Call it once, in the example's **last frame**, after all its drawing and before the window's
/// `EndFrame` (`Window.Snapshot` reads the back buffer, which `EndFrame` hands to the next
/// frame). The file goes to the disk through System.IO, never into the assets: raylib's own
/// `TakeScreenshot` drops the folder and writes through the program's files, which
/// `OpenAssets` made the zip.
/// @param AWindow the example's window
/// @param AExample the example's path under `res\examples`, no extension, `/` between folders
/// @returns `true` when the `.png` was written; `false` with the reason printed
/// @example `if LLast then SaveExampleSnapshot(LWin, "raven/raven_showcase"); end; LWin.EndFrame();`
public func SaveExampleSnapshot(const AWindow: Window; const AExample: string): bool;
var
  LPath: string;
  LImage: ImageRes;
  LBytes: array of uint8;
begin
  LPath := ResolvePath(FormatStr("{}{}.png", EXAMPLE_FOLDER, AExample));
  // The frame so far at the window's real pixel size (raylib reads it with glReadPixels)
  LImage := AWindow.Snapshot();
  if not LImage.IsValid() then
    println("the snapshot {} could not be read from the window", LPath);
    return false;
  end;
  LBytes := LImage.ExportToMemory(".png");
  if len(LBytes) = 0 then
    println("the snapshot {} could not be encoded as PNG", LPath);
    return false;
  end;
  if not WriteAllBytes(LPath, LBytes) then
    println("the snapshot {} could not be written", LPath);
    return false;
  end;
  return true;
end;

end.
