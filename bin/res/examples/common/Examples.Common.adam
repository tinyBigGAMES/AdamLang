-------------------------------------------------------------------------------
  Examples.Common.adam - what Adam's examples share and an application of
  your own would write its own way: where the shared assets are and how they
  are opened, the example window and Raven started with the example themes,
  one table that answers Raven's actions by name, and the snapshot each
  example saves of its last frame beside its own .adam file
  (SaveExampleSnapshot: the picture a user browsing the examples sees).

  An example reaches this unit with
    @addmodulepath "$P:res/examples/common";
    import Examples.Common;
  ($P: is the folder adam.exe is in, so the path is the same in the repo and
  in an unzipped release). Everything every Adam program could use lives in
  the std instead (System.Raven.Ext's FindWidget / SetWidgetText /
  WidgetText / ReportRavenErrors, System.Raylib.Ext's ColorFromHex,
  System.SysUtils' ReplaceStr / NormalizePath).

  Each example still releases what it opens with its own defers, so the
  order of the clean-up stays visible in the example:
    LAssets := OpenAssets();            defer CloseAssets(LAssets);
    OpenExampleWindow(1280, 720, "..."); defer CloseExampleWindow();
    StartRaven("...");                  defer CloseRaven();
*******************************************************************************/

module unit Examples.Common;

import System.SysUtils, System.Collections, System.CustomIO, System.HookIO, System.Raylib.C,
  System.Raylib.Ext, System.Raven.C, System.Raven.Ext, System.Raven.Raylib;

public const
  /// `bin\assets.zip` beside adam, as an example's exe in `output\bin\<triple>\<mode>` sees it
  /// (`$P:` is the exe's folder at run time)
  EXAMPLE_ASSETS_ZIP: string = "$P:../../../../assets.zip";
  /// The shared assets' password
  EXAMPLE_ASSETS_PASSWORD: string = "Adam";
  /// `res\examples\` (the examples' own folder), as an example's exe in
  /// `output\bin\<triple>\<mode>` sees it: where SaveExampleSnapshot writes
  EXAMPLE_FOLDER: string = "$P:../../../../res/examples/";
  /// The example themes, in the order the examples offer them: Adam's own `Aurora` first
  EXAMPLE_THEME_NAMES: array[0..2] of string = ["Aurora", "Ember", "Paper"];
  /// The theme files of `EXAMPLE_THEME_NAMES`, entries of the assets
  EXAMPLE_THEME_FILES: array[0..2] of string = ["res/assets/ui/theme_aurora.xml",
    "res/assets/ui/theme_ember.xml", "res/assets/ui/theme_paper.xml"];

public type
  /// The routine answering one Raven action; `ASender` is the widget that fired it
  ActionFn = func(const ASender: Rid);
  /// The routine answering every action named `<prefix><argument>` (`theme.use.Ember`):
  /// `AArgument` is what follows the prefix
  PrefixActionFn = func(const ASender: Rid; const AArgument: string);

var
  // Action name -> its routine; prefix -> its routine (BindAction / BindActionPrefix)
  GActions: Map<string, ActionFn>;
  GPrefixActions: Map<string, PrefixActionFn>;
  // The prefixes in the order bound: the first that fits a name answers it
  GPrefixes: List<string>;

/// Opens the shared assets (`bin\assets.zip`) and makes them the program's files: raylib's
/// loads, Raven's and libxml2's opens and every C runtime open by a plain path read entries of
/// the zip by their own names (`SetRaylibIOSource`). A program's own files still go through
/// System.IO to the disk.
/// @returns the zip, or `nil` when it cannot be used (the reason printed)
/// @example `LAssets := OpenAssets(); if LAssets = nil then return 1; end; defer CloseAssets(LAssets);`
public func OpenAssets(): IOSource;
var
  LZip: IOSource;
begin
  LZip := CreateZipIOSource(EXAMPLE_ASSETS_ZIP, EXAMPLE_ASSETS_PASSWORD);
  if not SetRaylibIOSource(LZip) then
    println("cannot use {} as the program's files", EXAMPLE_ASSETS_ZIP);
    IOSourceClose(LZip);
    return nil;
  end;
  return LZip;
end;

/// Gives the program's files back to the disk and closes the assets `OpenAssets` opened
/// (nothing for `nil`)
/// @param AAssets what OpenAssets returned
public func CloseAssets(const AAssets: IOSource);
begin
  if AAssets = nil then
    return;
  end;
  SetRaylibIOSource(nil);
  IOSourceClose(AAssets);
end;

/// Opens the example window: raylib's DPI-scaled frame window (`InitFrameWindow`, AV.12) of a
/// `ABaseWidth` x `ABaseHeight` base size, with vsync and 4x MSAA, raylib's own log cut to its
/// warnings. Draw in base units between `BeginFrame` and `EndFrame`.
/// @param ABaseWidth the base width
/// @param ABaseHeight the base height
/// @param ATitle the window's title
/// @returns `true` when it opened; `false` with the reason printed (no display ...)
public func OpenExampleWindow(const ABaseWidth: int32; const ABaseHeight: int32;
  const ATitle: string): bool;
begin
  SetTraceLogLevel(LOG_WARNING);
  SetConfigFlags(uint32(FLAG_VSYNC_HINT) | uint32(FLAG_MSAA_4X_HINT));
  InitFrameWindow(ABaseWidth, ABaseHeight, ATitle);
  if not IsWindowReady() then
    println("the window could not open (no display?)");
    return false;
  end;
  return true;
end;

/// Closes the example window when it opened (when `InitFrameWindow` failed raylib has let go
/// already, and `CloseWindow` would reach unloaded GL calls, AV.9)
public func CloseExampleWindow();
begin
  if IsWindowReady() then
    CloseWindow();
  end;
end;

/// Makes the theme named `AName` the application's (one of `EXAMPLE_THEME_NAMES`, or any
/// Raven knows): every window restyles in its next frame
/// @param AName the theme's name
/// @returns `true` when Raven knows the theme
public func UseTheme(const AName: string): bool;
var
  LUsed: int32;
begin
  LUsed := Rtheme_use(AName);
  return LUsed <> 0;
end;

/// Starts Raven on the example window (System.Raven.Raylib) with its errors on the console
/// (`ReportRavenErrors`), loads the example themes and makes `Aurora` the theme.
/// @param AAppName the application's name for Raven
/// @returns `true` when Raven started; `false` with the reason printed
public func StartRaven(const AAppName: string): bool;
var
  LStarted: bool;
  LI: int32;
begin
  ReportRavenErrors();
  LStarted := InitRaven(AAppName);
  if not LStarted then
    println("Raven did not start");
    return false;
  end;
  for LI := 0 to 2 do
    Rtheme_load(EXAMPLE_THEME_FILES[LI]);
  end;
  UseTheme(EXAMPLE_THEME_NAMES[0]);
  return true;
end;

/// A Raven window built from an XML layout of the assets (`Rwindow_create_from_xml_file`)
/// @param APath the layout's entry name (`res/assets/ui/...`)
/// @returns the window, or `R_INVALID_ID` with the reason printed
public func LoadWindow(const APath: string): Rid;
var
  LWindow: Rid;
begin
  LWindow := Rwindow_create_from_xml_file(APath);
  if LWindow = R_INVALID_ID then
    println("{} did not load", APath);
  end;
  return LWindow;
end;

/// A widget built from an XML layout of the assets (`Rwidget_create_from_xml_file`), for a
/// dialog's content or a part added at run time
/// @param APath the layout's entry name (`res/assets/ui/...`)
/// @returns the widget, or `R_INVALID_ID` with the reason printed
public func LoadWidget(const APath: string): Rid;
var
  LWidget: Rid;
begin
  LWidget := Rwidget_create_from_xml_file(APath);
  if LWidget = R_INVALID_ID then
    println("{} did not load", APath);
  end;
  return LWidget;
end;

// Raven's one handler for every action no Raction_bind took: the exact name first, then the
// first bound prefix it starts with, else a line on the console
func clink DoAction(ASender: Rid; AAction: ptr to const char; AUserData: ptr);
var
  LName: string;
  LHandler: ActionFn;
  LPrefixHandler: PrefixActionFn;
  LI: int64;
begin
  LName := StringFromC(AAction);
  if GActions.TryGet(LName, LHandler) then
    LHandler(ASender);
    return;
  end;
  for LI := 0 to GPrefixes.Count - 1 do
    if IndexOf(GPrefixes[LI], LName, 0) = 0 then
      LPrefixHandler := GPrefixActions[GPrefixes[LI]];
      LPrefixHandler(ASender, Substring(LName, len(GPrefixes[LI]), len(LName)));
      return;
    end;
  end;
  println("no handler for the action '{}'", LName);
end;

/// Answers the Raven action `AName` (an XML layout's `OnClicked` / `OnChanged` / `Action`
/// ...) with `AHandler`; binding a name again replaces its routine. The first binding makes
/// this unit Raven's default action handler.
/// @param AName the action's name
/// @param AHandler the routine answering it
/// @example `BindAction("file.save", DoSave);`
public func BindAction(const AName: string; const AHandler: ActionFn);
begin
  GActions[AName] := AHandler;
  Raction_set_default_handler(DoAction, nil);
end;

/// Answers every action whose name starts with `APrefix` and has no exact binding: the rest
/// of the name is the handler's argument (`"theme.use."` + `"Ember"`).
/// @param APrefix the names' common start
/// @param AHandler the routine answering them
/// @example `BindActionPrefix("theme.use.", DoUseTheme);`
public func BindActionPrefix(const APrefix: string; const AHandler: PrefixActionFn);
begin
  if not GPrefixActions.Has(APrefix) then
    GPrefixes.Add(APrefix);
  end;
  GPrefixActions[APrefix] := AHandler;
  Raction_set_default_handler(DoAction, nil);
end;

/// Saves what the window shows as `<AExample>.png` beside the example's own `.adam` file under
/// `res\examples` (`"raven/raven_showcase"` -> `res\examples\raven\raven_showcase.png`), so a
/// user browsing the examples sees what each one is about.
///
/// Call it once, in the example's **last frame**, after `EndFrame` and before `EndDrawing`: the
/// back buffer then holds the finished frame (after `EndDrawing` it belongs to the next frame and
/// its pixels are undefined). The file goes to the disk through System.CustomIO, never into the
/// assets: raylib's own `TakeScreenshot` drops the folder and writes through the program's files,
/// which `OpenAssets` made the zip.
/// @param AExample the example's path under `res\examples`, no extension, `/` between folders
/// @returns `true` when the `.png` was written; `false` with the reason printed
/// @example `if LLast then SaveExampleSnapshot("raven/raven_showcase"); end; EndDrawing();`
public func SaveExampleSnapshot(const AExample: string): bool;
var
  LPath: string;
  LImage: Image;
  LData: ptr to uint8;
  LSize: int32;
  LFile: IO;
  LWritten: int64;
  LClosed: bool;
begin
  LPath := FormatStr("{}{}.png", EXAMPLE_FOLDER, AExample);
  // The back buffer at the window's real pixel size (raylib reads it with glReadPixels)
  LImage := LoadImageFromScreen();
  if not IsImageValid(LImage) then
    println("the snapshot {} could not be read from the window", LPath);
    return false;
  end;
  defer UnloadImage(LImage);
  // The image as PNG bytes in raylib's memory, given back with MemFree
  LSize := 0;
  LData := ExportImageToMemory(LImage, ".png", addr of LSize);
  if LData = nil then
    println("the snapshot {} could not be encoded as PNG", LPath);
    return false;
  end;
  defer MemFree(ptr(LData));
  // A plain disk file: CreateFileIO opens through the runtime, not the hooked C runtime
  LFile := CreateFileIO(LPath, FileMode.Write);
  if LFile = nil then
    println("the snapshot {} could not be opened for writing", LPath);
    return false;
  end;
  LWritten := IOWriteFull(LFile, LData, int64(LSize));
  LClosed := IOClose(LFile);
  if (LWritten <> int64(LSize)) or not LClosed then
    println("the snapshot {} could not be fully written", LPath);
    return false;
  end;
  return true;
end;

end.
